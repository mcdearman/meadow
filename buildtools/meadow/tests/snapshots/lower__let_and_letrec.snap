v0 : forall a b. (a -> a ! b)
v0 = (/\a b. (\(v1 : a). (letrec v2 : forall c d. (c -> a ! d) = (/\c d. (\(v3 : c). (if (Eq v3 0?) v1 ((v2 @c @d) (Sub v3 1?))))) in ((v2 @Int @b) 3))))
