-- Streams: producers that yield, and consumers that decide how much to take.
--
--   meadow run examples/streams
--   meadow test examples/streams
--
-- Meadow is strict, so there are no lazy lists. A stream here is a function
-- that *performs* `yield x` whenever it has a value, and a consumer is the
-- handler that decides what `yield` means: collect it, count it, stop after
-- ten. A producer can loop forever, because the consumer can stop resuming it.
--
-- So an infinite sequence is just a loop, `take` ends it, and `map` and
-- `filter` are handlers that yield again -- which is what lets them chain.

use Std.Stream as Stream
use Std.Stream (yield)
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*

-- --- producers ---------------------------------------------------------------

-- 0, 1, 1, 2, 3, 5, ... forever.
fun fibs u = fibsFrom 0 1

fun fibsFrom (a : Int) (b : Int) = let _ = yield a in fibsFrom b (a + b)

-- Every natural number from `n` up, forever.
fun from (n : Int) = let _ = yield n in from (n + 1)

-- The Collatz sequence from `n`, ending at 1.
fun collatz (n : Int) =
  let _ = yield n in
  if n == 1 then () else if n % 2 == 0 then collatz (n / 2) else collatz (3 * n + 1)

-- The words of a string, one at a time, without building the whole list.
fun words text = V.forEach (\w -> if S.byteLength w > 0 then yield w else ()) (S.split " " text)

-- --- building on them ----------------------------------------------------------

fun isPrime (n : Int) =
  n >= 2 and (let rec trial (d : Int) = d * d > n or (n % d != 0 and trial (d + 1)) in trial 2)

-- The primes, forever: the naturals, filtered.
fun primes u = Stream.filter isPrime (\() -> from 2)

-- The even numbers from 1 up, squared -- two stages over an infinite stream.
-- `filter` and `map` are producers themselves, so each is wrapped in a
-- function: bound with `let`, it would start running right there.
fun evens u = Stream.filter (\n -> n % 2 == 0) (\() -> from 1)

fun evenSquares u = Stream.map (\n -> n * n) evens

-- Running totals of what `producer` yields: a consumer and a producer at once.
fun runningSum producer =
  handle producer () with {
    yield x k -> \acc -> let total = acc + x in let _ = yield total in (k ()) total,
    return r -> \acc -> ()
  } 0

-- --- main --------------------------------------------------------------------

def main =
  let _ = println "== the first 12 Fibonacci numbers" in
  let _ = println (Stream.take 12 fibs) in
  let _ = println "== the first 10 primes, from an infinite stream" in
  let _ = println (Stream.take 10 primes) in
  let _ = println "== squares of the even numbers, while they stay below 200" in
  let _ = println (Stream.takeWhile (\n -> n < 200) evenSquares) in
  let _ = println "== the Collatz sequence from 27: its length and its peak" in
  let _ = println (Stream.count (\() -> collatz 27), Stream.fold (\m x -> if x > m then x else m) 0 (\() -> collatz 27)) in
  let _ = println "== running totals of 1..10" in
  let _ = println (Stream.toVec (\() -> runningSum (\() -> Stream.range 1 11))) in
  let _ = println "== the first word longer than four letters" in
  println (Stream.find (\w -> S.byteLength w > 4) (\() -> words "the quick brown fox jumps over the lazy dog"))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun takeStopsAnInfiniteProducer () =
  assertEq (Stream.take 5 fibs) [0, 1, 1, 2, 3] "five and no more"

@test fun filtersAndMapsChain () =
  let odds u = Stream.filter (\n -> n % 2 == 1) (\() -> Stream.range 0 10) in
  assertEq (Stream.toVec (\() -> Stream.map (\n -> n * 10) odds)) [10, 30, 50, 70, 90] "odd, then times ten"

@test fun primesComeInOrder () =
  assertEq (Stream.take 6 primes) [2, 3, 5, 7, 11, 13] "the first six"

@test fun runningSumYieldsEveryTotal () =
  assertEq (Stream.toVec (\() -> runningSum (\() -> Stream.range 1 5))) [1, 3, 6, 10] "1, 1+2, 1+2+3, ..."

@test fun findStopsAtTheFirstMatch () =
  assertEq (Stream.find (\w -> S.byteLength w > 4) (\() -> words "a bb ccccc dddddd")) (Just "ccccc") "not the longest, the first"
