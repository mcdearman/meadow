-- Cut: the upper IR every front end hands Meadow's back end (`docs/CUT.md`),
-- as a Lingua language, with what a front end builds a program of it with
-- and the text `meadow_cut` reads. Nothing here knows any front end: what
-- lowers Meadow's `Core` to it is `Seq`.
--
-- Cut is a sequent calculus: a producer makes a value, a consumer receives
-- one, and a statement is one meeting the other. A program of it is a tree,
-- not a graph of blocks, so what builds one is not a cursor to write at but
-- a function of where a value goes: `shared`, `branch`, `applied`.

use Lingua (lang!)
use Lingua.Lang (Meta, spanMeta)
use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C

-- --- the language ------------------------------------------------------------

@pub(pkg) lang! {
  pub Cut with In
  File + File { entry : String, answer : String, decls : [Decl] }
  DataCtor + DataCtor { name : String, fields : [String] }
  Decl + Data { symbol : String, params : [String], ctors : [DataCtor] }
  Decl + Val { symbol : String, rep : String, body : Stmt }
  Decl + Def { symbol : String, params : [Param], conts : [Param], body : Stmt }
  Param + Param { name : String, rep : String }
  Prod + Var { name : String }
  Prod + Sym { symbol : String }
  Prod + Int { value : Int }
  Prod + Float { value : Float }
  Prod + Char { code : Int }
  Prod + Str { text : String }
  Prod + Bool { value : Bool }
  Prod + Unit {}
  Prod + Con { symbol : String, args : [Prod] }
  Prod + Tuple { items : [Prod] }
  Prod + Array { items : [Prod] }
  Prod + Mu { k : String, body : Stmt }
  Prod + Cocase { methods : [Method] }
  Method + Method { name : String, params : [Param], conts : [Param], body : Stmt }
  Cons + KVar { name : String }
  Cons + Halt {}
  Cons + MuT { name : String, rep : String, body : Stmt }
  Cons + Call { method : String, args : [Prod], conts : [Cons] }
  CaseArm + CaseArm { pattern : String, fields : [Param], body : Stmt }
  Cons + Case { arms : [CaseArm] }
  Stmt + Cut { prod : Prod, cons : Cons }
  Stmt + Invoke { symbol : String, args : [Prod], conts : [Cons] }
  Stmt + Prim { op : String, args : [Prod], conts : [Cons] }
  Stmt + Error { message : String }
}

-- --- building ----------------------------------------------------------------

@pub(pkg) def nowhere : Meta = spanMeta 0 0

-- What a lowering has no words for yet: a statement that says so when it
-- runs, so that a program with one in it still reads.
@pub(pkg) fun unsupported out (m : Meta) (what : String) =
  newCutStmtError out m "unsupported: ${what}"

-- What `build` makes with somewhere to send a value more than once: `k`
-- itself, if that is a name already, and otherwise a name for it -- `μ j. s`
-- given to `k` -- so that a consumer written once is not written again in
-- every branch.
@pub(pkg) fun shared out k (m : Meta) (name : String) build =
  let kind = kindCutConsIn out k in
  if kind == CutConsKind.KVar or kind == CutConsKind.Halt then build k
  else newCutStmtCut out m (newCutProdMu out m name (build (newCutConsKVar out m name))) k

-- `no` or `yes`, by the truth `cond` is: a test's branches each receive
-- `unit`, which `name` is bound to, false first.
@pub(pkg) fun branch out (m : Meta) (name : String) cond no yes =
  newCutStmtPrim out m "if" [cond] [
    newCutConsMuT out m name "unit" no,
    newCutConsMuT out m name "unit" yes
  ]

-- The function `f` given `arg`, its answer to `k`: a function is codata
-- with one method, `apply`.
@pub(pkg) fun applied out (m : Meta) f arg k =
  newCutStmtCut out m f (newCutConsCall out m "apply" [arg] [k])

-- A value named `name`, of representation `rep`, for `rest`.
@pub(pkg) fun binding out (m : Meta) (name : String) (rep : String) rest =
  newCutConsMuT out m name rep rest

-- `unit` given to the continuation `name`: how one arm of a match says it
-- did not, to whatever tries the next.
@pub(pkg) fun gaveUp out (m : Meta) (name : String) =
  newCutStmtCut out m (newCutProdUnit out m) (newCutConsKVar out m name)

-- `first`, and `next` if it gives up: `first` is built with the name of the
-- continuation that giving up goes to.
@pub(pkg) fun orElse out (m : Meta) (name : String) first next =
  newCutStmtCut
    out
    m
    (newCutProdMu out m name (first name))
    (newCutConsMuT out m "u_${name}" "unit" next)

-- --- the text ----------------------------------------------------------------

-- A program as `meadow_cut::parse` reads it.
@pub(pkg) fun text (p : CutProgram) : String =
  match p with
  | CutProgram a root ->
      "cut 0\nentry ${cutFileEntry a root}\nanswer ${cutFileAnswer a root}\n\n"
        ++ S.join "\n" (V.map (\d -> decl a d) (cutFileDecls a root))

fun decl (a : CutArena) (d : CutDecl) : String =
  if kindCutDecl a d == CutDeclKind.Val then
    "val ${cutDeclValSymbol a d} : ${cutDeclValRep a d} =\n  ${stmt a 1 (cutDeclValBody a d)}\n"
  else if kindCutDecl a d == CutDeclKind.Data then
    (let ps = cutDeclDataParams a d in
     let taking = if V.isEmpty ps then "" else " <${S.join ", " ps}>" in
     let ctor =
       \c ->
         (let fs = cutDataCtorFields a c in
          if V.isEmpty fs then cutDataCtorName a c else "${cutDataCtorName a c}(${S.join ", " fs})")
     in "data ${cutDeclDataSymbol a d}${taking} { ${S.join "; " (V.map ctor (cutDeclDataCtors a d))} }\n")
  else
    "def ${cutDeclDefSymbol a d} ${params a (cutDeclDefParams a d) (cutDeclDefConts a d)} =\n  ${stmt a 1 (cutDeclDefBody a d)}\n"

fun param (a : CutArena) (p : CutParam) : String = "${cutParamName a p}: ${cutParamRep a p}"

fun params (a : CutArena) (ps : [CutParam]) (ks : [CutParam]) : String =
  "(${S.join ", " (V.map (param a) ps)}; ${S.join ", " (V.map (param a) ks)})"

fun line (depth : Int) : String = "\n" ++ S.repeat "  " depth

fun call (a : CutArena) (depth : Int) (args : [CutProd]) (ks : [CutCons]) : String =
  "(${S.join ", " (V.map (prod a depth) args)}; ${S.join ", " (V.map (cons a depth) ks)})"

fun stmt (a : CutArena) (depth : Int) (s : CutStmt) : String =
  let k = kindCutStmt a s in
  if k == CutStmtKind.Cut then
    "<${prod a depth (cutStmtCutProd a s)} | ${cons a depth (cutStmtCutCons a s)}>"
  else if k == CutStmtKind.Invoke then
    cutStmtInvokeSymbol a s ++ call a depth (cutStmtInvokeArgs a s) (cutStmtInvokeConts a s)
  else if k == CutStmtKind.Prim then
    "prim ${cutStmtPrimOp a s}" ++ call a depth (cutStmtPrimArgs a s) (cutStmtPrimConts a s)
  else "error ${quoted (cutStmtErrorMessage a s)}"

fun prod (a : CutArena) (depth : Int) (p : CutProd) : String =
  let k = kindCutProd a p in
  if k == CutProdKind.Var then cutProdVarName a p
  else if k == CutProdKind.Sym then cutProdSymSymbol a p
  else if k == CutProdKind.Int then show (cutProdIntValue a p)
  else if k == CutProdKind.Float then show (cutProdFloatValue a p)
  else if k == CutProdKind.Char then "'\\u{${hex (cutProdCharCode a p)}}'"
  else if k == CutProdKind.Str then quoted (cutProdStrText a p)
  else if k == CutProdKind.Bool then (if cutProdBoolValue a p then "true" else "false")
  else if k == CutProdKind.Unit then "unit"
  else if k == CutProdKind.Con then
    (let args = cutProdConArgs a p in
     if V.isEmpty args then cutProdConSymbol a p
     else "${cutProdConSymbol a p}(${S.join ", " (V.map (prod a depth) args)})")
  else if k == CutProdKind.Tuple then
    "#tuple(${S.join ", " (V.map (prod a depth) (cutProdTupleItems a p))})"
  else if k == CutProdKind.Array then
    "[${S.join ", " (V.map (prod a depth) (cutProdArrayItems a p))}]"
  else if k == CutProdKind.Mu then
    "μ ${cutProdMuK a p}.${line (depth + 1)}${stmt a (depth + 1) (cutProdMuBody a p)}"
  else
    "cocase {"
      ++ S.join
        ";"
        (V.map
           (\m ->
             "${line (depth + 1)}${cutMethodName a m}${params a (cutMethodParams a m) (cutMethodConts a m)} =>${line (depth + 2)}${stmt a (depth + 2) (cutMethodBody a m)}")
           (cutProdCocaseMethods a p))
      ++ line depth
      ++ "}"

fun cons (a : CutArena) (depth : Int) (c : CutCons) : String =
  let k = kindCutCons a c in
  if k == CutConsKind.KVar then cutConsKVarName a c
  else if k == CutConsKind.Halt then "halt"
  else if k == CutConsKind.MuT then
    "μ̃ ${cutConsMuTName a c}: ${cutConsMuTRep a c}.${line (depth + 1)}${stmt a (depth + 1) (cutConsMuTBody a c)}"
  else if k == CutConsKind.Case then
    "case {"
      ++ S.join
        ";"
        (V.map
           (\arm ->
             (let pattern = cutCaseArmPattern a arm in
              let fields = cutCaseArmFields a arm in
              let taken =
                if V.isEmpty fields and pattern != "#tuple" then ""
                else "(${S.join ", " (V.map (param a) fields)})"
              in "${line (depth + 1)}${pattern}${taken} =>${line (depth + 2)}${stmt a (depth + 2) (cutCaseArmBody a arm)}"))
           (cutConsCaseArms a c))
      ++ line depth
      ++ "}"
  else cutConsCallMethod a c ++ call a depth (cutConsCallArgs a c) (cutConsCallConts a c)

-- A string as Cut writes one.
fun quoted (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\c ->
           if c == '"' then "\\\""
           else if c == '\\' then "\\\\"
           else if c == '\n' then "\\n"
           else if c == '\t' then "\\t"
           else if c == '\r' then "\\r"
           else C.toString c)
         (S.chars s))
    ++ "\""

fun hex (n : Int) : String =
  if n < 16 then stringSlice "0123456789abcdef" n (n + 1) else hex (n / 16) ++ hex (n % 16)

-- Definitions that make an `i64` its digits, in `package`: what `answer str`
-- needs of a whole number, since a runtime turns nothing into text but text.
-- Text, to follow a program's, until there is a way to say them as nodes.
@pub(pkg) fun showInt (package : String) : String = "
def ${package}\"#showInt\" (n: i64; k: ptr) =
  prim lt(n, 0; μ̃ u: unit. ${package}\"#showNat\"(n; k), μ̃ u: unit. prim sub(0, n; μ̃ m: i64. ${package}\"#showNat\"(m; μ̃ s: str. prim concatStrings([\"-\", s]; k))))

def ${package}\"#showNat\" (n: i64; k: ptr) =
  prim lt(n, 10; μ̃ u: unit. prim div(n, 10; μ̃ q: i64. ${package}\"#showNat\"(q; μ̃ hi: str. prim mod(n, 10; μ̃ r: i64. ${package}\"#digit\"(r; μ̃ d: str. prim concatStrings([hi, d]; k))))), μ̃ u: unit. ${package}\"#digit\"(n; k))

def ${package}\"#digit\" (d: i64; k: ptr) =
  prim add(d, 1; μ̃ e: i64. prim stringSlice(\"0123456789\", d, e; k))
"
