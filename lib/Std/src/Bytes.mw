-- Std.Bytes: working with byte arrays.
--
-- A byte array is a `#[UInt8]`. The runtime bridges it to `String` with the
-- primitives `stringToBytes` / `bytesToString` (lossy UTF-8) and `bytesToHex` /
-- `bytesFromHex`; this module adds construction, setters that take any integer
-- and keep its low 8 bits, and little- and big-endian reads and writes of the
-- wider unsigned types.
--
-- A literal array is a byte array wherever one is expected:
--
--   let (header : #[UInt8]) = #[0x89, 0x50, 0x4E, 0x47] in ...

-- The empty byte array.
@pub def bytesEmpty : #[UInt8] = stringToBytes ""

@pub fun bytesLength (b : #[a]) : Int = arrayLen b

@pub fun bytesIsEmpty (b : #[a]) : Bool = arrayLen b == 0

-- `Just` the byte at `i`, or `None` if `i` is out of range.
@pub fun bytesGet (b : #[a]) (i : Int) : Maybe a =
  if i < 0 then None
  else if i >= arrayLen b then None
  else Just (arrayGet b i)

-- The byte at `i`, or `default` when out of range.
@pub fun bytesGetOr (default : a) (b : #[a]) (i : Int) : a = arrayGetOr default b i

-- Persistently set byte `i` to the low 8 bits of `v`, which may be any integer.
@pub fun bytesSet (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = arraySet b i (toUInt8 v)

-- Append the low 8 bits of `v`.
@pub fun bytesPush (b : #[UInt8]) (v : n) : #[UInt8] = arrayPush b (toUInt8 v)

@pub fun bytesPop (b : #[a]) : #[a] = arrayPop b

-- The `[from, to)` sub-array, clamped to bounds.
@pub fun bytesSlice (b : #[a]) (from : Int) (to : Int) : #[a] = arraySlice b from to

@pub fun bytesConcat (a : #[a]) (b : #[a]) : #[a] = arrayConcat a b

-- --- multi-byte reads (a byte past the end reads as 0) ------------------------

fun at b i = bytesGetOr (toUInt8 0) b i

@pub fun bytesGetU16LE (b : #[UInt8]) (i : Int) : UInt16 = bitOr (toUInt16 (at b i)) (toUInt16 (at b (i + 1)) << 8)

@pub fun bytesGetU16BE (b : #[UInt8]) (i : Int) : UInt16 = bitOr (toUInt16 (at b i) << 8) (toUInt16 (at b (i + 1)))

@pub fun bytesGetU32LE (b : #[UInt8]) (i : Int) : UInt32 =
  bitOr
    (bitOr (toUInt32 (at b i)) (toUInt32 (at b (i + 1)) << 8))
    (bitOr (toUInt32 (at b (i + 2)) << 16) (toUInt32 (at b (i + 3)) << 24))

@pub fun bytesGetU32BE (b : #[UInt8]) (i : Int) : UInt32 =
  bitOr
    (bitOr (toUInt32 (at b i) << 24) (toUInt32 (at b (i + 1)) << 16))
    (bitOr (toUInt32 (at b (i + 2)) << 8) (toUInt32 (at b (i + 3))))

@pub fun bytesGetU64LE (b : #[UInt8]) (i : Int) : UInt64 =
  bitOr (toUInt64 (bytesGetU32LE b i)) (toUInt64 (bytesGetU32LE b (i + 4)) << 32)

@pub fun bytesGetU64BE (b : #[UInt8]) (i : Int) : UInt64 =
  bitOr (toUInt64 (bytesGetU32BE b i) << 32) (toUInt64 (bytesGetU32BE b (i + 4)))

-- --- multi-byte writes (each returns a new byte array) ------------------------

@pub fun bytesSetU16LE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSet (bytesSet b i v) (i + 1) (v >> 8)

@pub fun bytesSetU16BE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSet (bytesSet b i (v >> 8)) (i + 1) v

@pub fun bytesSetU32LE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSetU16LE (bytesSetU16LE b i v) (i + 2) (v >> 16)

@pub fun bytesSetU32BE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSetU16BE (bytesSetU16BE b i (v >> 16)) (i + 2) v

@pub fun bytesSetU64LE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSetU32LE (bytesSetU32LE b i v) (i + 4) (v >> 32)

@pub fun bytesSetU64BE (b : #[UInt8]) (i : Int) (v : n) : #[UInt8] = bytesSetU32BE (bytesSetU32BE b i (v >> 32)) (i + 4) v

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe.Maybe.*

@test fun lengthAndEmptiness () =
  let (three : #[UInt8]) = #[1, 2, 3] in
  let a = assertEq (bytesLength bytesEmpty) 0 "empty length" in
  let b = assertTrue (bytesIsEmpty bytesEmpty) "empty is empty" in
  let c = assertEq (bytesLength three) 3 "length" in
  assertFalse (bytesIsEmpty three) "three bytes are not empty"

@test fun boundsCheckedAccess () =
  let (b : #[UInt8]) = #[1, 2, 3] in
  let a = assertEq (bytesGet b 1) (Just (toUInt8 2)) "in range" in
  let c = assertEq (bytesGet b 3) None "past the end" in
  let d = assertEq (bytesGet b (0 - 1)) None "before the start" in
  assertEq (bytesGetOr 0 b 9) (toUInt8 0) "getOr past the end"

@test fun pushPopSetAndSlice () =
  let (b : #[UInt8]) = #[1, 2, 3] in
  let (want : #[UInt8]) = #[1, 9, 3] in
  let a = assertEq (bytesLength (bytesPush b 4)) 4 "push" in
  let c = assertEq (bytesLength (bytesPop b)) 2 "pop" in
  let d = assertEq (bytesSet b 1 9) want "set" in
  let e = assertEq (bytesLength (bytesSlice b 1 3)) 2 "slice" in
  assertEq (bytesLength (bytesConcat b b)) 6 "concat"

@test fun aSetKeepsTheLowEightBits () =
  -- Any integer goes in, and only its low byte is stored.
  let (b : #[UInt8]) = #[0] in
  let a = assertEq (bytesGetOr 0 (bytesSet b 0 0x1FF) 0) (toUInt8 0xFF) "0x1FF becomes 0xFF" in
  assertEq (bytesGetOr 0 (bytesSet b 0 (0 - 1)) 0) (toUInt8 255) "-1 is all ones"

@test fun multiByteReadsRespectEndianness () =
  let (b : #[UInt8]) = #[0x34, 0x12] in
  let a = assertEq (bytesGetU16LE b 0) (toUInt16 0x1234) "u16 little-endian" in
  let c = assertEq (bytesGetU16BE b 0) (toUInt16 0x3412) "u16 big-endian" in
  let (d : #[UInt8]) = #[0x78, 0x56, 0x34, 0x12] in
  let e = assertEq (bytesGetU32LE d 0) (toUInt32 0x12345678) "u32 little-endian" in
  assertEq (bytesGetU32BE d 0) (toUInt32 0x78563412) "u32 big-endian"

@test fun multiByteReadsPastTheEndAreZero () =
  -- Documented behaviour: missing bytes read as 0 rather than failing.
  let (b : #[UInt8]) = #[1] in
  assertEq (bytesGetU32LE b 0) (toUInt32 1) "three bytes missing"

@test fun multiByteWritesRoundTrip () =
  let (two : #[UInt8]) = #[0, 0] in
  let (eight : #[UInt8]) = #[0, 0, 0, 0, 0, 0, 0, 0] in
  let a = assertEq (bytesGetU16LE (bytesSetU16LE two 0 0x1234) 0) (toUInt16 0x1234) "u16 LE" in
  let b = assertEq (bytesGetU16BE (bytesSetU16BE two 0 0x1234) 0) (toUInt16 0x1234) "u16 BE" in
  let c = assertEq (bytesGetU32LE (bytesSetU32LE eight 0 0x12345678) 0) (toUInt32 0x12345678) "u32 LE" in
  let d = assertEq (bytesGetU32BE (bytesSetU32BE eight 0 0x12345678) 0) (toUInt32 0x12345678) "u32 BE" in
  -- The top bit set, so a signed read would show up as negative.
  let big = toUInt64 0x7EDCBA9876543210 * 2 + 1 in
  let e = assertEq (bytesGetU64LE (bytesSetU64LE eight 0 big) 0) big "u64 LE" in
  assertEq (bytesGetU64BE (bytesSetU64BE eight 0 big) 0) big "u64 BE"
