-- Std.Collections.List: linked lists. Reach these as `List.map` etc., or
-- `use Std.Collections.List (map, ...)`. The `[a; b; c]` literal and `::` build
-- one of these.

use Std.Bool (not)
use Std.Tuple (fst, snd)
use Std.Num.Int (min, max)
-- `toStream` performs `yield`; see the note in `Std.Collections.Vector`.
use Std.Yield (yield)

@pub data List a = Nil | Cons a (List a)

@pub fun append xs ys =
  match xs with
  | Nil -> ys
  | Cons x rest -> x :: append rest ys

@pub fun map f xs =
  match xs with
  | Nil -> Nil
  | Cons x rest -> f x :: map f rest

@pub fun filter keep xs =
  match xs with
  | Nil -> Nil
  | Cons x rest if keep x -> x :: filter keep rest
  | Cons _ rest -> filter keep rest

@pub fun foldl f acc xs =
  match xs with
  | Nil -> acc
  | Cons x rest -> foldl f (f acc x) rest

@pub fun foldr f acc xs =
  match xs with
  | Nil -> acc
  | Cons x rest -> f x (foldr f acc rest)

fun reverseOnto acc xs =
  match xs with
  | Nil -> acc
  | Cons x rest -> reverseOnto (x :: acc) rest

@pub fun reverse xs = reverseOnto Nil xs

@pub fun length xs =
  match xs with
  | Nil -> 0
  | Cons x rest -> 1 + length rest

@pub fun elem x xs =
  match xs with
  | Nil -> False
  | Cons y _ if x == y -> True
  | Cons _ rest -> elem x rest

@pub fun range lo hi = if lo < hi then lo :: range (lo + 1) hi else Nil

@pub fun take n xs =
  match xs with
  | Cons y rest if n >= 1 -> y :: take (n - 1) rest
  | _ -> Nil

@pub fun drop n xs =
  match xs with
  | Cons _ rest if n >= 1 -> drop (n - 1) rest
  | _ -> xs

@pub fun concat xss = foldr append Nil xss

-- Public surface --------------------------------------------------------------

@pub fun isEmpty xs = match xs with | Nil -> True | Cons x rest -> False

@pub fun singleton x = Cons x Nil

@pub fun head xs = match xs with | Nil -> None | Cons x rest -> Just x

@pub fun tail xs = match xs with | Nil -> None | Cons x rest -> Just rest

@pub fun last xs =
  match xs with
  | Nil -> None
  | Cons x Nil -> Just x
  | Cons x rest -> last rest

@pub fun nth n xs =
  match xs with
  | Nil -> None
  | Cons x _ if n < 1 -> Just x
  | Cons _ rest -> nth (n - 1) rest

@pub fun notElem x xs = not (elem x xs)

@pub fun replicate n x = if n < 1 then Nil else x :: replicate (n - 1) x

@pub fun sum xs = foldl (\a b -> a + b) 0 xs

@pub fun product xs = foldl (\a b -> a * b) 1 xs

@pub fun maximum xs =
  match xs with
  | Nil -> None
  | Cons x rest -> Just (foldl max x rest)

@pub fun minimum xs =
  match xs with
  | Nil -> None
  | Cons x rest -> Just (foldl min x rest)

@pub fun all keep xs =
  match xs with
  | Nil -> True
  | Cons x rest if keep x -> all keep rest
  | Cons _ _ -> False

@pub fun any keep xs =
  match xs with
  | Nil -> False
  | Cons x _ if keep x -> True
  | Cons _ rest -> any keep rest

@pub fun find keep xs =
  match xs with
  | Nil -> None
  | Cons x _ if keep x -> Just x
  | Cons _ rest -> find keep rest

@pub fun takeWhile keep xs =
  match xs with
  | Cons x rest if keep x -> x :: takeWhile keep rest
  | _ -> Nil

@pub fun dropWhile keep xs =
  match xs with
  | Cons x rest if keep x -> dropWhile keep rest
  | _ -> xs

@pub fun partition keep xs = (filter keep xs, filter (\x -> not (keep x)) xs)

@pub fun concatMap f xs = concat (map f xs)

@pub fun zip xs ys =
  match (xs, ys) with
  | (Nil, bs) -> Nil
  | (Cons a arest, Nil) -> Nil
  | (Cons a arest, Cons b brest) -> (a, b) :: zip arest brest

@pub fun zipWith f xs ys =
  match (xs, ys) with
  | (Nil, bs) -> Nil
  | (Cons a arest, Nil) -> Nil
  | (Cons a arest, Cons b brest) -> f a b :: zipWith f arest brest

@pub fun unzip ps = (map fst ps, map snd ps)

@pub fun sumBy f xs = foldl (\acc x -> acc + f x) 0 xs

@pub fun intercalate sep xs =
  match xs with
  | Nil -> Nil
  | Cons y Nil -> y
  | Cons y rest -> append y (append sep (intercalate sep rest))

-- Association lists: `[(key, value)]`, keys compared with `==`.

@pub fun lookupAssoc key pairs =
  match pairs with
  | Nil -> None
  | Cons (k, v) _ if k == key -> Just v
  | Cons _ rest -> lookupAssoc key rest

@pub fun insertAssoc key val pairs =
  match pairs with
  | Nil -> Cons (key, val) Nil
  | Cons (k, _) rest if k == key -> Cons (key, val) rest
  | Cons pair rest -> Cons pair (insertAssoc key val rest)

@pub fun removeAssoc key pairs =
  match pairs with
  | Nil -> Nil
  | Cons (k, _) rest if k == key -> rest
  | Cons pair rest -> Cons pair (removeAssoc key rest)

-- Yield every element, in order, for `Std.Stream`.
@pub fun toStream xs =
  match xs with
  | [;] -> ()
  | x :: rest -> let ignored = yield x in toStream rest

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe.Maybe.*

@test fun appendAndLength () =
  let a = assertEq (append [1; 2] [3;]) [1; 2; 3] "append" in
  let b = assertEq (append [;] [1;]) [1;] "append onto nothing" in
  let c = assertEq (length [1; 2; 3]) 3 "length" in
  assertEq (length [;]) 0 "length of nothing"

@test fun mapFilterAndFolds () =
  let a = assertEq (map (\n -> n * 2) [1; 2; 3]) [2; 4; 6] "map" in
  let b = assertEq (filter (\n -> n > 1) [1; 2; 3]) [2; 3] "filter" in
  let c = assertEq (foldl (\acc n -> acc - n) 10 [1; 2]) 7 "foldl" in
  -- The folds differ on a non-commutative operator, which is the point.
  assertEq (foldr (\n acc -> n - acc) 0 [1; 2]) (0 - 1) "foldr"

@test fun reverseAndConcat () =
  let a = assertEq (reverse [1; 2; 3]) [3; 2; 1] "reverse" in
  let b = assertEq (reverse [;]) [;] "reverse of nothing" in
  assertEq (concat [[1; 2]; [3;]; [;]]) [1; 2; 3] "concat"

@test fun takeAndDropClampToTheEnds () =
  let a = assertEq (take 2 [1; 2; 3]) [1; 2] "take" in
  let b = assertEq (take 9 [1; 2]) [1; 2] "take more than there is" in
  let c = assertEq (take 0 [1; 2]) [;] "take nothing" in
  let d = assertEq (drop 2 [1; 2; 3]) [3;] "drop" in
  assertEq (drop 9 [1; 2]) [;] "drop more than there is"

@test fun membershipAndRange () =
  let a = assertTrue (elem 2 [1; 2; 3]) "elem" in
  let b = assertFalse (elem 9 [1; 2; 3]) "not elem" in
  let c = assertEq (range 1 4) [1; 2; 3] "range is half-open" in
  assertEq (range 4 1) [;] "an empty range"

@test fun searchingStopsAtTheFirst () =
  let a = assertEq (nth 1 [7; 8; 9]) (Just 8) "nth" in
  let b = assertEq (nth 5 [7;]) None "nth past the end" in
  let c = assertTrue (all (\n -> n > 0) [1; 2]) "all" in
  let d = assertFalse (all (\n -> n > 1) [1; 2]) "not all" in
  let e = assertTrue (any (\n -> n > 1) [1; 2]) "any" in
  let f = assertEq (find (\n -> n > 1) [1; 2; 3]) (Just 2) "find" in
  let g = assertEq (takeWhile (\n -> n < 3) [1; 2; 3; 1]) [1; 2] "takeWhile" in
  assertEq (dropWhile (\n -> n < 3) [1; 2; 3; 1]) [3; 1] "dropWhile"

@test fun associationLists () =
  let pairs = insertAssoc "b" 2 (insertAssoc "a" 1 [;]) in
  let a = assertEq (lookupAssoc "b" pairs) (Just 2) "lookup" in
  let b = assertEq (lookupAssoc "a" (insertAssoc "a" 9 pairs)) (Just 9) "replace" in
  let c = assertEq (lookupAssoc "a" (removeAssoc "a" pairs)) None "remove" in
  assertEq (length (insertAssoc "a" 9 pairs)) 2 "replacing keeps one"

@test fun isEmptyAndToStream () =
  let a = assertTrue (isEmpty [;]) "isEmpty" in
  assertFalse (isEmpty [1;]) "not isEmpty"
