-- Std.Result: success-or-failure values. Reach these as `Result.map` etc.
-- (`None` / `Just` / `Ok` / `Err` are constructors -- always in scope by name.)

@pub data Result e a = Err e | Ok a

@pub fun isOk r = match r with | Err e -> False | Ok x -> True

@pub fun isErr r = match r with | Err e -> True | Ok x -> False

@pub fun unwrapOr fallback r = match r with | Err e -> fallback | Ok x -> x

@pub fun map f r =
  match r with
  | Err e -> Err e
  | Ok x -> Ok (f x)

@pub fun mapErr f r =
  match r with
  | Err e -> Err (f e)
  | Ok x -> Ok x

@pub fun andThen f r =
  match r with
  | Err e -> Err e
  | Ok x -> f x

@pub fun toMaybe r =
  match r with
  | Err e -> None
  | Ok x -> Just x

@pub fun fromMaybe err o =
  match o with
  | None -> Err err
  | Just x -> Ok x
