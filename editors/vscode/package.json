{
  "name": "meadow",
  "displayName": "Meadow",
  "description": "Language support for Meadow: syntax highlighting, diagnostics, hover, go-to-definition and inlay hints.",
  "version": "0.1.0",
  "publisher": "mcdearman",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcdearman/meadow"
  },
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:meadow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "meadow",
        "aliases": [
          "Meadow",
          "meadow"
        ],
        "extensions": [
          ".mw"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "meadow",
        "scopeName": "source.meadow",
        "path": "./syntaxes/meadow.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Meadow",
      "properties": {
        "meadow.server.path": {
          "type": "string",
          "default": "meadow",
          "description": "Path to the `meadow` executable. The extension runs `meadow lsp`."
        },
        "meadow.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred types after parameters and `let` bindings."
        },
        "meadow.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "meadow.restartServer",
        "title": "Meadow: Restart Language Server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
