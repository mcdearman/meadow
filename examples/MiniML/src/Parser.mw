-- Source text to `Expr`, with `Std.String.Parse`.
--
-- The input is the source `String` itself, read a `Char` at a time, with
-- `Std.String.Parse.Lexer`'s space consumer between tokens: every token parser
-- is a `lexeme`, so the grammar never mentions spaces again, and `--` starts a
-- comment to the end of the line. The one place that needs care is keywords:
-- `string` is atomic, but `let` is also a prefix of `letter`, so `keyword`
-- checks that what follows is not another identifier character.

-- The tree this parser builds, from the package's own `Syntax` module. The
-- `.*` brings `Expr`'s constructors in unqualified, and this file never mentions
-- `Ty`, so its `Int` can only be `Expr.Int`.
use Syntax (Expr)
use Syntax.Expr.*
use Std.String.Parse as P
use Std.String.Parse.Char as C
use Std.String.Parse.Lexer as L
use Std.String as S
use Std.Char as Ch
use Std.Collections.Vector as V
use Std.Bool (not)

-- --- tokens -----------------------------------------------------------------

fun isIdentStart c = Ch.isAlpha c or c == '_'
fun isIdentChar c = isIdentStart c or Ch.isDigit c

-- White space and `--` comments: what may sit between two tokens.
fun sc = L.space C.space1 (L.skipLineComment "--") P.empty

fun lexeme p = L.lexeme sc p

fun symbol s = L.symbol sc s

-- A keyword is a word that is not the start of a longer identifier, so `let`
-- does not match the first three characters of `letter`.
fun keyword s =
  P.thenSkip (C.string s) (P.notFollowedBy (P.satisfy isIdentChar)) |> P.try |> lexeme

def reserved = ["let", "rec", "in", "fun", "if", "then", "else", "true", "false"]

-- An identifier, refusing the reserved words so `let` cannot be a variable.
--
-- Wrapped in `try` for a reason worth understanding: the reserved check happens
-- *after* the characters are consumed, so without it `ident` fails on `in`
-- having already eaten it -- and a consumed failure is not something `many` or
-- `alt` will back out of. `try` un-consumes, which turns "this is a keyword"
-- back into "this is not an identifier, look elsewhere".
fun ident =
  P.label "an identifier"
    (P.try
      (P.bind (lexeme (P.lift2 (\c cs -> S.concat (Ch.toString c) cs)
                        (P.satisfy isIdentStart)
                        (P.takeWhileP isIdentChar)))
        (\name ->
          if V.elem name reserved then P.fail "`${name}` is a keyword, not a name"
          else P.pure name)))

fun intLit = L.decimal |> lexeme |> P.map (\n -> Int n)

fun boolLit =
  P.alt (P.mapTo (Bool True) (keyword "true")) (P.mapTo (Bool False) (keyword "false"))

-- --- the grammar ----------------------------------------------------------
--
-- Layered by precedence, loosest first. Each layer `defer`s to the next so the
-- recursion is built lazily -- without `defer` these definitions would be a
-- cycle of values rather than of functions, and evaluating one would not
-- terminate.

-- `f x y` -- application binds tightest and associates left.
fun appE () =
  P.bind (P.defer atomE)
         (\f -> P.bind (P.many (P.defer atomE))
                       (\args -> P.pure (V.foldl (\g a -> App g a) f args)))

-- A chain of left-associative binary operators at one precedence level.
fun binaryE ops next =
  P.chainl1 (P.defer next)
    (ops |> V.map (\o -> P.mapTo (\l r -> Bin o l r) (symbol o)) |> P.choice)

fun mulE () = binaryE ["*", "/"] appE
fun addE () = binaryE ["+", "-"] mulE
fun cmpE () = binaryE ["==", "<=", ">=", "<", ">"] addE

fun atomE () =
  P.choice
    [ intLit
      , boolLit
      , P.map (\n -> Var n) ident
      , P.between (symbol "(") (symbol ")") (P.defer exprE)
    ]

-- `fun x y -> e` is sugar for `fun x -> fun y -> e`.
fun lamE () =
  P.bind (P.skipThen (keyword "fun") (P.some ident))
         (\names ->
           P.bind (P.skipThen (symbol "->") (P.defer exprE))
                   (\body -> P.pure (V.foldr (\n acc -> Lam n acc) body names)))

fun ifE () =
  P.bind (P.skipThen (keyword "if") (P.defer exprE))
         (\c -> P.bind (P.skipThen (keyword "then") (P.defer exprE))
           (\t -> P.bind (P.skipThen (keyword "else") (P.defer exprE))
             (\e -> P.pure (If c t e))))

-- `let [rec] name args = rhs in body`.
--
-- `let rec f x = e` becomes `LetRec f x e`; extra arguments curry into the
-- right-hand side, and `let rec` with no argument is rejected because a
-- recursive value that is not a function has nothing to stand on.
fun letE () =
  P.bind (P.skipThen (keyword "let") (P.optional (keyword "rec")))
    (\isRec ->
      P.bind ident (\name ->
        P.bind (P.many ident) (\args ->
          P.bind (P.skipThen (symbol "=") (P.defer exprE)) (\rhs ->
            P.bind (P.skipThen (keyword "in") (P.defer exprE)) (\body ->
              match isRec with
              | None -> P.pure (Let name (V.foldr (\a acc -> Lam a acc) rhs args) body)
              | Just r ->
                  match V.head args with
                  | None -> P.fail "an argument after `let rec`"
                  | Just first ->
                      let inner = V.foldr (\a acc -> Lam a acc) rhs (V.drop args 1) in
                      P.pure (LetRec name first inner body))))))

fun exprE () = P.choice [P.defer letE, P.defer lamE, P.defer ifE, P.defer cmpE]

-- Parse a whole program: an expression, and nothing after it. An error says
-- at which offset, and what went wrong there.
@pub(pkg) fun parse src =
  match P.runParser (P.skipThen sc (P.thenSkip (P.defer exprE) P.eof)) src with
  | Ok e -> Ok e
  | Err err -> Err (P.showError err)
