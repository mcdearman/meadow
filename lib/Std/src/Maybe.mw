-- Std.Maybe: optional values. Reach these as `Maybe.map` etc., or `use` them.

@pub data Maybe a = None | Just a

@pub fun isSome o = match o with | None -> False | Just x -> True

@pub fun isNone o = match o with | None -> True | Just x -> False

@pub fun unwrapOr default o = match o with | None -> default | Just x -> x

@pub fun orElse fallback o = match o with | None -> fallback | Just x -> o

@pub fun map f o =
  match o with
  | None -> None
  | Just x -> Just (f x)

@pub fun andThen f o =
  match o with
  | None -> None
  | Just x -> f x

@pub fun keepIf pred o =
  match o with
  | None -> None
  | Just x -> if pred x then o else None

@pub fun toList o =
  match o with
  | None -> Nil
  | Just x -> Cons x Nil
