-- Hindley-Milner type inference, Algorithm J.
--
-- The difference from Algorithm W, and the reason to write J: W builds a
-- *substitution* and threads it through every recursive call, composing as it
-- goes. J puts a mutable cell in the type variable instead, so unifying writes
-- the answer where everyone can already see it and nothing has to be threaded.
-- The inference function returns a type and nothing else.
--
-- That is what `Ty.Var (Ref Tv)` is for, and it is why every function here
-- carries `! { Mut | e }` in its type. The compiler tracking that is the point:
-- the mutation is real, and it says so.
--
-- Generalization uses **levels**, after Rémy. Every variable records the
-- `let`-depth at which it was created. When generalizing at depth `d`, a
-- variable may be quantified exactly when its level is greater than `d` --
-- meaning it was invented inside this `let` and cannot have escaped into the
-- environment. That replaces the textbook "scan the environment for free
-- variables", which is correct and quadratic.

-- `Expr` and `Ty` share constructor names (`Int`, `Bool`, `Var`), so this file
-- writes those qualified -- `Expr.Int`, `Ty.Int` -- and relies on the flat
-- spelling only for `Tv` and `Scheme`, which clash with nothing.
use Syntax (Expr, Ty, Tv, Scheme)
use Std.Ref (modify)
use Std.Collections.List as L
use Std.Maybe (Maybe, Just, None)
use Std.Result (Result, Ok, Err)
use Std.String as S
use Std.Exn (raise, toResult)
use Std.Bool (not)

-- --- the variable supply --------------------------------------------------
--
-- One counter for the whole run, in a `Ref`. A fresh variable starts `Unbound`
-- at the current level.

fun newTv counter level =
  let n = getRef counter in
  let ignored = setRef counter (n + 1) in
  Ty.Var (newRef (Unbound n level))

-- Follow links to whatever a type currently is. Not path compression -- a toy
-- can afford the walk -- but the same idea.
fun force t =
  match t with
  | Ty.Var r ->
      (match getRef r with
       | Link inner -> force inner
       | Unbound n l -> t)
  | other -> other

-- --- unification ----------------------------------------------------------

fun typeName t =
  match force t with
  | Ty.Int -> "Int"
  | Ty.Bool -> "Bool"
  | Ty.Fun a b -> S.concatAll ["(", typeName a, " -> ", typeName b, ")"]
  | Ty.Var r ->
      (match getRef r with
       | Unbound n l -> S.concat "t" (S.fromInt n)
       | Link inner -> typeName inner)

-- The occurs check, which also lowers levels.
--
-- Two jobs in one walk, as is traditional: refuse `t = t -> t` (which would
-- make an infinite type), and pull any variable inside `t` down to `level` so
-- that a variable escaping into an outer scope stops being generalizable.
fun occursAdjust id level t =
  match force t with
  | Ty.Var r ->
      (match getRef r with
       | Unbound n l ->
           if n == id then raise "occurs check: a type would contain itself"
           else if l > level then setRef r (Unbound n level)
           else ()
       | Link inner -> occursAdjust id level inner)
  | Ty.Fun a b -> let ignored = occursAdjust id level a in occursAdjust id level b
  | other -> ()

fun unify a b =
  match (force a, force b) with
  | (Ty.Int, Ty.Int) -> ()
  | (Ty.Bool, Ty.Bool) -> ()
  | (Ty.Fun a1 b1, Ty.Fun a2 b2) ->
      let ignored = unify a1 a2 in
      unify b1 b2
  | (Ty.Var r1, Ty.Var r2) ->
      if r1 == r2 then ()
      else
        (match getRef r1 with
         | Unbound n l ->
             let ignored = occursAdjust n l (Ty.Var r2) in
             setRef r1 (Link (Ty.Var r2))
         | Link inner -> unify inner (Ty.Var r2))
  | (Ty.Var r, other) ->
      (match getRef r with
       | Unbound n l ->
           let ignored = occursAdjust n l other in
           setRef r (Link other)
       | Link inner -> unify inner other)
  | (other, Ty.Var r) -> unify (Ty.Var r) other
  | (x, y) ->
      raise (S.concatAll ["cannot unify ", typeName x, " with ", typeName y])

-- --- generalization and instantiation -------------------------------------

-- Every `Unbound` id in `t` whose level is deeper than `level`: the variables
-- this `let` owns, and so the ones it may quantify.
fun freeAbove level t acc =
  match force t with
  | Ty.Var r ->
      (match getRef r with
       | Unbound n l -> if l > level and not (L.elem n acc) then n :: acc else acc
       | Link inner -> freeAbove level inner acc)
  | Ty.Fun a b -> freeAbove level b (freeAbove level a acc)
  | other -> acc

fun generalize level t = Forall (freeAbove level t [;]) t

-- Replace each quantified id with a fresh variable. Everything else is shared,
-- which is what makes instantiation cheap.
fun substitute pairs t =
  match force t with
  | Ty.Var r ->
      (match getRef r with
       | Unbound n l ->
           (match L.lookupAssoc n pairs with
            | Just fresh -> fresh
            | None -> t)
       | Link inner -> substitute pairs inner)
  | Ty.Fun a b -> Ty.Fun (substitute pairs a) (substitute pairs b)
  | other -> other

fun instantiate counter level scheme =
  match scheme with
  | Forall ids body ->
      let pairs = L.map (\n -> (n, newTv counter level)) ids in
      substitute pairs body

-- --- inference ------------------------------------------------------------
--
-- The environment is an association list, because `Std.Collections.Map` is
-- keyed by `Int` and these keys are names. A toy can afford the linear scan.

fun lookupVar env name =
  match L.lookupAssoc name env with
  | Just scheme -> scheme
  | None -> raise (S.concat "unbound variable: " name)

fun binOpType op =
  if op == "+" or op == "-" or op == "*" or op == "/" then (Ty.Int, Ty.Int, Ty.Int)
  else (Ty.Int, Ty.Int, Ty.Bool)

fun infer counter env level e =
  match e with
  | Expr.Int n -> Ty.Int
  | Expr.Bool b -> Ty.Bool
  | Expr.Var name -> instantiate counter level (lookupVar env name)
  | Expr.Lam param body ->
      let argT = newTv counter level in
      let bodyT = infer counter ((param, Forall [;] argT) :: env) level body in
      Ty.Fun argT bodyT
  | Expr.App f a ->
      let fT = infer counter env level f in
      let aT = infer counter env level a in
      let resT = newTv counter level in
      let ignored = unify fT (Ty.Fun aT resT) in
      resT
  | Expr.Let name rhs body ->
      -- The right-hand side is checked one level deeper, so the variables it
      -- invents are marked as belonging to it. Anything that escaped into the
      -- environment was pulled back down by `occursAdjust` and will not be
      -- generalized here.
      let rhsT = infer counter env (level + 1) rhs in
      let scheme = generalize level rhsT in
      infer counter ((name, scheme) :: env) level body
  | Expr.LetRec name param rhs body ->
      -- The name is in scope while checking its own definition, and
      -- *monomorphically* -- a recursive call cannot be at a different type.
      -- Only afterwards is it generalized for the body.
      let fT = newTv counter (level + 1) in
      let argT = newTv counter (level + 1) in
      let resT = newTv counter (level + 1) in
      let inner =
        (param, Forall [;] argT) :: (name, Forall [;] fT) :: env in
        let ignored = unify fT (Ty.Fun argT resT) in
        let bodyT = infer counter inner (level + 1) rhs in
        let ignored2 = unify resT bodyT in
        infer counter ((name, generalize level fT) :: env) level body
  | Expr.If c t f ->
      let cT = infer counter env level c in
      let ignored = unify cT Ty.Bool in
      let tT = infer counter env level t in
      let fT = infer counter env level f in
      let ignored2 = unify tT fT in
      tT
  | Expr.Bin op l r ->
      match binOpType op with
      | (lWant, rWant, out) ->
          let lT = infer counter env level l in
          let ignored = unify lT lWant in
          let rT = infer counter env level r in
          let ignored2 = unify rT rWant in
          out

-- Infer the type of a whole expression. `Err` carries the message a failed
-- unification or an unbound name raised -- `Exn` is doing the unwinding, so
-- nothing between here and `raise` has to mention failure.
@pub fun typeOf e =
  toResult (\() ->
    let counter = newRef 0 in
    typeName (infer counter [;] 0 e))
