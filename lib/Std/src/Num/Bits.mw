-- Std.Num.Bits: bit twiddling, on any fixed-width integer type.
--
-- The primitives `shl` / `shr` / `ushr` / `bitAnd` / `bitOr` / `bitXor` /
-- `bitNot` / `popCount` / `bitWidth` are always in scope; `<<`, `>>` and `>>>`
-- are `shl`, `shr` and `ushr`. A shift amount, like every bit position here, is
-- an `Int` whatever is being shifted. `shr` is arithmetic on a signed type and
-- logical on an unsigned one; `ushr` is logical on both.
--
-- Everything below works at the width of what it is given: `countLeadingZeros`
-- of a `UInt8` counts eight bits, of an `Int` sixty-four. `BigInt` has no fixed
-- width, so the helpers that need one refuse it.

-- The mask with the low `n` bits set, at whatever type is wanted (`lowMask 8`
-- is 255).
@pub fun lowMask (n : Int) : n = (1 << n) - 1

-- Keep only the low `n` bits of `x`.
@pub fun lowBits (n : Int) (x : n) : n = bitAnd x (lowMask n)

-- A single-bit mask: `bit n == 1 << n`.
@pub fun bit (n : Int) : n = 1 << n

-- Is bit `n` of `x` set?
@pub fun testBit (x : n) (n : Int) : Bool = bitAnd (x >> n) 1 == 1

@pub fun setBit (x : n) (n : Int) : n = bitOr x (bit n)

@pub fun clearBit (x : n) (n : Int) : n = bitAnd x (bitNot (bit n))

@pub fun flipBit (x : n) (n : Int) : n = bitXor x (bit n)

-- Byte `k` of `x` (0 is the least significant), as a `UInt8`.
@pub fun byteOf (k : Int) (x : n) : UInt8 = toUInt8 (x >> (8 * k))

-- Four bytes as one `UInt32`, `b0` least significant.
@pub fun fromBytes4 (b0 : n) (b1 : n1) (b2 : n2) (b3 : n3) : UInt32 =
  bitOr
    (bitOr (toUInt32 b0) (toUInt32 b1 << 8))
    (bitOr (toUInt32 b2 << 16) (toUInt32 b3 << 24))

fun bitsClzGo x w n =
  if n >= w then w
  else if testBit x (w - 1 - n) then n
  else bitsClzGo x w (n + 1)

-- Leading zero bits, at `x`'s width. `countLeadingZeros (toUInt8 1) == 7`; of 0
-- it is the whole width.
@pub fun countLeadingZeros (x : n) : Int = bitsClzGo x (bitWidth x) 0

fun bitsCtzGo x w n =
  if n >= w then w
  else if testBit x n then n
  else bitsCtzGo x w (n + 1)

-- Trailing zero bits. `countTrailingZeros 8 == 3`; of 0 it is the whole width.
@pub fun countTrailingZeros (x : n) : Int = bitsCtzGo x (bitWidth x) 0

-- Rotate left by `n` (0 up to the width), at `x`'s width.
@pub fun rotateLeft (x : n) (n : Int) : n = bitOr (x << n) (ushr x (bitWidth x - n))

-- Rotate right by `n` (0 up to the width).
@pub fun rotateRight (x : n) (n : Int) : n = bitOr (ushr x n) (x << (bitWidth x - n))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

@test fun masksAndSingleBits () =
  let a = assertEq (lowMask 8) 255 "lowMask 8" in
  let b = assertEq (lowMask 0) 0 "lowMask 0" in
  let c = assertEq (bit 0) 1 "bit 0" in
  let d = assertEq (bit 10) 1024 "bit 10" in
  assertEq (lowBits 4 255) 15 "lowBits keeps the low nibble"

@test fun bitAccessors () =
  let a = assertTrue (testBit 5 0) "bit 0 of 5" in
  let b = assertFalse (testBit 5 1) "bit 1 of 5" in
  let c = assertTrue (testBit 5 2) "bit 2 of 5" in
  let d = assertEq (setBit 5 1) 7 "setBit" in
  let e = assertEq (clearBit 7 1) 5 "clearBit" in
  assertEq (flipBit (flipBit 5 3) 3) 5 "flipBit twice is the identity"

@test fun byteExtractionAndAssembly () =
  let a = assertEq (byteOf 0 0x12345678) (toUInt8 0x78) "byte 0" in
  let b = assertEq (byteOf 3 0x12345678) (toUInt8 0x12) "byte 3" in
  assertEq (fromBytes4 (toUInt8 0x78) (toUInt8 0x56) (toUInt8 0x34) (toUInt8 0x12)) (toUInt32 0x12345678) "fromBytes4"

@test fun countingZerosAtEachWidth () =
  let a = assertEq (countLeadingZeros (toInt 1)) 63 "clz of an Int" in
  let b = assertEq (countLeadingZeros (toInt 0)) 64 "clz of 0" in
  let c = assertEq (countLeadingZeros (toUInt8 1)) 7 "clz of a UInt8" in
  let d = assertEq (countTrailingZeros (toInt16 8)) 3 "ctz 8" in
  let e = assertEq (countTrailingZeros (toUInt8 0)) 8 "ctz of a UInt8 0" in
  assertEq (countTrailingZeros (toInt 1)) 0 "ctz 1"

@test fun rotationsComeBackAround () =
  let a = assertEq (rotateLeft (toInt 1) 1) (toInt 2) "rotateLeft" in
  let b = assertEq (rotateRight (toInt 2) 1) (toInt 1) "rotateRight" in
  let c = assertEq (rotateLeft (toUInt8 0x81) 1) (toUInt8 0x03) "a UInt8 wraps at eight bits" in
  assertEq (rotateRight (rotateLeft (toInt 0x1234) 9) 9) (toInt 0x1234) "a rotation is reversible"

@test fun shiftsKnowTheirSign () =
  let a = assertEq (toInt8 (0 - 128) >> 7) (toInt8 (0 - 1)) "arithmetic on a signed type" in
  let b = assertEq (toUInt8 128 >> 7) (toUInt8 1) "logical on an unsigned one" in
  assertEq (toInt8 (0 - 128) >>> 7) (toInt8 1) "ushr is logical everywhere"
