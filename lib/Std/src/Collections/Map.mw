-- Std.Collections.Map: an ordered map from `Int` keys to values, backed by a
-- binary search tree. Reach these as `Map.insert` etc.

use Std.Collections.List as List (append, foldl)
use Std.Tuple (fst, snd)
use Std.Maybe (Maybe, isSome)

@pub data Map v = Tip | Node (Map v) Int v (Map v)

@pub def empty = Tip

@pub fun null m = match m with | Tip -> True | Node l k v r -> False

@pub fun size m =
  match m with
  | Tip -> 0
  | Node l k v r -> 1 + size l + size r

@pub fun insert k v m =
  match m with
  | Tip -> Node Tip k v Tip
  | Node l key val r ->
      if k < key then Node (insert k v l) key val r
      else if key < k then Node l key val (insert k v r)
      else Node l k v r

@pub fun lookup k m =
  match m with
  | Tip -> None
  | Node l key val r ->
      if k < key then lookup k l
      else if key < k then lookup k r
      else Just val

@pub fun member k m = isSome (lookup k m)

@pub fun getOr default k m =
  match lookup k m with
  | None -> default
  | Just v -> v

@pub fun toList m =
  match m with
  | Tip -> Nil
  | Node l k v r -> append (toList l) (Cons (k, v) (toList r))

@pub fun keys m = List.map fst (toList m)

@pub fun values m = List.map snd (toList m)

fun insertPair p m = match p with | (k, v) -> insert k v m

@pub fun fromList ps = foldl (\acc p -> insertPair p acc) empty ps

@pub fun map f m =
  match m with
  | Tip -> Tip
  | Node l k v r -> Node (map f l) k (f v) (map f r)

@pub fun minEntry m =
  match m with
  | Tip -> None
  | Node l k v r -> if null l then Just (k, v) else minEntry l

fun deleteMin m =
  match m with
  | Tip -> Tip
  | Node l k v r -> if null l then r else Node (deleteMin l) k v r

fun spliceMin l r =
  match minEntry r with
  | None -> l
  | Just (mk, mv) -> Node l mk mv (deleteMin r)

fun removeRoot l r =
  match (l, r) with
  | (Tip, rr) -> rr
  | (ll, Tip) -> ll
  | (ll, rr) -> spliceMin ll rr

@pub fun delete k m =
  match m with
  | Tip -> Tip
  | Node l key val r ->
      if k < key then Node (delete k l) key val r
      else if key < k then Node l key val (delete k r)
      else removeRoot l r

-- Yield every `(key, value)` pair in key order, for `Std.Stream`.
@pub fun toStream m = List.toStream (toList m)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

def sample = fromList [(1, "a"); (2, "b")]

@test fun insertAndLookup () =
  let x = assertEq (lookup 1 sample) (Just "a") "lookup" in
  let y = assertEq (lookup 9 sample) None "missing key" in
  assertTrue (member 2 sample) "member"

@test fun insertReplacesRatherThanDuplicates () =
  let m = insert 1 "z" sample in
  let x = assertEq (lookup 1 m) (Just "z") "the new value wins" in
  assertEq (size m) 2 "size is unchanged"

@test fun sizeNullAndGetOr () =
  let x = assertEq (size sample) 2 "size" in
  let y = assertEq (size empty) 0 "size of empty" in
  let z = assertTrue (null empty) "null" in
  let w = assertEq (getOr "?" 9 sample) "?" "getOr falls back" in
  assertEq (getOr "?" 1 sample) "a" "getOr finds"

@test fun keysValuesAndToListAreInKeyOrder () =
  let m = fromList [(2, "b"); (1, "a")] in
  let x = assertEq (keys m) [1; 2] "keys" in
  let y = assertEq (values m) ["a"; "b"] "values" in
  assertEq (toList m) [(1, "a"); (2, "b")] "toList"

@test fun mapTouchesValuesOnly () =
  assertEq (toList (map (\v -> "!") sample)) [(1, "!"); (2, "!")] "map"

@test fun deleteRemovesOneEntry () =
  let m = delete 1 sample in
  let x = assertEq (lookup 1 m) None "deleted" in
  let y = assertEq (lookup 2 m) (Just "b") "the rest survive" in
  assertEq (size (delete 9 sample)) 2 "deleting a missing key changes nothing"

@test fun minEntryIsTheSmallestKey () =
  assertEq (minEntry sample) (Just (1, "a")) "minEntry"
