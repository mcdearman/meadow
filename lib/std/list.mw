@pub data List(a) = Empty | Pair(a, List(a)) 

impl List(a) where
  fun map(self, f) =
    match self with
    | Empty -> Empty
    | Pair(x, xs) -> Pair(f(x), self.map(f))

  fun foldl(self, f, acc) =
    match self with
    | Empty -> acc
    | Pair(x, xs) -> self.foldl(f, f(acc, x))

  fun foldr(self, f, acc) =
    match self with
    | Empty -> acc
    | Pair(x, xs) -> f(x, self.foldr(f, acc))

  fun filter(self, p) =
    match self with
    | Empty -> Empty
    | Pair(x, xs) ->
      if p(x) then Pair(x, self.filter(p)) else self.filter(p)
end