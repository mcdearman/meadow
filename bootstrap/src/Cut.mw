-- Cut: the upper IR every front end hands Meadow's back end (`docs/CUT.md`),
-- as a Lingua language, with what a front end builds a program of it with
-- and the text `meadow_cut` reads. Nothing here knows any front end: what
-- lowers Meadow's `Core` to it is `Seq`.
--
-- Cut is a sequent calculus: a producer makes a value, a consumer receives
-- one, and a statement is one meeting the other. A program of it is a tree,
-- not a graph of blocks, so what builds one is not a cursor to write at but
-- a function of where a value goes: `shared`, `branch`, `applied`.

use Lingua (lang!)
use Lingua.Lang (Meta, spanMeta)
use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C

-- --- the language ------------------------------------------------------------

@pub(pkg) lang! {
  pub Cut with In
  File + File { entry : String, answer : String, decls : [Decl] }
  DataCtor + DataCtor { name : String, fields : [String] }
  Decl + Data { symbol : String, params : [String], ctors : [DataCtor] }
  Op + Op { name : String, params : [String], result : String }
  Decl + Effect { symbol : String, ops : [Op] }
  Decl + Val { symbol : String, rep : String, body : Stmt }
  Decl + Def { symbol : String, params : [Param], conts : [Param], body : Stmt }
  Param + Param { name : String, rep : String }
  Prod + Var { name : String }
  Prod + Sym { symbol : String }
  Prod + Int { value : Int }
  Prod + Float { value : Float }
  Prod + Char { code : Int }
  Prod + Str { text : String }
  Prod + Bool { value : Bool }
  Prod + Unit {}
  Prod + Con { symbol : String, args : [Prod] }
  Prod + Tuple { items : [Prod] }
  Prod + Array { items : [Prod] }
  Prod + Mu { k : String, body : Stmt }
  Prod + Cocase { methods : [Method] }
  Method + Method { name : String, params : [Param], conts : [Param], body : Stmt }
  Cons + KVar { name : String }
  Cons + Halt {}
  Cons + MuT { name : String, rep : String, body : Stmt }
  Cons + Call { method : String, args : [Prod], conts : [Cons] }
  CaseArm + CaseArm { pattern : String, fields : [Param], body : Stmt }
  Cons + Case { arms : [CaseArm] }
  Stmt + Cut { prod : Prod, cons : Cons }
  Stmt + Invoke { symbol : String, args : [Prod], conts : [Cons] }
  Stmt + Prim { op : String, args : [Prod], conts : [Cons] }
  Stmt + Perform { op : String, args : [Prod], cont : Cons }
  Clause + Clause { op : String, params : [Param], resume : String, k : String, body : Stmt }
  Stmt
    + Handle {
      clauses : [Clause],
      ret : Param,
      retK : String,
      retBody : Stmt,
      bodyK : String,
      body : Stmt,
      cont : Cons
    }
  Stmt + Error { message : String }
}

-- --- building ----------------------------------------------------------------
--
-- What a front end makes a program with. `out` is the program being
-- written, from `builder` to `finished`, and `m` where in the source what
-- is written came from. The tables under these are the language's own, and
-- nothing outside this module writes them directly.

@pub(pkg) fun builder () = newCutBuilder ()

-- The program `out` holds, whose root is `root`.
@pub(pkg) fun finished out root = CutProgram (freezeCut out) root

-- A program: the definition that runs, what becomes of its answer -- `none`
-- or `str` -- and its declarations.
@pub(pkg) fun file out (m : Meta) (entry : String) (answer : String) decls =
  newCutFile out m entry answer decls

-- `data symbol <params> { ctors }`, each constructor its name and its
-- fields' representations.
@pub(pkg) fun dataDecl out (m : Meta) (symbol : String) (params : [String]) ctors =
  newCutDeclData out m symbol params ctors

@pub(pkg) fun ctorDecl out (m : Meta) (name : String) (fields : [String]) =
  newCutDataCtor out m name fields

-- `effect symbol { ops }`, each operation made with `opDecl`: its name, the
-- representations of what it takes, and that of what it is resumed with.
@pub(pkg) fun effectDecl out (m : Meta) (symbol : String) ops = newCutDeclEffect out m symbol ops

@pub(pkg) fun opDecl out (m : Meta) (name : String) (params : [String]) (result : String) =
  newCutOp out m name params result

-- `val symbol : rep = s`: computed once, what `s` gives to `halt`.
@pub(pkg) fun valDecl out (m : Meta) (symbol : String) (rep : String) body =
  newCutDeclVal out m symbol rep body

-- `def symbol (params; conts) = s`.
@pub(pkg) fun defDecl out (m : Meta) (symbol : String) params conts body =
  newCutDeclDef out m symbol params conts body

@pub(pkg) fun param out (m : Meta) (name : String) (rep : String) = newCutParam out m name rep

-- Producers.
@pub(pkg) fun var out (m : Meta) (name : String) = newCutProdVar out m name

@pub(pkg) fun sym out (m : Meta) (symbol : String) = newCutProdSym out m symbol

@pub(pkg) fun int out (m : Meta) (n : Int) = newCutProdInt out m n

@pub(pkg) fun float out (m : Meta) (x : Float) = newCutProdFloat out m x

@pub(pkg) fun char out (m : Meta) (code : Int) = newCutProdChar out m code

@pub(pkg) fun str out (m : Meta) (s : String) = newCutProdStr out m s

@pub(pkg) fun bool out (m : Meta) (b : Bool) = newCutProdBool out m b

@pub(pkg) fun unit out (m : Meta) = newCutProdUnit out m

@pub(pkg) fun con out (m : Meta) (symbol : String) args = newCutProdCon out m symbol args

@pub(pkg) fun tuple out (m : Meta) items = newCutProdTuple out m items

@pub(pkg) fun array out (m : Meta) items = newCutProdArray out m items

-- A function: codata with one method, `apply`, of one argument named `x`,
-- answering to the continuation named `k`.
@pub(pkg) fun function out (m : Meta) (x : String) (rep : String) (k : String) body =
  newCutProdCocase
    out
    m
    [newCutMethod out m "apply" [newCutParam out m x rep] [newCutParam out m k "ptr"] body]

-- Consumers.
@pub(pkg) fun cont out (m : Meta) (name : String) = newCutConsKVar out m name

@pub(pkg) fun halt out (m : Meta) = newCutConsHalt out m

-- `case { arms }`, each made with `arm`: a constructor's symbol, `#tuple`,
-- or `_`, the fields it binds, and what to do.
@pub(pkg) fun caseOf out (m : Meta) arms = newCutConsCase out m arms

@pub(pkg) fun arm out (m : Meta) (pattern : String) fields body =
  newCutCaseArm out m pattern fields body

-- Statements.
@pub(pkg) fun give out (m : Meta) prod cons = newCutStmtCut out m prod cons

@pub(pkg) fun invoke out (m : Meta) (symbol : String) args conts =
  newCutStmtInvoke out m symbol args conts

@pub(pkg) fun prim out (m : Meta) (op : String) args conts = newCutStmtPrim out m op args conts

@pub(pkg) fun fail out (m : Meta) (message : String) = newCutStmtError out m message

-- `perform op(args; k)`: `k` receives what the operation is resumed with.
@pub(pkg) fun performed out (m : Meta) (op : String) args k = newCutStmtPerform out m op args k

-- A handler's clause for `op`: what it takes, the name of the resumption --
-- a function -- and the name of where the handler's own value goes.
@pub(pkg) fun clause out (m : Meta) (op : String) params (resume : String) (k : String) body =
  newCutClause out m op params resume k body

-- `body` handled, the value of the whole to `k`: `body` is built with the
-- name of its own continuation, `bodyK`, which gives what it answers to the
-- `return` clause -- `returned`, with its value as `ret` and the handler's
-- continuation as `retK`.
@pub(pkg) fun handled out (m : Meta) clauses ret (retK : String) returned (bodyK : String) body k =
  newCutStmtHandle out m clauses ret retK returned bodyK body k

@pub(pkg) def nowhere : Meta = spanMeta 0 0

-- What a lowering has no words for yet: a statement that says so when it
-- runs, so that a program with one in it still reads.
@pub(pkg) fun unsupported out (m : Meta) (what : String) =
  newCutStmtError out m "unsupported: ${what}"

-- What `build` makes with somewhere to send a value more than once: `k`
-- itself, if that is a name already, and otherwise a name for it -- `μ j. s`
-- given to `k` -- so that a consumer written once is not written again in
-- every branch.
@pub(pkg) fun shared out k (m : Meta) (name : String) build =
  let kind = kindCutConsIn out k in
  if kind == CutConsKind.KVar or kind == CutConsKind.Halt then build k
  else newCutStmtCut out m (newCutProdMu out m name (build (newCutConsKVar out m name))) k

-- `no` or `yes`, by the truth `cond` is: a test's branches each receive
-- `unit`, which `name` is bound to, false first.
@pub(pkg) fun branch out (m : Meta) (name : String) cond no yes =
  newCutStmtPrim out m "if" [cond] [
    newCutConsMuT out m name "unit" no,
    newCutConsMuT out m name "unit" yes
  ]

-- The function `f` given `arg`, its answer to `k`: a function is codata
-- with one method, `apply`.
@pub(pkg) fun applied out (m : Meta) f arg k =
  newCutStmtCut out m f (newCutConsCall out m "apply" [arg] [k])

-- A value named `name`, of representation `rep`, for `rest`.
@pub(pkg) fun binding out (m : Meta) (name : String) (rep : String) rest =
  newCutConsMuT out m name rep rest

-- `unit` given to the continuation `name`: how one arm of a match says it
-- did not, to whatever tries the next.
@pub(pkg) fun gaveUp out (m : Meta) (name : String) =
  newCutStmtCut out m (newCutProdUnit out m) (newCutConsKVar out m name)

-- `first`, and `next` if it gives up: `first` is built with the name of the
-- continuation that giving up goes to.
@pub(pkg) fun orElse out (m : Meta) (name : String) first next =
  newCutStmtCut
    out
    m
    (newCutProdMu out m name (first name))
    (newCutConsMuT out m "u_${name}" "unit" next)

-- --- the text ----------------------------------------------------------------

-- A program as `meadow_cut::parse` reads it.
@pub(pkg) fun text (p : CutProgram) : String =
  match p with
  | CutProgram a root ->
      "cut 0\nentry ${cutFileEntry a root}\nanswer ${cutFileAnswer a root}\n\n"
        ++ S.join "\n" (V.map (\d -> decl a d) (cutFileDecls a root))

fun decl (a : CutArena) (d : CutDecl) : String =
  match viewCutDecl a d with
  | CutDeclView.Val r -> "val ${r.symbol} : ${r.rep} =\n  ${stmt a 1 r.body}\n"
  | CutDeclView.Data r ->
      let taking = if V.isEmpty r.params then "" else " <${S.join ", " r.params}>" in
      let ctor =
        \c ->
          (let fs = cutDataCtorFields a c in
           if V.isEmpty fs then cutDataCtorName a c
           else "${cutDataCtorName a c}(${S.join ", " fs})")
      in "data ${r.symbol}${taking} { ${S.join "; " (V.map ctor r.ctors)} }\n"
  | CutDeclView.Effect r ->
      let op = \o -> "${cutOpName a o}(${S.join ", " (cutOpParams a o)}) -> ${cutOpResult a o}" in
      "effect ${r.symbol} { ${S.join "; " (V.map op r.ops)} }\n"
  | CutDeclView.Def r -> "def ${r.symbol} ${params a r.params r.conts} =\n  ${stmt a 1 r.body}\n"

fun paramText (a : CutArena) (p : CutParam) : String = "${cutParamName a p}: ${cutParamRep a p}"

fun params (a : CutArena) (ps : [CutParam]) (ks : [CutParam]) : String =
  "(${S.join ", " (V.map (paramText a) ps)}; ${S.join ", " (V.map (paramText a) ks)})"

fun line (depth : Int) : String = "\n" ++ S.repeat "  " depth

fun call (a : CutArena) (depth : Int) (args : [CutProd]) (ks : [CutCons]) : String =
  "(${S.join ", " (V.map (prod a depth) args)}; ${S.join ", " (V.map (cons a depth) ks)})"

fun stmt (a : CutArena) (depth : Int) (s : CutStmt) : String =
  match viewCutStmt a s with
  | CutStmtView.Cut r -> "<${prod a depth r.prod} | ${cons a depth r.cons}>"
  | CutStmtView.Invoke r -> r.symbol ++ call a depth r.args r.conts
  | CutStmtView.Prim r -> "prim ${r.op}" ++ call a depth r.args r.conts
  | CutStmtView.Perform r -> "perform ${r.op}" ++ call a depth r.args [r.cont]
  | CutStmtView.Handle r ->
      let named = \n -> "${n}: ptr" in
      let clauses =
        V.map
          (\c ->
            "${line (depth + 1)}${cutClauseOp a c}(${S.join ", " (V.map (paramText a) (cutClauseParams a c))}; ${named (cutClauseResume a c)}, ${named (cutClauseK a c)}) =>${line (depth + 2)}${stmt a (depth + 2) (cutClauseBody a c)};")
          r.clauses
      in "handle {"
           ++ S.join "" clauses
           ++ "${line (depth + 1)}return(${paramText a r.ret}; ${named r.retK}) =>${line (depth + 2)}${stmt a (depth + 2) r.retBody}"
           ++ "${line depth}} in μ ${r.bodyK}.${line (depth + 1)}${stmt a (depth + 1) r.body}"
           ++ "${line depth}; ${cons a depth r.cont}"
  | CutStmtView.Error r -> "error ${quoted r.message}"

fun prod (a : CutArena) (depth : Int) (p : CutProd) : String =
  match viewCutProd a p with
  | CutProdView.Var r -> r.name
  | CutProdView.Sym r -> r.symbol
  | CutProdView.Int r -> show r.value
  | CutProdView.Float r -> show r.value
  | CutProdView.Char r -> "'\\u{${hex r.code}}'"
  | CutProdView.Str r -> quoted r.text
  | CutProdView.Bool r -> if r.value then "true" else "false"
  | CutProdView.Unit _ -> "unit"
  | CutProdView.Con r ->
      if V.isEmpty r.args then r.symbol
      else "${r.symbol}(${S.join ", " (V.map (prod a depth) r.args)})"
  | CutProdView.Tuple r -> "#tuple(${S.join ", " (V.map (prod a depth) r.items)})"
  | CutProdView.Array r -> "[${S.join ", " (V.map (prod a depth) r.items)}]"
  | CutProdView.Mu r -> "μ ${r.k}.${line (depth + 1)}${stmt a (depth + 1) r.body}"
  | CutProdView.Cocase r ->
      "cocase {"
        ++ S.join
          ";"
          (V.map
             (\m ->
               "${line (depth + 1)}${cutMethodName a m}${params a (cutMethodParams a m) (cutMethodConts a m)} =>${line (depth + 2)}${stmt a (depth + 2) (cutMethodBody a m)}")
             r.methods)
        ++ line depth
        ++ "}"

fun cons (a : CutArena) (depth : Int) (c : CutCons) : String =
  match viewCutCons a c with
  | CutConsView.KVar r -> r.name
  | CutConsView.Halt _ -> "halt"
  | CutConsView.MuT r -> "μ̃ ${r.name}: ${r.rep}.${line (depth + 1)}${stmt a (depth + 1) r.body}"
  | CutConsView.Case r ->
      "case {"
        ++ S.join
          ";"
          (V.map
             (\arm ->
               (let pattern = cutCaseArmPattern a arm in
                let fields = cutCaseArmFields a arm in
                let taken =
                  if V.isEmpty fields and pattern != "#tuple" then ""
                  else "(${S.join ", " (V.map (paramText a) fields)})"
                in "${line (depth + 1)}${pattern}${taken} =>${line (depth + 2)}${stmt a (depth + 2) (cutCaseArmBody a arm)}"))
             r.arms)
        ++ line depth
        ++ "}"
  | CutConsView.Call r -> r.method ++ call a depth r.args r.conts

-- A string as Cut writes one.
fun quoted (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\c ->
           if c == '"' then "\\\""
           else if c == '\\' then "\\\\"
           else if c == '\n' then "\\n"
           else if c == '\t' then "\\t"
           else if c == '\r' then "\\r"
           else C.toString c)
         (S.chars s))
    ++ "\""

fun hex (n : Int) : String =
  if n < 16 then stringSlice "0123456789abcdef" n (n + 1) else hex (n / 16) ++ hex (n % 16)

-- Definitions that make an `i64` its digits, in `package`: what `answer str`
-- needs of a whole number, since a runtime turns nothing into text but text.
-- Text, to follow a program's, until there is a way to say them as nodes.
@pub(pkg) fun showInt (package : String) : String = "
def ${package}\"#showInt\" (n: i64; k: ptr) =
  prim lt(n, 0; μ̃ u: unit. ${package}\"#showNat\"(n; k), μ̃ u: unit. prim sub(0, n; μ̃ m: i64. ${package}\"#showNat\"(m; μ̃ s: str. prim concatStrings([\"-\", s]; k))))

def ${package}\"#showNat\" (n: i64; k: ptr) =
  prim lt(n, 10; μ̃ u: unit. prim div(n, 10; μ̃ q: i64. ${package}\"#showNat\"(q; μ̃ hi: str. prim mod(n, 10; μ̃ r: i64. ${package}\"#digit\"(r; μ̃ d: str. prim concatStrings([hi, d]; k))))), μ̃ u: unit. ${package}\"#digit\"(n; k))

def ${package}\"#digit\" (d: i64; k: ptr) =
  prim add(d, 1; μ̃ e: i64. prim stringSlice(\"0123456789\", d, e; k))
"
