v0 : forall a b. (a -> a ! b)
v0 = (/\a b. (\(v1 : a). (letrec v2 : forall c. (Int -> a ! c) = (/\c. (\(v3 : Int). (if (Eq v3 0) v1 ((v2 @c) (Sub v3 1))))) in ((v2 @b) 3))))
