-- Std.Console: the terminal, as an effect -- writing to it and reading from it.
--
-- `print` and `println` are ordinary functions over one operation,
-- `writeOutput`, and the prelude re-exports them, so printing needs no `use`.
-- With no handler the runtime writes to real standard output and reads real
-- standard input. A handler can stand in for either: `withInput` supplies the
-- lines a program reads, and `withOutput` collects what it prints. That is what
-- makes an interactive program testable -- a suite that blocks waiting for
-- someone to type is a suite that hangs, and one that prints can now check what
-- it printed.
--
--
--   use Std.Console (readLine, prompt)
--
--   def main =
--     match prompt "your name: " with
--     | Just name -> println (S.concat "hello, " name)
--     | None -> println "nothing to read"
--
-- With `withInput` it reads from a list you supply, and with `withOutput` it
-- hands back what was printed:
--
--   @test fun greets () =
--     assertEq (withInput ["ada"] (\() -> prompt "name: ")) (Just "ada") "reads"
--
--   @test fun saysHello () =
--     assertEq (withOutput (\() -> println "hello")) ((), "hello\n") "prints"
--
-- `readLine` answers `None` at end of input -- a closed pipe, or Ctrl-D at a
-- terminal. That is not an error, so a loop ends by pattern-matching it rather
-- than by catching anything.

use Std.Maybe (unwrapOr)
use Std.Maybe.Maybe.*
use Std.Test (assertEq)
use Std.String as S
use Std.Collections.Vector as V
-- `[a, b]` desugars to a `vecFromArray` call.
use Std.Collections.Vector (vecFromArray)

@pub effect Console {
  -- Write `text` exactly as given: no newline is added.
  writeOutput : String -> (),
  -- The next line, without its line terminator. `None` at end of input.
  readLine : () -> Maybe String,
}

-- --- writing ------------------------------------------------------------------

-- Write a value with no trailing newline. A `String` is written as its text;
-- anything else the way `show` renders it, so `print 42` writes `42` and
-- `print "hi"` writes `hi`, not `"hi"`.
@pub fun print value = writeOutput (display value)

-- `print`, then a newline.
@pub fun println value = writeOutput (S.concat (display value) "\n")

-- --- reading ------------------------------------------------------------------

-- Write `message` with no trailing newline, then read a line.
@pub fun prompt message =
  let _ = print message in
  readLine ()

-- The next line, or `fallback` at end of input.
@pub fun readLineOr fallback = unwrapOr fallback (readLine ())

-- The next line with surrounding whitespace removed, which is almost always what
-- you want from a person typing: a stray space before `rock` should not be a
-- different answer.
@pub fun readWord () =
  match readLine () with
  | None -> None
  | Just line -> Just (S.trim line)

-- Keep asking until the answer parses. `parse` returns `Maybe b`; a `None` is
-- reported with `retry` and the question is put again. Ends as `None` only if
-- input runs out, so a piped-in file cannot spin forever.
@pub fun promptUntil message retry parse =
  match prompt message with
  | None -> None
  | Just line ->
      match parse (S.trim line) with
      | Just _ as parsed -> parsed
      | None ->
          let _ = println retry in
          promptUntil message retry parse

-- Every remaining line, in order.
@pub fun readAll () = readAllLoop V.empty

fun readAllLoop acc =
  match readLine () with
  | None -> acc
  | Just line -> readAllLoop (V.pushBack acc line)

-- --- handling -----------------------------------------------------------------

-- Run `body` with the `Vector` `lines` as the input, so nothing touches the
-- terminal. Once they are exhausted every `readLine` answers `None`.
@pub fun withInput lines body =
  let feed =
    handle body () with {
      -- `get` is `None` past the end, which is exactly the answer wanted.
      readLine () k -> \next -> (k (V.get lines next)) (next + 1),
      return x -> \next -> x
    }
  in feed 0

-- Run `body` and collect everything it writes instead of printing it: the
-- result, paired with the text. Reading is left alone, so this nests with
-- `withInput` in either order.
@pub fun withOutput body =
  let collect =
    handle body () with {
      writeOutput text k -> \written -> (k ()) (S.concat written text),
      return x -> \written -> (x, written)
    }
  in collect ""

-- --- tests --------------------------------------------------------------------
--
-- All of these go through `withInput` or `withOutput`. A test that reached the
-- real terminal would block the suite waiting for someone to type, which is the
-- reason the terminal is an effect at all.

@test fun printAndPrintlnWriteTheirText () =
  let got = withOutput (\() -> let _ = print "a" in let _ = println "b" in println 42) in
  assertEq got ((), "ab\n42\n") "a String as itself, anything else as show renders it"

@test fun withOutputKeepsTheResult () =
  assertEq (withOutput (\() -> let _ = print "x" in 7)) (7, "x") "the value and the text"

@test fun aPromptIsATranscript () =
  -- Both halves of the conversation, with nothing touching the terminal.
  let got = withOutput (\() -> withInput ["ada"] (\() -> prompt "name: ")) in
  assertEq got (Just "ada", "name: ") "the question was written, the answer read"

@test fun nothingWrittenIsTheEmptyString () =
  assertEq (withOutput (\() -> 1)) (1, "") "no output"

@test fun readsLinesInOrder () =
  let got = withInput ["one", "two"] (\() -> (readLine (), readLine ())) in
  assertEq got (Just "one", Just "two") "two lines, in order"

@test fun endOfInputIsNoneNotAnError () =
  let got = withInput ["only"] (\() -> (readLine (), readLine (), readLine ())) in
  assertEq got (Just "only", None, None) "None once the input runs out"

@test fun emptyInputReadsNothing () =
  assertEq (withInput [] (\() -> readLine ())) None "nothing to read"

@test fun readLineOrSubstitutesAtEndOfInput () =
  let got = withInput ["here"] (\() -> (readLineOr "gone", readLineOr "gone")) in
  assertEq got ("here", "gone") "the fallback only applies at the end"

@test fun readWordTrimsSurroundingSpace () =
  -- A person typing `rock ` should not give a different answer from `rock`.
  assertEq (withInput ["  rock  "] (\() -> readWord ())) (Just "rock") "trimmed"

@test fun readAllCollectsTheRest () =
  let got = withInput ["a", "b", "c"] (\() -> (readLine (), readAll ())) in
  assertEq got (Just "a", ["b", "c"]) "the first line, then the rest"

@test fun promptUntilRetriesUntilItParses () =
  let parse = \s -> match s with | "yes" -> Just True | _ -> None in
  let (got, written) =
    withOutput (\() -> withInput ["no", "maybe", "yes"] (\() -> promptUntil "?" "again" parse)) in
    let a = assertEq got (Just True) "keeps asking past the answers that do not parse" in
    assertEq written "?again\n?again\n?" "asked three times, told off twice"

@test fun promptUntilGivesUpAtEndOfInput () =
  -- Otherwise a piped-in file that never satisfies `parse` would spin forever.
  let parse = \s -> match s with | "yes" -> Just True | _ -> None in
  let (got, written) = withOutput (\() -> withInput ["no", "no"] (\() -> promptUntil "?" "again" parse)) in
  assertEq got None "runs out rather than looping"
