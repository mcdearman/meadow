cabal-version: 3.0
name: meadow
version: 0.1.0.0
synopsis: The official compiler for the Meadow programming language
license: BSD-3-Clause
license-file: LICENSE
author: Chris McDearman
maintainer: mcdearmanchris@gmail.com
category: Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common shared
  ghc-options:
    -Wall
    -Werror=missing-signatures
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Wno-unused-do-bind

  default-extensions:
    FunctionalDependencies
    MagicHash
    MultiWayIf
    MultilineStrings
    OrPatterns
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    RequiredTypeArguments
    ScopedTypeVariables
    StrictData
    TypeFamilies
    ViewPatterns

  build-depends:
    array,
    base,
    bytestring,
    containers,
    diagnose,
    hashable,
    megaparsec,
    mtl,
    parser-combinators,
    pretty-simple,
    prettyprinter,
    primitive,
    stm,
    text,
    transformers,
    unordered-containers,
    vector,
    wcwidth,

executable meadow
  import: shared
  main-is: Main.hs
  build-depends:
    haskeline,
    meadow,

  hs-source-dirs: app
  default-language: GHC2024

library
  import: shared
  exposed-modules:
    Meadow.Infer
    Meadow.Lexer
    Meadow.Parser
    Meadow.Rename
    Meadow.Syn
    Meadow.Token
    Meadow.Utils

  build-tool-depends: alex:alex
  hs-source-dirs: src
  default-language: GHC2024

