-- Std.Collections.Map: an ordered map from `Int` keys to values, backed by a
-- binary search tree. Reach these as `Map.insert` etc.

use Std.Collections.List as List
use Std.Collections.Vector as V
-- `[a, b]` desugars to a `vecFromArray` call.
use Std.Collections.Vector (vecFromArray)
use Std.Yield (yield)
use Std.Tuple (fst, snd)
use Std.Maybe (isSome)
use Std.Maybe.Maybe.*

use Map.*
@derive(Debug, Display)
@pub data Map v = Tip | Node (Map v) Int v (Map v)

@pub def empty : Map a = Tip

@pub fun null (m : Map a) : Bool = match m with | Tip -> True | Node l k v r -> False

@pub fun size (m : Map a) : n =
  match m with
  | Tip -> 0
  | Node l k v r -> 1 + size l + size r

@pub fun insert (k : Int) (v : a) (m : Map a) : Map a =
  match m with
  | Tip -> Node Tip k v Tip
  | Node l key val r ->
      if k < key then Node (insert k v l) key val r
      else if key < k then Node l key val (insert k v r)
      else Node l k v r

@pub fun lookup (k : Int) (m : Map a) : Maybe a =
  match m with
  | Tip -> None
  | Node l key val r ->
      if k < key then lookup k l
      else if key < k then lookup k r
      else Just val

@pub fun member (k : Int) (m : Map a) : Bool = isSome (lookup k m)

@pub fun getOr (default : a) (k : Int) (m : Map a) : a =
  match lookup k m with
  | None -> default
  | Just v -> v

-- Every `(key, value)` pair, in key order.
@pub fun toVec (m : Map a) : [(Int, a)] = pushInOrder V.empty m

fun pushInOrder acc m =
  match m with
  | Tip -> acc
  | Node l k v r -> pushInOrder (V.pushBack (pushInOrder acc l) (k, v)) r

@pub fun keys (m : Map a) : [Int] = V.map fst (toVec m)

@pub fun values (m : Map a) : [a] = V.map snd (toVec m)

fun insertPair p m = match p with | (k, v) -> insert k v m

@pub fun fromVec (ps : [(Int, a)]) : Map a = V.foldl (\acc p -> insertPair p acc) empty ps

-- The same, as a `List`.
@pub fun toList (m : Map a) : List (Int, a) = consInOrder [;] m

fun consInOrder acc m =
  match m with
  | Tip -> acc
  | Node l k v r -> consInOrder ((k, v) :: consInOrder acc r) l

@pub fun fromList (ps : List (Int, a)) : Map a = List.foldl (\acc p -> insertPair p acc) empty ps

@pub fun map (f : a -> b ! e) (m : Map a) : Map b ! e =
  match m with
  | Tip -> Tip
  | Node l k v r -> Node (map f l) k (f v) (map f r)

@pub fun minEntry (m : Map a) : Maybe (Int, a) =
  match m with
  | Tip -> None
  | Node Tip k v _ -> Just (k, v)
  | Node l _ _ _ -> minEntry l

fun deleteMin m =
  match m with
  | Tip -> Tip
  | Node Tip _ _ r -> r
  | Node l k v r -> Node (deleteMin l) k v r

fun spliceMin l r =
  match minEntry r with
  | None -> l
  | Just (mk, mv) -> Node l mk mv (deleteMin r)

fun removeRoot l r =
  match (l, r) with
  | (Tip, rr) -> rr
  | (ll, Tip) -> ll
  | (ll, rr) -> spliceMin ll rr

@pub fun delete (k : Int) (m : Map a) : Map a =
  match m with
  | Tip -> Tip
  | Node l key val r ->
      if k < key then Node (delete k l) key val r
      else if key < k then Node l key val (delete k r)
      else removeRoot l r

-- Yield every `(key, value)` pair in key order, for `Std.Stream`.
@pub fun toStream (m : Map a) : () ! { Yield (Int, a) | e } =
  match m with
  | Tip -> ()
  | Node l k v r ->
      let _ = toStream l in
      let _ = yield (k, v) in
      toStream r

-- --- comparing -----------------------------------------------------------------

-- By their entries in key order, not by the shape of the tree beneath.

impl PartialEq (Map a) where PartialEq a {
  fun (==) x y = toList x == toList y
}

impl Eq (Map a) where Eq a {
}

impl PartialOrd (Map a) where PartialOrd a {
  fun partialCmp x y = partialCmp (toList x) (toList y)
}

impl Ord (Map a) where Ord a {
  fun compare x y = compare (toList x) (toList y)
}

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

def sample = fromVec [(1, "a"), (2, "b")]

@test fun insertAndLookup () =
  let x = assertEq (lookup 1 sample) (Just "a") "lookup" in
  let y = assertEq (lookup 9 sample) None "missing key" in
  assertTrue (member 2 sample) "member"

@test fun insertReplacesRatherThanDuplicates () =
  let m = insert 1 "z" sample in
  let x = assertEq (lookup 1 m) (Just "z") "the new value wins" in
  assertEq (size m) 2 "size is unchanged"

@test fun sizeNullAndGetOr () =
  let x = assertEq (size sample) 2 "size" in
  let y = assertEq (size empty) 0 "size of empty" in
  let z = assertTrue (null empty) "null" in
  let w = assertEq (getOr "?" 9 sample) "?" "getOr falls back" in
  assertEq (getOr "?" 1 sample) "a" "getOr finds"

@test fun keysValuesAndToVecAreInKeyOrder () =
  let m = fromVec [(2, "b"), (1, "a"), (3, "c")] in
  let x = assertEq (keys m) [1, 2, 3] "keys" in
  let y = assertEq (values m) ["a", "b", "c"] "values" in
  let z = assertEq (toVec m) [(1, "a"), (2, "b"), (3, "c")] "toVec" in
  let w = assertEq (toList m) [(1, "a"); (2, "b"); (3, "c")] "toList" in
  assertEq (toVec (fromList [(2, "b"); (1, "a")])) [(1, "a"), (2, "b")] "fromList"

@test fun mapTouchesValuesOnly () =
  assertEq (toVec (map (\v -> "!") sample)) [(1, "!"), (2, "!")] "map"

@test fun deleteRemovesOneEntry () =
  let m = delete 1 sample in
  let x = assertEq (lookup 1 m) None "deleted" in
  let y = assertEq (lookup 2 m) (Just "b") "the rest survive" in
  assertEq (size (delete 9 sample)) 2 "deleting a missing key changes nothing"

@test fun minEntryIsTheSmallestKey () =
  assertEq (minEntry sample) (Just (1, "a")) "minEntry"
