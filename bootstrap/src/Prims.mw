-- The scheme of the primitive `name`, if it has one.
@pub fun primScheme (name : String) : Maybe Scheme =
  let scrutinee = V.find (\x -> match x with | (n, _, _) -> n == name) prims in
  match scrutinee with
  | Just (_, s, _) -> s
  | None -> None

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun everyPrimitiveIsWrittenAsTheRustCompilerWritesIt () =
  let wrong =
    V.concatMap
      (\x -> match x with
             | (n, Just s, shown) ->
                 (if showScheme s == shown then [] else ["${n}: ${showScheme s}, not ${shown}"])
             | _ -> [])
      prims
  in assertEq wrong [] "each as it is written there"
