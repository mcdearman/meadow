-- Std.Collections.Set: an ordered set of `Int`, backed by a `Tree`.
-- Reach these as `Set.insert` etc.

use Std.Collections.Tree as Tree
use Std.Collections.Vector as V
-- `[a, b]` desugars to a `vecFromArray` call.
use Std.Collections.Vector (vecFromArray)

use Set.*
@pub data Set = Set (Tree Int)

@pub def empty = Set Tree.empty

fun unwrap s = match s with | Set t -> t

@pub fun insert x s = Set (Tree.insert x (unwrap s))

@pub fun delete x s = Set (Tree.delete x (unwrap s))

@pub fun member x s = Tree.member x (unwrap s)

@pub fun size s = Tree.size (unwrap s)

@pub fun null s = Tree.null (unwrap s)

-- Every element, ascending.
@pub fun toVec s = Tree.toVec (unwrap s)

@pub fun fromVec v = Set (Tree.fromVec v)

-- The same, as a `List`.
@pub fun toList s = Tree.toList (unwrap s)

@pub fun fromList xs = Set (Tree.fromList xs)

@pub fun minElem s = Tree.minElem (unwrap s)

@pub fun maxElem s = Tree.maxElem (unwrap s)

@pub fun union a b = V.foldl (\acc x -> insert x acc) a (toVec b)

@pub fun diff a b = V.foldl (\acc x -> delete x acc) a (toVec b)

@pub fun intersect a b = fromVec (V.filter (\x -> member x b) (toVec a))

@pub fun subset a b = V.all (\x -> member x b) (toVec a)

-- Yield every element in ascending order, for `Std.Stream`.
@pub fun toStream s = Tree.toStream (unwrap s)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe.Maybe.*

def a = fromVec [1, 2, 3]

def b = fromVec [3, 4]

@test fun insertAndMember () =
  let x = assertTrue (member 2 a) "member" in
  let y = assertFalse (member 9 a) "not member" in
  assertTrue (member 9 (insert 9 a)) "inserted"

@test fun setsDoNotHoldDuplicates () =
  let x = assertEq (size (fromVec [1, 1, 1])) 1 "fromVec dedupes" in
  assertEq (size (insert 1 a)) 3 "re-inserting changes nothing"

@test fun toVecIsSortedAndDistinct () =
  let x = assertEq (toVec a) [1, 2, 3] "sorted" in
  let y = assertEq (toVec (fromVec [3, 1, 3, 2])) [1, 2, 3] "sorted and deduped" in
  assertEq (toList (fromList [2; 1; 2])) [1; 2] "the List forms agree"

@test fun unionDiffIntersect () =
  let x = assertEq (toVec (union a b)) [1, 2, 3, 4] "union" in
  let y = assertEq (toVec (diff a b)) [1, 2] "diff" in
  assertEq (toVec (intersect a b)) [3] "intersect"

@test fun subsetAndEmptiness () =
  let x = assertTrue (subset (fromVec [1, 2]) a) "a subset" in
  let y = assertFalse (subset b a) "not a subset" in
  let z = assertTrue (subset empty a) "empty is a subset of anything" in
  assertTrue (null empty) "null"

@test fun deleteAndExtremes () =
  let x = assertFalse (member 2 (delete 2 a)) "deleted" in
  let y = assertEq (minElem a) (Just 1) "minElem" in
  assertEq (maxElem a) (Just 3) "maxElem"
