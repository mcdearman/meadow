cli! {
  pub Cli "meadowboot" "Meadow's compiler, written in Meadow"
    | lex "Each file's tokens, one a line, and then what is wrong in them" { files : [String] "the files to read" }
    | eval "Run each program of core with the CEK machine, and say its value" { files : [String] "core, as the Rust compiler writes it" }
    | parse "Parse each file, and write the abstract syntax it is" { files : [String] "the files to read" }
    | fixity "Group each file's operators by every fixity its unit knows, and write how each chain grouped"
        { files : [String] "the files to read, each in a package; the standard library's sources are where `MEADOWBOOT_STD` says" }
    | rename "Resolve each file's names with its unit's, and write each name and where what it names was declared"
        { files : [String] "the files to read, each in a package; the standard library's sources are where `MEADOWBOOT_STD` says" }
    | infer "Infer each file's types with its unit's, and write each top-level name and its scheme"
        { files : [String] "the files to read, each in a package; the standard library's sources are where `MEADOWBOOT_STD` says" }
}

fun main () = catch failed (\() -> run (argsCli ()))

-- A query read before it was set, or one that needs itself: a mistake of the
-- compiler's rather than of what it read. It is said, and the run fails.
fun failed (e : QueryError k) = let u = writeOutput (failure e) in exit 1

fun failure (e : QueryError k) : String =
  match e with
  | QueryError.Unset _ -> "meadowboot: a query was read before it was set\n"
  | QueryError.Cycle ks ->
      "meadowboot: ${S.fromInt (V.len ks)} queries need each other\n"

fun run (cli : Cli) =
  match cli with
  | Cli.Lex r -> finish (V.foldl (\ok p -> lexFile p and ok) True r.files)
  | Cli.Eval r -> finish (V.foldl (\ok p -> evalFile p and ok) True r.files)
  | Cli.Parse r -> finish (V.foldl (\ok p -> parseFile p and ok) True r.files)
  | Cli.Fixity r -> finish (fixityFiles r.files)
  | Cli.Rename r -> finish (renameFiles r.files)
  | Cli.Infer r -> finish (inferFiles r.files)

-- Each of `files`, its names resolved with every other of its unit's -- a
-- package, built with the units it depends on first -- under a line naming
-- it: each name written a line, `from to kind declared` (`Rename`), or `not
-- compiled` for a file that is none of its unit's modules, or whose unit did
-- not build.
fun renameFiles (files : [String]) =
  let roots =
    V.foldl
      (\acc f -> match packageOf f with
                 | Just r -> (if V.elem r acc then acc else V.pushBack acc r)
                 | None -> acc)
      []
      files
  in
  let built = V.map (\r -> buildUnits r) roots in
  let named =
    V.map
      (\r ->
        (
          r,
          M.map
            (\u -> (let db = unitDatabase u in fst3 (compilerRenamed db 0)))
            (Res.toMaybe (givenUnits r r))
        ))
      roots
  in
  V.foldl (\ok f -> renameFile named f and ok) True files

fun fst3 (t : (a, b, c)) : a = match t with | (x, _, _) -> x

-- Each of `files`, its unit inferred, under a line naming it: each name a
-- top-level binding binds a line, `from to name : scheme` (`Infer`), or `not
-- compiled`.
fun inferFiles (files : [String]) =
  let roots =
    V.foldl
      (\acc f -> match packageOf f with
                 | Just r -> (if V.elem r acc then acc else V.pushBack acc r)
                 | None -> acc)
      []
      files
  in
  let built = V.map (\r -> buildUnits r) roots in
  let named =
    V.map
      (\r ->
        (
          r,
          M.map
            (\u -> (let db = unitDatabase u in fst4 (compilerInferred db 0)))
            (Res.toMaybe (givenUnits r r))
        ))
      roots
  in
  V.foldl (\ok f -> renameFile named f and ok) True files

fun fst4 (t : (a, b, c, d)) : a = match t with | (x, _, _, _) -> x

fun renameFile named (path : String) =
  let file = absolute path in
  let found = M.andThen (\r -> M.andThen snd (V.find (\d -> fst d == r) named)) (packageOf file)
  in
  let lines = M.andThen (\ds -> M.map snd (V.find (\d -> fst d == file) ds)) found
  in
  match lines with
  | Just ls ->
      (let u = writeOutput ("== ${path}\n" ++ S.join "" (V.map (\l -> l ++ "\n") ls)) in True)
  | None -> (let u = writeOutput "== ${path}\nnot compiled\n" in True)

-- `path`'s abstract syntax, a node a line, under a line naming it -- or
-- `parse failed`.
fun parseFile (path : String) : Bool ! { Fs, Console | e } =
  match readToString path with
  | Err why ->
      (let u = writeOutput "== ${path}\nerror: cannot read it: ${why}\n" in False)
  | Ok text ->
      (match parsed text with
       | Ok tree -> (let u = writeOutput ("== ${path}\n" ++ tree) in True)
       | Err _ -> (let u = writeOutput "== ${path}\nparse failed\n" in True))

-- Each of `files`, its operators grouped by the fixities of the unit it is in
-- -- a package, built with the units it depends on first (`Compiler`) --
-- under a line naming it: each chain outside a pattern, bracketed as it
-- grouped, first operator first (`Fixity.chainsOf`), then each that could not
-- be grouped: `fixity error FROM..TO why`. The builds say how they went
-- before any file is named.
fun fixityFiles (files : [String]) =
  let roots =
    V.foldl
      (\acc f -> match packageOf f with
                 | Just r -> (if V.elem r acc then acc else V.pushBack acc r)
                 | None -> acc)
      []
      files
  in
  let built = V.map (\r -> buildUnits r) roots in
  -- One database a unit, which each of its files is asked of.
  let dbs = V.map (\r -> (r, M.map unitDatabase (Res.toMaybe (givenUnits r r)))) roots
  in
  V.foldl (\ok f -> fixityFile dbs f and ok) True files

fun fixityFile dbs (path : String) =
  let file = absolute path in
  match readToString file with
  | Err why ->
      (let u = writeOutput "== ${path}\nerror: cannot read it: ${why}\n" in False)
  | Ok text ->
      (match M.andThen (\r -> M.andThen snd (V.find (\d -> fst d == r) dbs)) (packageOf file) with
       | None ->
           (let u = writeOutput "== ${path}\nerror: its package did not build\n" in False)
       | Just db ->
           -- A file of the package that is none of its modules -- a test's
           -- -- grouped by the package's fixities all the same.
           let u = setCompilerSource db file text in
           (match compilerGrouped db file with
            | None -> (let w = writeOutput "== ${path}\nparse failed\n" in True)
            | Just (g, ds) ->
                let chains = S.join "" (V.map (\c -> "chain ${c}\n") (chainsOf (R.root g)))
                in
                let problems =
                  S.join
                    ""
                    (V.map
                      (\d ->
                        "fixity error ${show (metaStart (whereAt d))}..${show (metaEnd (whereAt d))} ${message d}\n")
                      ds)
                in
                let w = writeOutput ("== ${path}\n" ++ chains ++ problems) in
                True))

-- `path`'s value, or `error: why`, under a line naming it.
fun evalFile (path : String) : Bool ! { Fs, Console | e } =
  match readToString path with
  | Err why ->
      (let u = writeOutput "== ${path}\nerror: cannot read it: ${why}\n" in False)
  | Ok text ->
      (match program text with
       | Err why ->
           (let u = writeOutput "== ${path}\nerror: cannot read it: ${why}\n" in False)
       | Ok p ->
           (match Cek.run p with
            | Ok v ->
                (let u = writeOutput "== ${path}\n${Cek.display v}\n" in True)
            | Err why ->
                (let u = writeOutput "== ${path}\nerror: ${why}\n" in True)))

-- End with status 1 when something went wrong.
fun finish (ok : Bool) = if ok then () else exit 1

-- `path`'s tokens under a line naming it: `== path`.
fun lexFile (path : String) : Bool ! { Fs, Console | e } =
  match readToString path with
  | Err why ->
      (let u = writeOutput "== ${path}\n! cannot read it: ${why}\n" in False)
  | Ok text -> (let u = writeOutput "== ${path}\n${dump (lex text)}" in True)
