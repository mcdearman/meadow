-- Std.Json: parse and render JSON.
--
--   use Std.Json as J
--
--   def main =
--     match J.parse "{\"a\": [1, 2, 3]}" with
--     | Ok v -> J.render v
--     | Err e -> e
--
-- The parser is built out of `Std.String.Parse`, over the bytes of the input, and
-- follows RFC 8259 with two deliberate gaps noted at `number` and `escape` below.
-- The renderer is the inverse for everything the parser accepts.

use Std.Bool (not)
use Std.String as S
use Std.String.Parse as P
use Std.Collections.Vector as V
use Std.Collections.Vector (vecFromArray)
use Std.Collections.List (foldr)
use Std.Tuple (fst, snd, pair)
use Std.Maybe (Maybe, Just, None)

-- --- the tree -----------------------------------------------------------------

-- Numbers are split into `Int` and `Float` rather than JSON's single number
-- type, because meadow's `Int` and `Float` are separate and silently widening
-- every integer to a float would lose precision no one asked to lose.
@pub data Json
  = Null
  | Bool Bool
  | Int Int
  | Float Float
  | String String
  | Array [Json]
  | Object [(String, Json)]

-- --- constructing --------------------------------------------------------------

@pub fun jNull () = Null

@pub fun jBool b = Bool b

@pub fun jInt n = Int n

@pub fun jString s = String s

@pub fun jArray xs = Array xs

@pub fun jObject fields = Object fields

-- --- inspecting ---------------------------------------------------------------

@pub fun isNull v = match v with | Null -> True | _ -> False

@pub fun asBool v = match v with | Bool b -> Just b | _ -> None

@pub fun asInt v = match v with | Int n -> Just n | _ -> None

@pub fun asFloat v =
  match v with
  | Float x -> Just x
  | Int n -> Just (toFloat n)
  | _ -> None

@pub fun asString v = match v with | String s -> Just s | _ -> None

@pub fun asArray v = match v with | Array xs -> Just xs | _ -> None

@pub fun asObject v = match v with | Object fs -> Just fs | _ -> None

-- The value at `key`, or `None` if this is not an object or has no such key.
@pub fun get key v =
  match v with
  | Object fields -> lookupField key fields
  | _ -> None

-- The element at `i`, or `None`.
@pub fun index i v =
  match v with
  | Array xs -> V.get xs i
  | _ -> None

-- Follow a chain of object keys: `path ["a", "b"] v` is `v.a.b`.
@pub fun path keys v =
  V.foldl (\acc k -> maybeThen (\x -> get k x) acc) (Just v) keys

fun maybeThen f o =
  match o with
  | None -> None
  | Just x -> f x

fun lookupField key fields =
  if V.isEmpty fields
  then None
  else
    match V.get fields 0 with
    | None -> None
    | Just entry ->
        if fst entry == key
        then Just (snd entry)
        else lookupField key (V.drop fields 1)

-- --- parsing ------------------------------------------------------------------

-- `Ok` of the value, or `Err` of a message naming the byte offset.
@pub fun parse text =
  match P.runParser document (P.fromString text) with
  | Ok v -> Ok v
  | Err e -> Err (P.showError e)

-- These four refer to each other in a cycle, and meadow evaluates top-level
-- definitions eagerly -- so building any of them at load time would read another
-- that had not been built yet. `defer` delays construction until the parser is
-- actually run, which is what breaks the cycle in a strict language. Every
-- definition in the cycle needs it, not just the one that looks recursive.
def document = P.defer (\() -> P.thenSkip (P.skipThen spaces value) P.eof)

def value =
  P.defer (\() ->
    P.choice [
      P.label "null" (P.map (\c -> Null) (P.chunk (P.fromString "null"))),
      P.label "true" (P.map (\c -> Bool True) (P.chunk (P.fromString "true"))),
      P.label "false" (P.map (\c -> Bool False) (P.chunk (P.fromString "false"))),
      P.label "a string" (P.map String stringLit),
      P.label "an array" array,
      P.label "an object" object,
      P.label "a number" number,
    ])

def array =
  P.defer (\() ->
    P.map Array
      (P.between (lexeme (P.single 91)) (lexeme (P.single 93))
        (P.sepBy (lexeme value) (lexeme (P.single 44)))))

def object =
  P.defer (\() ->
    P.map Object
      (P.between (lexeme (P.single 123)) (lexeme (P.single 125))
        (P.sepBy (lexeme member) (lexeme (P.single 44)))))

def member =
  P.defer (\() ->
    P.bind (lexeme stringLit)
      (\k -> P.map (\v -> pair k v) (P.skipThen (lexeme (P.single 58)) value)))

-- --- lexical ------------------------------------------------------------------

def spaces = P.skipMany (P.satisfy isSpace)

fun isSpace b = b == 32 or b == 9 or b == 10 or b == 13

fun lexeme p = P.thenSkip p spaces

-- Numbers: an optional sign, digits, and an optional fraction. JSON also allows
-- an exponent (`1e9`); meadow has no float parser to build one on yet, so an
-- exponent is rejected rather than silently misread.
def number =
  P.bind (P.optional (P.single 45))
    (\sign ->
      P.bind (P.takeWhile1P "a digit" isDigit)
        (\whole ->
          P.bind (P.optional (P.skipThen (P.single 46) (P.takeWhile1P "a digit" isDigit)))
            (\frac -> P.pure (buildNumber sign whole frac))))

fun isDigit b = b >= 48 and b <= 57

fun buildNumber sign whole frac =
  let neg = match sign with | None -> False | Just s -> True in
  match frac with
  | None -> Int (applySign neg (digitsToInt whole))
  | Just f -> Float (applySignF neg (toFloat (digitsToInt whole) +. fraction f))

fun applySign neg n = if neg then 0 - n else n

fun applySignF neg x = if neg then 0.0 -. x else x

fun digitsToInt bytes = V.foldl (\acc b -> acc * 10 + (b - 48)) 0 bytes

-- `.25` as a `Float`, by dividing the digits by the right power of ten.
fun fraction bytes =
  toFloat (digitsToInt bytes) /. powTen (V.len bytes)

fun powTen n = if n <= 0 then 1.0 else 10.0 *. powTen (n - 1)

-- Strings: `\uXXXX` is the second gap. Decoding one means UTF-16 surrogate
-- pairing and UTF-8 re-encoding, which belongs in `Std.String` rather than here,
-- so for now such an escape is rejected instead of half-handled.
def stringLit =
  P.map bytesToText
    (P.between (P.single 34) (P.single 34) (P.many (P.alt escape plainByte)))

def plainByte = P.satisfy (\b -> b != 34 and b != 92)

def escape =
  P.skipThen (P.single 92)
    (P.label "an escape"
      (P.choice [
        P.map (\b -> 34) (P.single 34),
        P.map (\b -> 92) (P.single 92),
        P.map (\b -> 47) (P.single 47),
        P.map (\b -> 8) (P.single 98),
        P.map (\b -> 12) (P.single 102),
        P.map (\b -> 10) (P.single 110),
        P.map (\b -> 13) (P.single 114),
        P.map (\b -> 9) (P.single 116),
      ]))

fun bytesToText bytes = S.fromBytes (V.toArray bytes)

-- --- rendering ----------------------------------------------------------------

-- Compact: no spaces, no newlines. `renderIndented` is below.
@pub fun render v =
  match v with
  | Null -> "null"
  | Bool b -> if b then "true" else "false"
  | Int n -> S.fromInt n
  | Float x -> showFloat x
  | String s -> quote s
  | Array xs -> S.concatAll ["[", S.join "," (V.map render xs), "]"]
  | Object fs -> S.concatAll ["{", S.join "," (V.map renderMember fs), "}"]

fun renderMember entry =
  S.concatAll [quote (fst entry), ":", render (snd entry)]

-- Two spaces per level, one element per line -- the shape `meadow fmt` uses for
-- meadow itself.
@pub fun renderIndented v = renderAt 0 v

fun renderAt depth v =
  match v with
  | Array xs ->
      if V.isEmpty xs
      then "[]"
      else
        S.concatAll [
          "[\n",
          S.join ",\n" (V.map (\x -> S.concat (pad (depth + 1)) (renderAt (depth + 1) x)) xs),
          "\n", pad depth, "]",
        ]
  | Object fs ->
      if V.isEmpty fs
      then "{}"
      else
        S.concatAll [
          "{\n",
          S.join ",\n" (V.map (\f -> memberAt (depth + 1) f) fs),
          "\n", pad depth, "}",
        ]
  | _ -> render v

fun memberAt depth entry =
  S.concatAll [pad depth, quote (fst entry), ": ", renderAt depth (snd entry)]

fun pad depth = S.repeat "  " depth

-- --- escaping -----------------------------------------------------------------

@pub fun quote s = S.concatAll ["\"", escapeAll s, "\""]

fun escapeAll s = S.fromBytes (V.toArray (V.concatMap escapeByte (V.fromArray (S.toBytes s))))

fun escapeByte b =
  if b == 34 then V.fromArray #[92, 34]
  else if b == 92 then V.fromArray #[92, 92]
  else if b == 10 then V.fromArray #[92, 110]
  else if b == 13 then V.fromArray #[92, 114]
  else if b == 9 then V.fromArray #[92, 116]
  else if b == 8 then V.fromArray #[92, 98]
  else if b == 12 then V.fromArray #[92, 102]
  else V.fromArray #[b]

-- Meadow has no float formatter, so this renders the integer part and a fixed
-- six fractional digits -- enough to round-trip the values this module's own
-- parser produces, and honest about being a placeholder.
fun showFloat x =
  let whole = floor x in
  let frac = x -. toFloat whole in
  let scaled = floor ((if frac <. 0.0 then 0.0 -. frac else frac) *. 1000000.0) in
  S.concatAll [S.fromInt whole, ".", padLeft 6 (S.fromInt scaled)]

fun padLeft width s =
  if S.byteLength s >= width then s else padLeft width (S.concat "0" s)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Result (Result)

fun parsed text =
  match parse text with
  | Ok v -> v
  | Err e -> String (S.concat "parse failed: " e)

@test fun theAtomsParse () =
  let a = assertEq (parsed "null") Null "null" in
  let b = assertEq (parsed "true") (Bool True) "true" in
  let c = assertEq (parsed "false") (Bool False) "false" in
  let d = assertEq (parsed "42") (Int 42) "an integer" in
  let e = assertEq (parsed "-7") (Int (0 - 7)) "a negative integer" in
  assertEq (parsed "\"hi\"") (String "hi") "a string"

@test fun numbersSplitIntoIntAndFloat () =
  -- JSON has one number type; meadow has two, and widening every integer to a
  -- float would lose precision no one asked to lose.
  let a = assertEq (parsed "1") (Int 1) "no fraction means Int" in
  assertTrue (isFloat (parsed "1.5")) "a fraction means Float"

fun isFloat v = match v with | Float x -> True | _ -> False

@test fun containersNestAndAreOrdered () =
  let a = assertEq (parsed "[]") (Array []) "an empty array" in
  let b = assertEq (parsed "[1,2]") (Array [Int 1, Int 2]) "an array" in
  let c = assertEq (parsed "{}") (Object []) "an empty object" in
  let d = assertEq (parsed "{\"a\":1}") (Object [("a", Int 1)]) "an object" in
  assertEq (parsed "[[1],[2]]") (Array [Array [Int 1], Array [Int 2]]) "nesting"

@test fun whitespaceIsIgnoredBetweenTokens () =
  assertEq (parsed "  { \"a\" : [ 1 , 2 ] }  ") (parsed "{\"a\":[1,2]}") "spaces do not matter"

-- Two layers of escaping meet here: the meadow literal, and the JSON text it
-- holds. `"\"a\\nb\""` is the six characters `"a\nb"` -- JSON for a newline.
@test fun stringEscapesAreDecoded () =
  let a = assertEq (parsed "\"a\\nb\"") (String "a\nb") "newline" in
  let b = assertEq (parsed "\"a\\tb\"") (String "a\tb") "tab" in
  let c = assertEq (parsed "\"a\\\"b\"") (String "a\"b") "an escaped quote" in
  assertEq (parsed "\"a\\\\b\"") (String "a\\b") "an escaped backslash"

@test fun malformedInputIsRejected () =
  let bad = \text -> match parse text with | Ok v -> False | Err e -> True in
  let a = assertTrue (bad "{oops}") "not JSON at all" in
  let b = assertTrue (bad "[1,") "cut off" in
  let c = assertTrue (bad "") "empty" in
  -- Trailing rubbish is rejected too: `document` ends with `eof`.
  assertTrue (bad "1 2") "two values"

@test fun renderingIsCompactAndRoundTrips () =
  let a = assertEq (render Null) "null" "null" in
  let b = assertEq (render (Bool True)) "true" "true" in
  let c = assertEq (render (Int (0 - 7))) "-7" "a negative" in
  let d = assertEq (render (Array [Int 1, Int 2])) "[1,2]" "an array" in
  let e = assertEq (render (Object [("a", Int 1)])) "{\"a\":1}" "an object" in
  let text = "{\"a\":[1,2,3],\"b\":null,\"c\":\"x\"}" in
  assertEq (render (parsed text)) text "parse then render is the identity"

@test fun renderingEscapesWhatItMust () =
  let a = assertEq (render (String "a\"b")) "\"a\\\"b\"" "a quote" in
  let b = assertEq (render (String "a\nb")) "\"a\\nb\"" "a newline" in
  let awkward = String "tricky \" \\ \n\t" in
  assertEq (parsed (render awkward)) awkward "everything that needs escaping round trips"

@test fun accessorsReachIntoTheTree () =
  let v = parsed "{\"n\":{\"deep\":true},\"xs\":[10,20]}" in
  let a = assertEq (path ["n", "deep"] v) (Just (Bool True)) "path" in
  let b = assertEq (path ["n", "missing"] v) None "a missing key" in
  let c = assertEq (get "n" v) (Just (Object [("deep", Bool True)])) "get" in
  let d = assertEq (index 1 (parsed "[10,20]")) (Just (Int 20)) "index" in
  assertEq (index 9 (parsed "[10]")) None "index past the end"

@test fun theTypedAccessors () =
  let a = assertEq (asInt (Int 1)) (Just 1) "asInt" in
  let b = assertEq (asInt (String "1")) None "asInt of the wrong shape" in
  let c = assertEq (asString (String "x")) (Just "x") "asString" in
  let d = assertEq (asBool (Bool True)) (Just True) "asBool" in
  let e = assertTrue (isNull Null) "isNull" in
  -- `asFloat` widens an integer, since a JSON `1` is a valid float to a caller
  -- that wants one.
  assertEq (asFloat (Int 2)) (Just 2.0) "asFloat widens an Int"

@test fun indentedRenderingNestsByTwo () =
  let a = assertEq (renderIndented (Array [])) "[]" "an empty array stays on one line" in
  let b = assertEq (renderIndented (Object [])) "{}" "and an empty object" in
  let c = assertEq (renderIndented (Array [Int 1])) "[\n  1\n]" "one element" in
  assertEq (renderIndented (Object [("a", Int 1)])) "{\n  \"a\": 1\n}" "one field"
