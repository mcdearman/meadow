-- Std.Console: reading from the terminal, as an effect.
--
-- `print` and `println` go the other way and are plain primitives. Input needs
-- an effect because it is the one thing a test can never be allowed to do for
-- real: a suite that blocks waiting for someone to type is a suite that hangs.
--
-- With no handler the runtime reads real standard input:
--
--   use Std.Console (readLine, prompt)
--
--   def main =
--     match prompt "your name: " with
--     | Just name -> println (S.concat "hello, " name)
--     | None -> println "nothing to read"
--
-- With `withInput` it reads from a list you supply, which is what makes an
-- interactive program testable:
--
--   @test fun greets u =
--     assertEq (withInput ["ada"] (\u -> prompt "name: ")) (Just "ada") "reads"
--
-- `readLine` answers `None` at end of input -- a closed pipe, or Ctrl-D at a
-- terminal. That is not an error, so a loop ends by pattern-matching it rather
-- than by catching anything.

use Std.Maybe (unwrapOr)
use Std.Test (assertEq)
use Std.String as S
use Std.Collections.List as L

@pub effect Console {
  -- The next line, without its line terminator. `None` at end of input.
  readLine : Unit -> Maybe String,
}

-- --- reading ------------------------------------------------------------------

-- Write `message` with no trailing newline, then read a line.
@pub fun prompt message =
  let _ = print message in
  readLine ()

-- The next line, or `fallback` at end of input.
@pub fun readLineOr fallback = unwrapOr fallback (readLine ())

-- The next line with surrounding whitespace removed, which is almost always what
-- you want from a person typing: a stray space before `rock` should not be a
-- different answer.
@pub fun readWord () =
  match readLine () with
  | None -> None
  | Just line -> Just (S.trim line)

-- Keep asking until the answer parses. `parse` returns `Maybe b`; a `None` is
-- reported with `retry` and the question is put again. Ends as `None` only if
-- input runs out, so a piped-in file cannot spin forever.
@pub fun promptUntil message retry parse =
  match prompt message with
  | None -> None
  | Just line ->
      match parse (S.trim line) with
      | Just value -> Just value
      | None ->
          let _ = println retry in
          promptUntil message retry parse

-- Every remaining line, in order.
@pub fun readAll () = L.reverse (readAllLoop [;])

fun readAllLoop acc =
  match readLine () with
  | None -> acc
  | Just line -> readAllLoop (line :: acc)

-- --- handling -----------------------------------------------------------------

-- Run `body` with `lines` as the input, so nothing touches the terminal. Once
-- the list is exhausted every `readLine` answers `None`.
@pub fun withInput lines body =
  let feed =
    handle body () with {
      readLine u k -> \remaining ->
        match remaining with
        | [;] -> (k None) [;]
        | line :: rest -> (k (Just line)) rest,
      return x -> \remaining -> x
    }
  in feed lines

-- --- tests --------------------------------------------------------------------
--
-- All of these go through `withInput`. A test that reached the real terminal
-- would block the suite waiting for someone to type, which is the reason input
-- is an effect at all.

@test fun readsLinesInOrder u =
  let got = withInput ["one"; "two"] (\u -> (readLine (), readLine ())) in
  assertEq got (Just "one", Just "two") "two lines, in order"

@test fun endOfInputIsNoneNotAnError u =
  let got = withInput ["only";] (\u -> (readLine (), readLine (), readLine ())) in
  assertEq got (Just "only", None, None) "None once the input runs out"

@test fun emptyInputReadsNothing u =
  assertEq (withInput [;] (\u -> readLine ())) None "nothing to read"

@test fun readLineOrSubstitutesAtEndOfInput u =
  let got = withInput ["here";] (\u -> (readLineOr "gone", readLineOr "gone")) in
  assertEq got ("here", "gone") "the fallback only applies at the end"

@test fun readWordTrimsSurroundingSpace u =
  -- A person typing `rock ` should not give a different answer from `rock`.
  assertEq (withInput ["  rock  ";] (\u -> readWord ())) (Just "rock") "trimmed"

@test fun readAllCollectsTheRest u =
  let got = withInput ["a"; "b"; "c"] (\u -> (readLine (), readAll ())) in
  assertEq got (Just "a", ["b"; "c"]) "the first line, then the rest"

@test fun promptUntilRetriesUntilItParses u =
  let parse = \s -> match s with | "yes" -> Just True | _ -> None in
  let got = withInput ["no"; "maybe"; "yes"] (\u -> promptUntil "?" "again" parse) in
  assertEq got (Just True) "keeps asking past the answers that do not parse"

@test fun promptUntilGivesUpAtEndOfInput u =
  -- Otherwise a piped-in file that never satisfies `parse` would spin forever.
  let parse = \s -> match s with | "yes" -> Just True | _ -> None in
  let got = withInput ["no"; "no"] (\u -> promptUntil "?" "again" parse) in
  assertEq got None "runs out rather than looping"
