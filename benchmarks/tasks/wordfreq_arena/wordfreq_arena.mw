-- `wordfreq`, with an arena: the same counts, with nothing allocated per word.
--
-- The corpus is read once into one string, and a word is a pair of numbers
-- into it -- where it starts and how long it is -- so no word is ever copied.
-- The table is three mutable arrays of a fixed size rather than a
-- `HashTable`, and probing writes numbers into them. What is left in each
-- language's number is the hashing, the probing and the byte comparisons,
-- with its allocator and its string type taken out.
--
-- Only the ten reported at the stop become strings.

use Std.Console (println)
use Std.Fs as Fs
use Std.String as Str
use Std.St as St
use Std.Collections.Vector as V

-- 16384 slots for a vocabulary of 5000.
def cap : Int = 16384

def fnvPrime : Int = 1099511628211
def fnvBasis : Int = 1469598103934665603

-- The byte at `i`, as a number. `Str.byteAt` answers a `Maybe`, which is the
-- right thing for a string a program did not write; here every index is one
-- this program has already checked.
fun byteOf s (i : Int) = toInt (stringByteAt s i)

fun hashOf text (at : Int) (n : Int) =
  let rec go (i : Int) (h : Int) =
    if i >= n then h
    else go (i + 1) (bitXor h (byteOf text (at + i)) * fnvPrime)
  in go 0 fnvBasis

fun same text (a : Int) (b : Int) (n : Int) =
  let rec go (i : Int) =
    if i >= n then True
    else if byteOf text (a + i) != byteOf text (b + i) then False
    else go (i + 1)
  in go 0

fun bump text starts lens counts (at : Int) (n : Int) =
  let rec go (i : Int) =
    let c = St.get counts i in
    if c == 0 then
      let _ = St.set starts i at in
      let _ = St.set lens i n in
      St.set counts i 1
    else if St.get lens i == n and same text (St.get starts i) at n then
      St.set counts i (c + 1)
    else go (bitAnd (i + 1) (cap - 1))
  in go (bitAnd (hashOf text at n) (cap - 1))

-- Is the word in slot `a` before the one in slot `b`, count first and then the
-- bytes?
fun before text starts lens counts (a : Int) (b : Int) =
  if St.get counts a != St.get counts b then St.get counts a > St.get counts b
  else
    let n = if St.get lens a < St.get lens b then St.get lens a else St.get lens b in
    let rec go (i : Int) =
      if i >= n then St.get lens a < St.get lens b
      else
        let x = byteOf text (St.get starts a + i) in
        let y = byteOf text (St.get starts b + i) in
        if x != y then x < y else go (i + 1)
    in go 0

def main =
  let text = Fs.readToStringOr "" "work/corpus.txt" in
  let size = Str.byteLength text in
  let top = runSt (\() ->
    let starts = St.newArray cap 0 in
    let lens = St.newArray cap 0 in
    let counts = St.newArray cap 0 in
    let rec skip (i : Int) =
      if i < size and (byteOf text i == 32 or byteOf text i == 10) then skip (i + 1) else i in
      let rec stop (i : Int) =
        if i < size and byteOf text i != 32 and byteOf text i != 10 then stop (i + 1) else i in
        let rec words (i : Int) =
          if i >= size then ()
          else
            let from = skip i in
            let to = stop from in
            let _ = if to > from then bump text starts lens counts from (to - from) else () in
            if to >= size then () else words to in
            let _ = words 0 in
            -- The ten commonest, kept in order as the table is walked. A slot's place
            -- is the ten numbers in `best`, and `n` says how many are filled.
            let best = St.newArray 10 0 in
            let n = St.newRef 0 in
            let rec insert (slot : Int) =
              let rec back (at : Int) =
                if at > 0 and before text starts lens counts slot (St.get best (at - 1)) then back (at - 1) else at in
                let at = back (St.getRef n) in
                if at >= 10 then ()
                else
                  let rec shift (j : Int) =
                    if j <= at then () else let _ = St.set best j (St.get best (j - 1)) in shift (j - 1) in
                    let last = if St.getRef n < 10 then St.getRef n else 9 in
                    let _ = shift last in
                    let _ = St.set best at slot in
                    if St.getRef n < 10 then St.setRef n (St.getRef n + 1) else () in
                    let rec walk (i : Int) =
                      if i >= cap then ()
                      else
                        let _ = if St.get counts i != 0 then insert i else () in
                        walk (i + 1) in
                        let _ = walk 0 in
                        let rec collect (i : Int) acc =
                          if i >= St.getRef n then acc
                          else
                            let slot = St.get best i in
                            let w = Str.slice text (St.get starts slot) (St.get starts slot + St.get lens slot) in
                            collect (i + 1) (V.pushBack acc "${w}:${St.get counts slot}") in
                            collect 0 V.empty) in
  println (Str.join " " top)
