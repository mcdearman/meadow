-- Std.Bench: timing small pieces of code, in the manner of Rust's Criterion.
--
-- Criterion's shape carries over well; its statistics mostly do not, and the
-- module says which parts were kept and why.
--
--   use Std.Bench (bench, runAll)
--
--   fun naiveFib n = if n < 2 then n else naiveFib (n - 1) + naiveFib (n - 2)
--
--   def main = runAll
--     [ bench "fib 20" (\() -> naiveFib 20)
--     , bench "fib 25" (\() -> naiveFib 25)
--     ]
--
-- What is taken from Criterion:
--
-- * **an auto-calibrated iteration count** -- the same benchmark should be
--   writable for something that takes a microsecond and something that takes a
--   second, so the harness doubles the count until a sample lasts long enough
--   to be worth timing;
-- * **a warm-up** -- the heap starts small and grows, so the first run of
--   anything that allocates pays for collections the rest do not;
-- * **many samples, not one** -- a single measurement of a shared machine is
--   a rumour;
-- * **throughput** -- reported as calls per second, which is the number worth
--   quoting for a function-call benchmark.
--
-- What is deliberately left out:
--
-- * **bootstrapped confidence intervals.** Criterion resamples to put an
--   interval around the mean. That is the right tool when the thing measured is
--   genuinely stochastic; here the work is deterministic and the noise is the
--   operating system, so the interesting statistics are the *minimum* (the run
--   that was interrupted least) and the spread (how much interference there
--   was). Both are one pass and neither needs a random number generator.
-- * **a saved baseline.** Criterion compares against the last run on disk.
--   Meadow has two runtimes, and the comparison that matters is between them --
--   `meadow run benches` against `meadow run --cek benches` -- which needs no
--   state carried between runs.
-- * **`black_box`.** Nothing here eliminates dead code yet, and the language is
--   strict, so a call whose result is dropped still happens. If that ever stops
--   being true this is the module that has to change first.

use Std.Time (monotonic)
use Std.Collections.Vector (
  vecFromArray, empty, isEmpty, len, getOr, pushBack, map, forEach,
)
use Std.Int as I
use Std.String as S
use Std.Sort (sort)
use Std.Test (assertEq, assertTrue)

@pub(pack) record BenchConfig = {
  -- Run for about this many nanoseconds before measuring anything.
  @pub(pack) warmupNanos : Int,
  -- Aim for one sample to take about this long. Bigger is steadier and slower.
  @pub(pack) sampleNanos : Int,
  -- How many samples to take once the count is settled.
  @pub(pack) samples : Int,
}

@pub(pack) def defaultConfig =
  { warmupNanos = 50000000, sampleNanos = 20000000, samples = 12 }

-- A quicker, noisier configuration, for when you are iterating on the code
-- rather than quoting a number.
@pub(pack) def quickConfig =
  { warmupNanos = 5000000, sampleNanos = 2000000, samples = 5 }

@pub(pack) record Report = {
  @pub(pack) name : String,
  -- Calls per sample, chosen by calibration.
  @pub(pack) iterations : Int,
  @pub(pack) samples : Int,
  -- Nanoseconds per call: the best sample, and the middle one.
  @pub(pack) best : Int,
  @pub(pack) median : Int,
  -- Median absolute deviation, in nanoseconds per call. Large next to `median`
  -- means the machine was busy and the number should not be quoted.
  @pub(pack) spread : Int,
  -- Calls of the benchmark itself, per second.
  @pub(pack) perSecond : Int,
  -- How much work one call does, in whatever unit the benchmark counts --
  -- Criterion's `Throughput`. `naiveFib 20` makes 21891 function calls, so
  -- reporting 88 of *those* per second says nothing useful; reporting 1.9
  -- million calls per second does. 1 means the call is the unit.
  @pub(pack) unitsPerCall : Int,
  @pub(pack) unitsPerSecond : Int,
}

-- --- running ------------------------------------------------------------------

-- Call `act` `n` times, discarding each result.
--
-- Strict evaluation is what makes this a measurement rather than a no-op: the
-- call happens whether or not anyone looks at what it returns.
fun spin n act = if n <= 0 then () else let _ = act () in spin (n - 1) act

-- Nanoseconds for `n` calls, including the loop around them.
fun timeLoop n act =
  let start = monotonic () in
  let _ = spin n act in
  monotonic () - start

-- The loop itself, with nothing in it. Subtracted from every measurement.
--
-- In an interpreter this is not a rounding error: calling an empty closure a
-- million times costs real time, and a benchmark of something small would
-- otherwise be reporting mostly the harness.
fun loopOverhead n = timeLoop n (\() -> ())

-- Double the count until one sample lasts `target` nanoseconds.
fun calibrate n act target =
  if n >= 100000000 then n
  else if timeLoop n act >= target then n
  else calibrate (n * 2) act target

fun warmUp deadline act =
  if monotonic () >= deadline then ()
  else
    let _ = spin 64 act in
    warmUp deadline act

fun collect k n act acc =
  if k <= 0 then acc
  else collect (k - 1) n act (pushBack acc (timeLoop n act))

-- Measure `act` under `config`, counting `units` of work per call.
@pub(pack) fun benchUnitsWith config name units act =
  let _ = warmUp (monotonic () + config.warmupNanos) act in
  let n = calibrate 1 act config.sampleNanos in
  let overhead = loopOverhead n in
  let raw = collect config.samples n act empty in
  let net = map (\total -> I.max 0 (total - overhead)) raw in
  let perCall = sort (map (\total -> total / n) net) in
  let mid = middle perCall in
  { name = name
    , iterations = n
    , samples = config.samples
    , best = getOr 0 perCall 0
    , median = mid
    , spread = middle (sort (map (\x -> I.abs (x - mid)) perCall))
    , perSecond = 1000000000 / I.max 1 mid
    , unitsPerCall = units
    , unitsPerSecond = units * 1000000000 / I.max 1 mid
  }

-- Measure `act` under `config`.
@pub(pack) fun benchWith config name act = benchUnitsWith config name 1 act

-- Measure `act` under `defaultConfig`.
@pub(pack) fun bench name act = benchUnitsWith defaultConfig name 1 act

-- Measure `act` under `defaultConfig`, counting `units` of work per call. The
-- throughput column then reports units rather than calls.
@pub(pack) fun benchUnits name units act = benchUnitsWith defaultConfig name units act

-- --- statistics ---------------------------------------------------------------

-- The middle value of an already-sorted vector, or 0 if it is empty. For an
-- even count this takes the lower of the two middles rather than averaging
-- them, which keeps the result an actual measurement.
@pub(pack) fun middle sorted =
  if isEmpty sorted then 0 else getOr 0 sorted (len sorted / 2)

-- --- reporting ----------------------------------------------------------------

-- A duration, in whichever unit reads best.
@pub(pack) fun formatNanos ns =
  if ns < 1000 then S.concatAll [S.fromInt ns, " ns"]
  else if ns < 1000000 then S.concatAll [scaled ns 1000, " us"]
  else if ns < 1000000000 then S.concatAll [scaled ns 1000000, " ms"]
  else S.concatAll [scaled ns 1000000000, " s"]

-- `n / unit` to two decimal places, without floating point: the whole part and
-- the first two digits of the remainder.
fun scaled n unit =
  let whole = n / unit in
  let rest = (n % unit) * 100 / unit in
  S.concatAll [S.fromInt whole, ".", pad2 rest]

fun pad2 n = if n < 10 then S.concatAll ["0", S.fromInt n] else S.fromInt n

-- A count, with thousands separated by `_` so the magnitude is readable.
@pub(pack) fun formatCount n =
  if n < 1000 then S.fromInt n
  else S.concatAll [formatCount (n / 1000), "_", pad3 (n % 1000)]

fun pad3 n =
  if n < 10 then S.concatAll ["00", S.fromInt n]
  else if n < 100 then S.concatAll ["0", S.fromInt n]
  else S.fromInt n

@pub(pack) fun formatReport r =
  S.concatAll
    [ padTo 22 r.name
      , padTo 12 (formatNanos r.median)
      , padTo 12 (formatNanos r.best)
      , padTo 12 (S.concatAll ["+-", formatNanos r.spread])
      , padTo 16 (S.concatAll [formatCount (throughput r), "/s"])
      , S.concatAll ["x", formatCount r.iterations]
    ]

-- Units per second where the benchmark counts them, calls per second otherwise.
@pub(pack) fun throughput r =
  if r.unitsPerCall > 1 then r.unitsPerSecond else r.perSecond

fun padTo width s =
  let n = S.byteLength s in
  if n >= width then S.concatAll [s, " "] else S.concatAll [s, S.repeat " " (width - n)]

@pub(pack) def header =
  S.concatAll
    [ padTo 22 "benchmark"
      , padTo 12 "median"
      , padTo 12 "best"
      , padTo 12 "spread"
      , padTo 16 "throughput"
      , "iters"
    ]

-- Print a table of already-measured reports.
@pub(pack) fun report reports =
  let _ = println header in
  let _ = println (S.repeat "-" 78) in
  forEach (\r -> println (formatReport r)) reports

-- Measure nothing -- the reports are already made. Present so the common shape
-- reads as one expression:
--
--   def main = runAll [bench "a" f, bench "b" g]
@pub(pack) fun runAll reports = report reports

-- --- tests --------------------------------------------------------------------
--
-- The statistics and the formatting only. Nothing here times anything: a test
-- that measured real elapsed time would be exactly the flaky test this module
-- is meant to help people avoid writing.

@test fun middleOfASortedVector () =
  let _ = assertEq (middle [1, 2, 3]) 2 "odd count" in
  let _ = assertEq (middle [1, 2, 3, 4]) 3 "even count takes a real sample" in
  assertEq (middle empty) 0 "empty is zero, not an error"

@test fun durationsPickTheirUnit () =
  let _ = assertEq (formatNanos 999) "999 ns" "nanoseconds" in
  let _ = assertEq (formatNanos 1500) "1.50 us" "microseconds" in
  let _ = assertEq (formatNanos 2250000) "2.25 ms" "milliseconds" in
  assertEq (formatNanos 3000000000) "3.00 s" "seconds"

@test fun countsAreGrouped () =
  let _ = assertEq (formatCount 42) "42" "small counts are left alone" in
  let _ = assertEq (formatCount 1000) "1_000" "one separator" in
  assertEq (formatCount 12345678) "12_345_678" "several"

@test fun aReportLinesUp () =
  let r =
    { name = "fib"
      , iterations = 64
      , samples = 12
      , best = 900
      , median = 1000
      , spread = 50
      , perSecond = 1000000
      , unitsPerCall = 1
      , unitsPerSecond = 1000000
    } in
    let line = formatReport r in
    let _ = assertTrue (S.contains "fib" line) "names the benchmark" in
    let _ = assertTrue (S.contains "1.00 us" line) "reports the median" in
    assertTrue (S.contains "1_000_000/s" line) "reports throughput"

@test fun throughputCountsWorkNotCalls () =
  -- A call that does 1000 units of work at 1us per call is a million units per
  -- second, not a thousand calls.
  let r =
    { name = "n"
      , iterations = 1
      , samples = 1
      , best = 1000
      , median = 1000
      , spread = 0
      , perSecond = 1000000
      , unitsPerCall = 1000
      , unitsPerSecond = 1000000000
    } in
    let plain =
      { name = "n"
        , iterations = 1
        , samples = 1
        , best = 1000
        , median = 1000
        , spread = 0
        , perSecond = 1000000
        , unitsPerCall = 1
        , unitsPerSecond = 1000000
      } in
      let _ = assertEq (throughput r) 1000000000 "units win when there are units" in
      assertEq (throughput plain) 1000000 "calls otherwise"
