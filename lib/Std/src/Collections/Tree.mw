-- Std.Collections.Tree: an unbalanced binary search tree. Reach these as
-- `Tree.insert` etc.
--
-- `insert` / `member` / `delete` order elements with `<`, so they work on `Int`.
-- `map` / `foldr` / `toList` are element-agnostic.

use Std.Int (max)
use Std.Collections.List as List (append, foldl)

@pub data Tree a = Leaf | Node (Tree a) a (Tree a)

@pub def empty = Leaf

@pub fun null t = match t with | Leaf -> True | Node l x r -> False

@pub fun size t =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + size l + size r

@pub fun depth t =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + max (depth l) (depth r)

@pub fun insert x t =
  match t with
  | Leaf -> Node Leaf x Leaf
  | Node l y r ->
      if x < y then Node (insert x l) y r
      else if y < x then Node l y (insert x r)
      else t

@pub fun member x t =
  match t with
  | Leaf -> False
  | Node l y r ->
      if x < y then member x l
      else if y < x then member x r
      else True

@pub fun minElem t =
  match t with
  | Leaf -> None
  | Node l x r -> if null l then Just x else minElem l

@pub fun maxElem t =
  match t with
  | Leaf -> None
  | Node l x r -> if null r then Just x else maxElem r

fun deleteMin t =
  match t with
  | Leaf -> Leaf
  | Node l x r -> if null l then r else Node (deleteMin l) x r

fun spliceMin l r =
  match minElem r with
  | None -> l
  | Just m -> Node l m (deleteMin r)

fun removeRoot l r =
  match (l, r) with
  | (Leaf, rr) -> rr
  | (ll, Leaf) -> ll
  | (ll, rr) -> spliceMin ll rr

@pub fun delete x t =
  match t with
  | Leaf -> Leaf
  | Node l y r ->
      if x < y then Node (delete x l) y r
      else if y < x then Node l y (delete x r)
      else removeRoot l r

@pub fun toList t =
  match t with
  | Leaf -> Nil
  | Node l x r -> append (toList l) (Cons x (toList r))

@pub fun fromList xs = foldl (\acc x -> insert x acc) empty xs

@pub fun foldr f acc t =
  match t with
  | Leaf -> acc
  | Node l x r -> foldr f (f x (foldr f acc r)) l

@pub fun map f t =
  match t with
  | Leaf -> Leaf
  | Node l x r -> Node (map f l) (f x) (map f r)

-- Yield every element in order, for `Std.Stream`.
@pub fun toStream t = List.toStream (toList t)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe (Maybe)

def sample = fromList [5; 3; 8; 1]

@test fun insertAndMember u =
  let a = assertTrue (member 5 sample) "member of an inserted key" in
  let b = assertFalse (member 9 sample) "member of a missing key" in
  assertFalse (member 1 empty) "nothing is in the empty tree"

@test fun sizeCountsDistinctKeys u =
  let a = assertEq (size sample) 4 "size" in
  let b = assertEq (size empty) 0 "size of empty" in
  -- Re-inserting an existing key is a no-op, not a duplicate.
  assertEq (size (insert 5 sample)) 4 "re-insert"

@test fun toListIsSorted u =
  let a = assertEq (toList sample) [1; 3; 5; 8] "in order regardless of insertion order" in
  assertEq (toList empty) [;] "empty"

@test fun extremes u =
  let a = assertEq (minElem sample) (Just 1) "minElem" in
  let b = assertEq (maxElem sample) (Just 8) "maxElem" in
  assertEq (minElem empty) None "minElem of empty"

@test fun deleteRemovesOnlyItsKey u =
  let t = delete 5 sample in
  let a = assertFalse (member 5 t) "deleted" in
  let b = assertTrue (member 3 t) "the others survive" in
  let c = assertEq (size t) 3 "size drops by one" in
  assertEq (toList (delete 9 sample)) (toList sample) "deleting a missing key changes nothing"

@test fun nullAndDepth u =
  let a = assertTrue (null empty) "null" in
  let b = assertFalse (null sample) "not null" in
  assertEq (depth empty) 0 "depth of empty"
