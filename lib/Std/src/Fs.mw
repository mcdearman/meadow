-- Std.Fs: filesystem access, modelled on Rust's `std::fs`.
--
-- Every operation runs in the `Fs` effect. With no enclosing `handle` the
-- runtime performs real I/O; a `handle` can intercept the operations (handy for
-- tests / sandboxing). Fallible operations return `Result String a`, where `Err`
-- carries the operating system's error message.
--
-- Strings are written verbatim: `writeString (path, "hi")` writes the two bytes
-- `hi`, and `readToString` returns the contents unchanged. (An earlier note here
-- claimed literals carried their quotes. They never did -- `println` was
-- rendering strings as data, quotes and all, which looked the same from the
-- outside.)

@pub(pack) record FileMeta = {
  @pub(pack) isFile : Bool,
  @pub(pack) isDir : Bool,
  @pub(pack) len : Int,
  @pub(pack) readonly : Bool,
}

@pub(pack) effect Fs {
  readToString : String -> Result String String,
  readBytes : String -> Result String (List Int),
  writeString : (String, String) -> Result String (),
  appendString : (String, String) -> Result String (),
  removeFile : String -> Result String (),
  createDir : String -> Result String (),
  createDirAll : String -> Result String (),
  removeDir : String -> Result String (),
  removeDirAll : String -> Result String (),
  rename : (String, String) -> Result String (),
  copy : (String, String) -> Result String Int,
  readDir : String -> Result String (List String),
  metadata : String -> Result String FileMeta,
  exists : String -> Bool,
  isFile : String -> Bool,
  isDir : String -> Bool,
}

-- Convenience wrappers ------------------------------------------------------

use Std.Result (Result, unwrapOr)
use Std.Collections.List (all)

@pub(pack) fun readToStringOr default path = unwrapOr default (readToString path)

@pub(pack) fun tryReadDir path = unwrapOr Nil (readDir path)

@pub(pack) fun existsAll paths = all exists paths
