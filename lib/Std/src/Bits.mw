-- Std.Bits: bit twiddling on `Int` (64-bit, two's complement).
--
-- The primitives `shl` / `shr` / `ushr` / `bitAnd` / `bitOr` / `bitXor` /
-- `bitNot` / `popCount` are always in scope (they are compiler builtins); the
-- operators `<<` and `>>` (and `>>>` for an unsigned right shift) desugar to
-- `shl` / `shr` / `ushr`. This module adds the derived helpers.

-- The mask with the low `n` bits set (`n` in 0..63; `lowMask 8 == 255`).
@pub fun lowMask n = (1 << n) - 1

-- Keep only the low `n` bits of `x`.
@pub fun lowBits n x = bitAnd x (lowMask n)

-- A single-bit mask: `bit n == 1 << n`.
@pub fun bit n = 1 << n

-- Is bit `n` of `x` set?
@pub fun testBit x n = bitAnd (x >> n) 1 == 1

@pub fun setBit x n = bitOr x (bit n)

@pub fun clearBit x n = bitAnd x (bitNot (bit n))

@pub fun flipBit x n = bitXor x (bit n)

-- Extract byte `k` (0 = least significant) of `x` as a value in 0..255.
@pub fun byteOf k x = bitAnd (x >> (8 * k)) 255

-- Assemble four bytes (each 0..255) into an `Int`, `b0` least significant.
@pub fun fromBytes4 b0 b1 b2 b3 =
  bitOr (bitOr b0 (b1 << 8)) (bitOr (b2 << 16) (b3 << 24))

fun bitsClzGo x n =
  if n >= 64 then 64
  else if testBit x (63 - n) then n
  else bitsClzGo x (n + 1)

-- Number of leading zero bits (of the 64-bit word). `countLeadingZeros 1 == 63`;
-- of 0 it is 64.
@pub fun countLeadingZeros x = bitsClzGo x 0

fun bitsCtzGo x n =
  if n >= 64 then 64
  else if testBit x n then n
  else bitsCtzGo x (n + 1)

-- Number of trailing zero bits. `countTrailingZeros 8 == 3`; of 0 it is 64.
@pub fun countTrailingZeros x = bitsCtzGo x 0

-- Rotate the low 64 bits left by `n` (0..63).
@pub fun rotateLeft x n = bitOr (x << n) (ushr x (64 - n))

-- Rotate the low 64 bits right by `n` (0..63).
@pub fun rotateRight x n = bitOr (ushr x n) (x << (64 - n))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

@test fun masksAndSingleBits () =
  let a = assertEq (lowMask 8) 255 "lowMask 8" in
  let b = assertEq (lowMask 0) 0 "lowMask 0" in
  let c = assertEq (bit 0) 1 "bit 0" in
  let d = assertEq (bit 10) 1024 "bit 10" in
  assertEq (lowBits 4 255) 15 "lowBits keeps the low nibble"

@test fun bitAccessors () =
  let a = assertTrue (testBit 5 0) "bit 0 of 5" in
  let b = assertFalse (testBit 5 1) "bit 1 of 5" in
  let c = assertTrue (testBit 5 2) "bit 2 of 5" in
  let d = assertEq (setBit 5 1) 7 "setBit" in
  let e = assertEq (clearBit 7 1) 5 "clearBit" in
  assertEq (flipBit (flipBit 5 3) 3) 5 "flipBit twice is the identity"

@test fun byteExtractionAndAssembly () =
  let a = assertEq (byteOf 0 0x12345678) 0x78 "byte 0" in
  let b = assertEq (byteOf 3 0x12345678) 0x12 "byte 3" in
  assertEq (fromBytes4 0x78 0x56 0x34 0x12) 0x12345678 "fromBytes4"

@test fun countingZeros () =
  let a = assertEq (countLeadingZeros 1) 63 "clz 1" in
  let b = assertEq (countLeadingZeros 0) 64 "clz 0" in
  let c = assertEq (countTrailingZeros 8) 3 "ctz 8" in
  let d = assertEq (countTrailingZeros 0) 64 "ctz 0" in
  assertEq (countTrailingZeros 1) 0 "ctz 1"

@test fun rotationsComeBackAround () =
  let a = assertEq (rotateLeft 1 1) 2 "rotateLeft" in
  let b = assertEq (rotateRight 2 1) 1 "rotateRight" in
  assertEq (rotateRight (rotateLeft 0x1234 9) 9) 0x1234 "a rotation is reversible"
