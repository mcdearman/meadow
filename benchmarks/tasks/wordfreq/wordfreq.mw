-- Strings, a hash map and a sort: count the words of a 3MB file and report the
-- ten commonest, count first and then the word, so ties are broken the same way
-- everywhere.

use Std.Console (println)
use Std.Fs as Fs
use Std.String as Str
use Std.Collections.Vector as V
use Std.Collections.HashTable as HT
use Std.Sort as Sort

-- A mutable table inside a `runSt`, which is what the other languages use: a
-- count is one probe and one write in place.
fun countLine t (line : String) =
  V.foldl
    (\acc w -> if Str.isEmpty w then () else HT.insertWith (\a b -> a + b) w 1 t)
    ()
    (Str.split " " line)

fun rank a b =
  match (a, b) with
  | ((wa, ca), (wb, cb)) -> if ca == cb then Str.compare wa wb else compare cb ca

def main =
  let text = Fs.readToStringOr "" "work/corpus.txt" in
  let counts = runSt (\() ->
    let t = HT.new () in
    let _ = V.foldl (\acc line -> countLine t line) () (Str.lines text) in
    HT.toVec t) in
  let top = V.take (Sort.sortBy rank counts) 10 in
  println (Str.join " " (V.map (\p -> match p with | (w, c) -> "${w}:${c}") top))
