-- Three-way comparison.

use Ordering.*
@derive(Debug, Display)
@pub data Ordering = Less | Equal | Greater

-- `compare` is `Std.Cmp`'s, the method of `Ord`.

@pub fun isLess o = match o with | Less -> True | Equal -> False | Greater -> False

@pub fun isEqual o = match o with | Less -> False | Equal -> True | Greater -> False

@pub fun isGreater o = match o with | Less -> False | Equal -> False | Greater -> True

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)

@test fun predicatesSayWhichItIs () =
  let a = assertTrue (isLess Less) "isLess" in
  let b = assertTrue (isEqual Equal) "isEqual" in
  let c = assertTrue (isGreater Greater) "isGreater" in
  assertFalse (isLess Equal) "isLess of Equal"
