-- Self-updating thunks
@pub data Thunk a = 
  | Thunk ( () -> a )
  | Value a

@pub data Stream a where
  (::) : (a, Thunk (Stream a)) -> Stream a
end

@pub fun sieve(xs : Stream Int) : Stream Int =
  let rec sieve'(xs : Stream Int, table : Map Int [Int]) : Stream Int =
    match xs with
    | [] -> []
    | x :: xs ->
      match table.lookup(x) with
      | None -> x :: sieve'(xs, table.insert(x * x, [x]))
      | Some facts -> sieve'(xs, facts.foldl(reinsert, table.delete(x)))
  and reinsert (table : Map Int [Int], prime : Int) : Map Int [Int] =
    table.insertWith((++), x + prime, [prime])
  in sieve'(xs, Map.empty)

@pub def primes : Stream Int =
  sieve(Stream.from(2))

@pub class Mappable m where
  fun map : (a -> b, m a) -> m b 
  fun (<$>) : (a -> b, m a) -> m b = map
  fun (<$>) = map
end

@pub data List a = Nil | a :: List a

infixr 5 (::)

impl Mappable (List a) where
  fun map(f, xs) =
    match xs with
    | Nil -> Nil
    | x :: xs -> f(x) :: map(f, xs)
end

@pub fun gcd(a, b) =
  if b == 0 then a else gcd(b, a % b)

@pub fun lcm(a, b) = 
  (a * b) / gcd(a, b)

@pub fun fib(n) =
  let rec fib'(a, b, n) =
    if n == 0 then a else fib'(b, a + b, n - 1)
  in fib'(0, 1, n)

-- RRB Vectors
@pub data Vec a =
  | Empty
  | Root {
      size : Int,
      shift : Int,
      tree : Node a,
    }

data Node a =
  | Leaf(Vector a)
  | Internal {
      sizes : Maybe(Vector Int),
      children : Vector (Node a),
    }

def branchingFactor = 32

impl Mappable (Vec a) where
  fun map(f, vec) =
    match vec with
    | Empty -> Empty
    | Root { size, shift, tree } -> Root { size, shift, tree = mapNode(f, tree) }
  and mapNode(f, node) =
    match node with
    | Leaf(vec) -> Leaf(vec.map(f))
    | Internal { sizes, children } ->
      Internal { sizes, children = children.map(mapNode f) }
end

