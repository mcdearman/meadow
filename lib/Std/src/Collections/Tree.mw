-- Std.Collections.Tree: an unbalanced binary search tree. Reach these as
-- `Tree.insert` etc.
--
-- `insert` / `member` / `delete` order elements with `<`, so they work on `Int`.
-- `map` / `foldr` / `toList` are element-agnostic.

use Std.Int (max)
use Std.Collections.List (append, foldl)

@pub data Tree a = Leaf | Node (Tree a) a (Tree a)

@pub def empty = Leaf

@pub fun null t = match t with | Leaf -> True | Node l x r -> False

@pub fun size t =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + size l + size r

@pub fun depth t =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + max (depth l) (depth r)

@pub fun insert x t =
  match t with
  | Leaf -> Node Leaf x Leaf
  | Node l y r ->
      if x < y then Node (insert x l) y r
      else if y < x then Node l y (insert x r)
      else t

@pub fun member x t =
  match t with
  | Leaf -> False
  | Node l y r ->
      if x < y then member x l
      else if y < x then member x r
      else True

@pub fun minElem t =
  match t with
  | Leaf -> None
  | Node l x r -> if null l then Just x else minElem l

@pub fun maxElem t =
  match t with
  | Leaf -> None
  | Node l x r -> if null r then Just x else maxElem r

fun deleteMin t =
  match t with
  | Leaf -> Leaf
  | Node l x r -> if null l then r else Node (deleteMin l) x r

fun spliceMin l r =
  match minElem r with
  | None -> l
  | Just m -> Node l m (deleteMin r)

fun removeRoot l r =
  match (l, r) with
  | (Leaf, rr) -> rr
  | (ll, Leaf) -> ll
  | (ll, rr) -> spliceMin ll rr

@pub fun delete x t =
  match t with
  | Leaf -> Leaf
  | Node l y r ->
      if x < y then Node (delete x l) y r
      else if y < x then Node l y (delete x r)
      else removeRoot l r

@pub fun toList t =
  match t with
  | Leaf -> Nil
  | Node l x r -> append (toList l) (Cons x (toList r))

@pub fun fromList xs = foldl (\acc x -> insert x acc) empty xs

@pub fun foldr f acc t =
  match t with
  | Leaf -> acc
  | Node l x r -> foldr f (f x (foldr f acc r)) l

@pub fun map f t =
  match t with
  | Leaf -> Leaf
  | Node l x r -> Node (map f l) (f x) (map f r)
