-- Std.Collections.Tree: an unbalanced binary search tree. Reach these as
-- `Tree.insert` etc.
--
-- `insert` / `member` / `delete` order elements with `<`, so they work on `Int`.
-- `map` / `foldr` / `toVec` are element-agnostic.

use Std.Num.Int (max)
use Std.Collections.List as List
use Std.Collections.Vector as V
-- `[a, b]` desugars to a `vecFromArray` call.
use Std.Collections.Vector (vecFromArray)
use Std.Yield (yield)

use Tree.*
@derive(Debug, Display)
@pub data Tree a = Leaf | Node (Tree a) a (Tree a)

@pub def empty : Tree a = Leaf

@pub fun null (t : Tree a) : Bool = match t with | Leaf -> True | Node l x r -> False

@pub fun size (t : Tree a) : n =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + size l + size r

@pub fun depth (t : Tree a) : n =
  match t with
  | Leaf -> 0
  | Node l x r -> 1 + max (depth l) (depth r)

@pub fun insert (x : a) (t : Tree a) : Tree a =
  match t with
  | Leaf -> Node Leaf x Leaf
  | Node l y r ->
      if x < y then Node (insert x l) y r
      else if y < x then Node l y (insert x r)
      else t

@pub fun member (x : a) (t : Tree a) : Bool =
  match t with
  | Leaf -> False
  | Node l y r ->
      if x < y then member x l
      else if y < x then member x r
      else True

@pub fun minElem (t : Tree a) : Maybe a =
  match t with
  | Leaf -> None
  | Node Leaf x _ -> Just x
  | Node l _ _ -> minElem l

@pub fun maxElem (t : Tree a) : Maybe a =
  match t with
  | Leaf -> None
  | Node _ x Leaf -> Just x
  | Node _ _ r -> maxElem r

fun deleteMin t =
  match t with
  | Leaf -> Leaf
  | Node Leaf _ r -> r
  | Node l x r -> Node (deleteMin l) x r

fun spliceMin l r =
  match minElem r with
  | None -> l
  | Just m -> Node l m (deleteMin r)

fun removeRoot l r =
  match (l, r) with
  | (Leaf, rr) -> rr
  | (ll, Leaf) -> ll
  | (ll, rr) -> spliceMin ll rr

@pub fun delete (x : a) (t : Tree a) : Tree a =
  match t with
  | Leaf -> Leaf
  | Node l y r ->
      if x < y then Node (delete x l) y r
      else if y < x then Node l y (delete x r)
      else removeRoot l r

-- Every element, in order.
@pub fun toVec (t : Tree a) : [a] = pushInOrder V.empty t

fun pushInOrder acc t =
  match t with
  | Leaf -> acc
  | Node l x r -> pushInOrder (V.pushBack (pushInOrder acc l) x) r

@pub fun fromVec (v : [a]) : Tree a = V.foldl (\acc x -> insert x acc) empty v

-- The same, as a `List`.
@pub fun toList (t : Tree a) : List a = foldr (\x acc -> x :: acc) [;] t

@pub fun fromList (xs : List a) : Tree a = List.foldl (\acc x -> insert x acc) empty xs

@pub fun foldr (f : a -> b -> b ! e) (acc : b) (t : Tree a) : b ! e =
  match t with
  | Leaf -> acc
  | Node l x r -> foldr f (f x (foldr f acc r)) l

@pub fun map (f : a -> b ! e) (t : Tree a) : Tree b ! e =
  match t with
  | Leaf -> Leaf
  | Node l x r -> Node (map f l) (f x) (map f r)

-- Yield every element in order, for `Std.Stream`.
@pub fun toStream (t : Tree a) : () ! { Yield a | e } =
  match t with
  | Leaf -> ()
  | Node l x r ->
      let _ = toStream l in
      let _ = yield x in
      toStream r

-- --- comparing -----------------------------------------------------------------

-- By their elements in order, not by the shape of the tree, which depends on
-- the order they were inserted in.

impl PartialEq (Tree a) where PartialEq a {
  fun (==) x y = toList x == toList y
}

impl Eq (Tree a) where Eq a {
}

impl PartialOrd (Tree a) where PartialOrd a {
  fun partialCmp x y = partialCmp (toList x) (toList y)
}

impl Ord (Tree a) where Ord a {
  fun compare x y = compare (toList x) (toList y)
}

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue, assertFalse)
use Std.Maybe.Maybe.*

def sample = fromVec [5, 3, 8, 1]

@test fun insertAndMember () =
  let a = assertTrue (member 5 sample) "member of an inserted key" in
  let b = assertFalse (member 9 sample) "member of a missing key" in
  assertFalse (member 1 empty) "nothing is in the empty tree"

@test fun sizeCountsDistinctKeys () =
  let a = assertEq (size sample) 4 "size" in
  let b = assertEq (size empty) 0 "size of empty" in
  -- Re-inserting an existing key is a no-op, not a duplicate.
  assertEq (size (insert 5 sample)) 4 "re-insert"

@test fun toVecIsSorted () =
  let a = assertEq (toVec sample) [1, 3, 5, 8] "in order regardless of insertion order" in
  let b = assertEq (toVec empty) [] "empty" in
  let c = assertEq (toList sample) [1; 3; 5; 8] "toList agrees" in
  assertEq (toVec (fromList [2; 1])) [1, 2] "fromList"

@test fun extremes () =
  let a = assertEq (minElem sample) (Just 1) "minElem" in
  let b = assertEq (maxElem sample) (Just 8) "maxElem" in
  assertEq (minElem empty) None "minElem of empty"

@test fun deleteRemovesOnlyItsKey () =
  let t = delete 5 sample in
  let a = assertFalse (member 5 t) "deleted" in
  let b = assertTrue (member 3 t) "the others survive" in
  let c = assertEq (size t) 3 "size drops by one" in
  assertEq (toVec (delete 9 sample)) (toVec sample) "deleting a missing key changes nothing"

@test fun nullAndDepth () =
  let a = assertTrue (null empty) "null" in
  let b = assertFalse (null sample) "not null" in
  assertEq (depth empty) 0 "depth of empty"
