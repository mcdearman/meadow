---
source: meadow/tests/effects.rs
expression: "schemes(\"effect State s { get : () -> s, put : s -> () }\\n\\\n         fun tick u = let n = get () in let x = put (n + 1) in n\\n\")"
---
get : forall a e. () -> a ! { State a | e }
put : forall a e. a -> () ! { State a | e }
tick : forall a e. a -> Int ! { State Int | e }
