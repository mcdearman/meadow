-- Lower: a module's grouped tree (`Fixity`) as its abstract syntax (`Ast`).
--
-- Read as `Parse` reads a tree for the parse test -- the same forms, the same
-- spans, each rule of it here again -- but written into `Ast`'s tables rather
-- than out as text, and from the fixity pass's tree, whose chains of operators
-- are grouped: `a + b * c` is `(+) a ((*) b c)`, each call spanning what it
-- applies the operator to, and `x :: xs` the constructor `Cons`, as
-- `meadow-rename` makes them.

use MeadowBoot.Ast
use MeadowBoot.Fixity
use MeadowBoot.Fixity.Grouped.*
use MeadowBoot.Fixity.Assoc.*
use MeadowBoot.Lex (lex, Lexed, Token)
use MeadowBoot.Lex.Token.*
use Lingua.Red as R
use Lingua.Red (Syntax)
use Lingua.Red.Syntax.*
use Lingua.Green as G
use Lingua.Green (Green)
use Lingua.Lang (Meta, spanMeta, metaStart, metaEnd)
use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.St (St, runSt)
use Std.Json as J
use Std.Json (Json)
use MeadowBoot.Syntax (parseSurfaceTokens)
use MeadowBoot.Rules as Ru
use MeadowBoot.Rules (Macro, Tok)
use MeadowBoot.Hygiene as Hy

-- `input`'s grouped tree, a module of package `pkg`, as abstract syntax:
-- each call of one of its `macro`s expanded here, and each other macro call
-- the expansion `exps` has for it, by position and where it starts
-- (`expr@120`), and each `@derive` what it wrote -- an operator chain in one
-- grouped by the unit's fixities `fx`.
@pub fun lowered (pkg : String) (input : String) (tree : Green Grouped)
    (exps : HashMap String Json) (fx : HashMap String Fixity) : AstProgram =
  runSt (\() ->
    let count = stNewRef 0 in
    counting count (\() ->
      let b = newAstBuilder () in
      let bare =
        Lc
          {
            tokens = H.fromVec (V.map (\(l : Lexed) -> (l.from, l.token)) (lex input).tokens),
            exps = exps,
            fx = fx,
            macros = H.empty
          }
      in
      let top = R.root tree in
      let c = { bare | macros = macrosOf bare pkg top } in
      let decls = V.concatMap (decl c b) (childrenOf NodeDecl top) in
      let root = newAstModule b (spanOf top) decls in
      AstProgram (freezeAst b) root))

-- Each token as the lexer read it, by where it is in the tree's text: what a
-- literal is worth; what the module's other macro calls expanded to; the
-- unit's fixities; and the module's `macro`s, by name.
record Lc = {
  tokens : HashMap Int Token,
  exps : HashMap String Json,
  fx : HashMap String Fixity,
  macros : HashMap String Macro
}

-- Each call of a `macro` expanded is numbered, in the order the Rust expander
-- meets them -- a call, then what it wrote, then the next -- which is what
-- the names its template writes are marked with.
effect Expanding {
  nextExpansion : () -> Int,
}

fun counting (count : StRef s Int) (act : () -> a ! { Expanding, St s | e })
    : a ! { St s | e } =
  handle act () with {
    nextExpansion u k -> (let n = stGetRef count + 1 in let v = stSetRef count n in k n),
    return x -> x
  }

-- What the call in position `kind` starting at `m` expanded to, if it did.
fun expansion (c : Lc) (kind : String) (m : Meta) : Maybe Json =
  H.lookup "${kind}@${show (metaStart m)}" c.exps

-- --- the tree ----------------------------------------------------------------

type GTree = Syntax Grouped

fun kids (s : GTree) : [GTree] = V.filter (\x -> R.kindOf x != Unknown) (R.children s)

fun nodeKids (s : GTree) : [GTree] = V.filter (\x -> not (R.isTokenOf x)) (kids s)

fun tokenKids (s : GTree) : [GTree] = V.filter R.isTokenOf (kids s)

fun childOf (k : Grouped) (s : GTree) : Maybe GTree = V.find (\x -> R.kindOf x == k) (kids s)

fun childrenOf (k : Grouped) (s : GTree) : [GTree] = V.filter (\x -> R.kindOf x == k) (kids s)

fun has (k : Grouped) (s : GTree) : Bool = M.isSome (childOf k s)

fun firstNode (s : GTree) : Maybe GTree = V.get (nodeKids s) 0

fun must (k : Grouped) (s : GTree) : GTree = M.unwrapOr s (childOf k s)

fun tokenIs (k : Grouped) (s : GTree) : Bool = V.any (\t -> R.kindOf t == k) (tokenKids s)

-- The bytes `s` spans: its first token's start to its last's end -- where
-- they stand, for a tree a macro wrote (`Lingua.Green`).
fun spanOf (s : GTree) : Meta =
  match s with
  | Syntax g i ->
      let toks =
        V.filter (\j -> G.isTokenAt g j and G.kindAt g j != Unknown) (V.range i (G.after g i))
      in
      (match (V.get toks 0, V.get toks (V.len toks - 1)) with
       | (Just f, Just l) -> spanMeta (G.fromAt g f) (G.toAt g l)
       | _ -> spanMeta (G.fromAt g i) (G.fromAt g i))

fun join (a : Meta) (z : Meta) : Meta =
  spanMeta (min (metaStart a) (metaStart z)) (max (metaEnd a) (metaEnd z))

fun from (a : Meta) (z : Meta) : Meta = spanMeta (metaStart a) (metaEnd z)

fun tokenOf (c : Lc) (t : GTree) : Maybe Token = H.lookup (fst (R.textRange t)) c.tokens

-- A name as it is written: its text and its bytes.
record Nm = { text : String, at : Meta }

fun nameOf (t : GTree) : Nm = Nm { text = R.text t, at = spanOf t }

fun named (text : String) (at : Meta) : Nm = Nm { text = text, at = at }

fun firstName (s : GTree) : Nm =
  match s with
  | Syntax g i ->
      (match V.find (\j -> G.isTokenAt g j and G.kindAt g j != Unknown) (V.range i (G.after g i)) with
       | Just j -> named (G.textAt g j) (spanMeta (G.fromAt g j) (G.toAt g j))
       | None -> named "" (spanOf s))

fun lastName (s : GTree) : Nm =
  match V.get (tokenKids s) (V.len (tokenKids s) - 1) with
  | Just t -> nameOf t
  | None -> firstName s

-- A name, written.
fun nm b (n : Nm) = newAstName b n.at n.text

-- --- declarations ------------------------------------------------------------

-- A declaration's nodes: more than one for a signature with clauses, or a
-- synonym -- each under the attributes written on it, a signature keeping
-- only `@cfg`.
fun decl (c : Lc) b (s : GTree) =
  let item = M.andThen firstNode (childOf NodeItem s) in
  let isCall = M.map R.kindOf item == Just NodeMacCall in
  -- A macro call: what it expanded to, in its place -- a call of one of the
  -- module's `macro`s expanded here, and left a call if it cannot be.
  match (if isCall then M.andThen (\i -> M.map (\m -> (i, m)) (rulesOf c i)) item else None) with
  | Just (i, m) -> M.unwrapOr (written c b s) (expandedDecls c b m i)
  | None ->
      (match (if isCall then expansion c "decls" (spanOf s) else None) with
       | Just made -> V.map (jDecl c b) (jarr made)
       | None ->
           V.append
             (written c b s)
             (V.map (jDecl c b) (M.unwrapOr [] (M.map jarr (expansion c "derived" (spanOf s))))))

-- A declaration as it was written, each of its nodes under its attributes.
fun written (c : Lc) b (s : GTree) =
  let attrs = childrenOf NodeAttr s in
  let bare =
    (match firstNode (must NodeItem s) with
     | Just item -> item_ c b item
     | None -> [])
  in
  if V.isEmpty attrs then V.map snd bare
  else
    V.map
      (\x ->
        let kept =
          (if fst x
            then V.filter (\a -> (firstName (must NodeAttrName a)).text == "cfg") attrs
            else attrs)
        in
        if V.isEmpty kept then snd x
        else newAstDeclAttributed b (spanOf s) (V.map (attr c b) kept) (snd x))
      bare

-- A bare declaration's nodes, each with whether it is a signature.
fun item_ (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match s with
  | GroupedFixity assoc prec ops ->
      [( False, newAstDeclFixity b m (V.map (\f -> nm b (firstName (must NodeOpName f))) ops)
      )]
  | GroupedModDecl name -> [(False, newAstDeclMod b m (nm b (firstName name)))]
  | GroupedUseDecl path glob alias names ->
      [(False, useDecl b m path glob alias names)]
  | GroupedDataDecl name params variants ->
      [(
        False,
        newAstDeclData
          b
          m
          (nm b (nameOf name))
          (V.map (\p -> nm b (nameOf p)) params)
          (V.map (variant c b) variants)
      )]
  | GroupedRecordDecl name params fields ->
      [(
        False,
        newAstDeclRecord
          b
          m
          (nm b (nameOf name))
          (V.map (\p -> nm b (nameOf p)) params)
          (V.map (field c b) (childrenOf NodeFieldTy fields))
      )]
  | GroupedEffectDecl name params body ->
      (match childOf NodeEffectAlias body with
       | Just alias ->
           [(
             False,
             newAstDeclEffectAlias
               b
               m
               (nm b (nameOf name))
               (V.map (\p -> nm b (nameOf p)) params)
               (row c b (must NodeEffRow alias))
           )]
       | None ->
           [(False, newAstDeclEffect b m (nm b (nameOf name)) (V.map (\p -> nm b (nameOf p)) params) (V.map (field c b) (childrenOf NodeFieldTy (must NodeRecTy body))))])
  | GroupedTypeDecl name params t ->
      [(
        False,
        newAstDeclAlias b m (nm b (nameOf name)) (V.map (\p -> nm b (nameOf p)) params) (ty c b t)
      )]
  | GroupedTraitDecl name params supers items ->
      [(False, traitDecl c b m name params supers items)]
  | GroupedImplDecl tr tys context items ->
      [(False, implDecl c b m tr tys context items)]
  | GroupedMacroDecl name rules ->
      [(False, newAstDeclMacro b m (nm b (nameOf name)))]
  | GroupedMacCall _ _ _ -> [(False, newAstDeclMacCall b m (macCall b s))]
  | GroupedFunItem name _ annot body clauses ->
      (match body with
       | Just _ -> [(False, newAstDeclBind b m (bindOf c b s))]
       | None -> sigDecl c b s True (vid name) (M.unwrapOr s annot) clauses)
  | GroupedDefItem p annot body clauses ->
      (match body with
       | Just _ -> [(False, newAstDeclBind b m (bindOf c b s))]
       | None -> sigDecl c b s False (patName p) (M.unwrapOr s annot) clauses)
  | GroupedPatternDecl name form -> patternDecl c b s (nameOf name) form
  | _ -> []

fun attr (c : Lc) b (s : GTree) =
  let metas =
    (match childOf NodeAttrArgs s with
     | Just a -> childrenOf NodeMeta a
     | None -> [])
  in
  let words =
    V.concatMap
      (\m -> if has NodeMetaRest m or has TokenStr m then [] else [nm b (firstName m)])
      metas
  in
  newAstAttr
    b
    (spanOf s)
    (nm b (firstName (must NodeAttrName s)))
    words
    (V.concatMap (metaItem c b) metas)

fun metaItem (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match s with
  | GroupedMeta (Just text) _ _ ->
      [newAstAttrMetaText b m (nm b (stringName c text))]
  | GroupedMeta _ (Just n) None -> [newAstAttrMetaWord b m (nm b (firstName n))]
  | GroupedMeta _ (Just n) (Just rest) ->
      (match rest with
       | GroupedMetaRest (Just v) _ ->
           [newAstAttrMetaValue
             b
             m
             (nm b (firstName n))
             (nm b (named (stringName c (must TokenStr v)).text (spanOf v)))]
       | GroupedMetaRest _ (Just args) ->
           [newAstAttrMetaList
             b
             m
             (nm b (firstName n))
             (V.concatMap (metaItem c b) (childrenOf NodeMeta args))]
       | _ -> [])
  | _ -> []

-- A string literal's text as a name: what it says, where it was written.
fun stringName (c : Lc) (t : GTree) : Nm =
  match tokenOf c t with
  | Just (Str s) -> named s (spanOf t)
  | _ -> nameOf t

fun useDecl b (m : Meta) (path : GTree) (glob : Maybe GTree)
    (alias : Maybe GTree) (names : Maybe GTree) =
  let items = (match names with | Just ns -> childrenOf NodeUseItem ns | None -> [])
  in
  let bang = \i -> tokenIs TokenBang i or tokenIs TokenDeclBang i in
  newAstDeclUse b m
    (V.map (\x -> nm b (firstName x)) (childrenOf NodeSeg path))
    (V.map (\i -> nm b (useName i)) (V.filter (\i -> not (bang i)) items))
    (V.map (\i -> nm b (useName i)) (V.filter bang items))
    (M.isSome glob)
    (M.map (\a -> nm b (lastName a)) alias)

fun useName (i : GTree) : Nm =
  let n = must NodeUseName i in
  match firstNode n with
  | Just x ->
      (if R.kindOf x == NodeParenOp then firstName (must NodeOpName x) else firstName x)
  | None -> firstName n

-- A variant's fields: named, when the first thing after its name is a brace
-- list of at least one field and no `| r`, and otherwise its types in order.
fun variant (c : Lc) b (s : GTree) =
  let atoms = childrenOf NodeTAtom s in
  let fieldList =
    (match V.get atoms 0 with
     | Just a ->
         (match childOf NodeRecTy a with
          | Just r ->
              (if V.len (childrenOf NodeFieldTy r) > 0
                and not (has NodeRowTail r)
                then Just r
                else None)
          | None -> None)
     | None -> None)
  in
  let attrs = V.map (attr c b) (childrenOf NodeAttr s) in
  let name = nm b (nameOf (must TokenUpperIdent s)) in
  match fieldList with
  | Just r ->
      newAstVariant b (spanOf s) attrs name True [] (V.map (field c b) (childrenOf NodeFieldTy r))
  | None ->
      newAstVariant b (spanOf s) attrs name False (V.map (tatom c b) atoms) []

fun field (c : Lc) b (s : GTree) =
  newAstField
    b
    (spanOf s)
    (V.map (attr c b) (childrenOf NodeAttr s))
    (nm b (nameOf (must TokenLowerIdent s)))
    (ty c b (must NodeType s))

fun traitDecl (c : Lc) b (m : Meta) (name : GTree) (params : [GTree])
    (supers : Maybe GTree) (items : [GTree]) =
  let members = V.concatMap (\x -> match firstNode x with | Just y -> [y] | None -> []) items
  in
  let assocs = V.filter (\x -> R.kindOf x == NodeAssocDecl) members in
  let rest = V.filter (\x -> R.kindOf x != NodeAssocDecl) members in
  let sigs = V.filter (\x -> not (has NodeBody x)) rest in
  -- The defaults: each binding written as one, and each signature's clauses,
  -- in the order they were written.
  let defaults =
    V.concatMap
      (\x ->
        if has NodeBody x then [bindOf c b x]
        else
          (match definedBy c b (R.kindOf x == NodeFunItem) (sigName x) (childrenOf NodeClause x) (spanOf x) with | Just d -> [d] | None -> []))
      rest in
    newAstDeclTrait b m
    (nm b (nameOf name))
    (V.map (\p -> nm b (nameOf p)) params)
    (V.map (bound c b) (match supers with | Just sp -> childrenOf NodeBound sp | None -> []))
    (V.map
      (\a ->
        newAstAssoc
          b
          (spanOf a)
          (nm b (nameOf (must TokenUpperIdent a)))
          (V.concatMap
            (\t -> match childOf TokenLowerIdent t with
                   | Just x -> [nm b (nameOf x)]
                   | None -> [])
            (childrenOf NodeTAtom a)))
      assocs)
    (V.map
      (\x ->
        newAstMethodSig b (spanOf x) (nm b (sigName x)) (ty c b (must NodeType (must NodeAnnot x))))
      sigs)
    defaults

-- The name a signature is for.
fun sigName (s : GTree) : Nm =
  if R.kindOf s == NodeFunItem
  then vid (must NodeVid s)
  else patName (must NodePat s)

fun implDecl (c : Lc) b (m : Meta) (tr : GTree) (tys : [GTree])
    (context : Maybe GTree) (items : [GTree]) =
  let members = V.concatMap (\x -> match firstNode x with | Just y -> [y] | None -> []) items
  in
  let assocs = V.filter (\x -> R.kindOf x == NodeAssocDecl) members in
  newAstDeclImpl b m
    (nm b (nameOf tr))
    (V.map (tatom c b) tys)
    (V.map (bound c b) (match context with | Just w -> childrenOf NodeBound w | None -> []))
    (V.map
      (\a ->
        newAstAssocDef
          b
          (spanOf a)
          (nm b (nameOf (must TokenUpperIdent a)))
          (V.map (tatom c b) (childrenOf NodeTAtom a))
          (ty c b (must NodeType (must NodeAssocValue a))))
      assocs)
    (V.map (bindOf c b) (V.filter (\x -> R.kindOf x != NodeAssocDecl) members))

fun bound (c : Lc) b (s : GTree) =
  newAstBound
    b
    (spanOf s)
    (nm b (nameOf (must TokenUpperIdent s)))
    (V.map (tatom c b) (childrenOf NodeHeadTy s))

fun isGroup (s : GTree) : Bool =
  R.kindOf s == NodeParenGroup or R.kindOf s == NodeBrackGroup or R.kindOf s == NodeBraceGroup

-- A macro call, by its path; where its argument is, its span says.
fun macCall b (s : GTree) =
  let pathNode =
    M.unwrapOr
      s
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids s))
  in
  let path =
    V.map
      (\x -> nm b (firstName x))
      (V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode))
  in
  newAstMacCall b (macSpan s) path

-- Where a macro call is: its path to its argument's close.
fun macSpan (s : GTree) : Meta =
  match V.find isGroup (nodeKids s) with
  | Just g -> from (spanOf s) (spanOf g)
  | None -> spanOf s

-- --- bindings ----------------------------------------------------------------

-- `fun f : C a => T` and its clauses: the signature, spanning up to its type,
-- and the binding its clauses make, spanning all of it.
fun sigDecl (c : Lc) b (s : GTree) (isFun : Bool) (n : Nm) (annot : GTree)
    (clauses : [GTree]) =
  let first = must NodeType annot in
  let implied = childOf NodeImplies annot in
  let t = (match implied with | Just i -> must NodeType i | None -> first) in
  let bounds = (match implied with | Just _ -> boundsOf first | None -> []) in
  let sig =
    (
      True,
      newAstDeclSig
        b
        (from (spanOf s) (spanOf t))
        (nm b n)
        (ty c b t)
        (V.map (\x -> sigBound c b (fst x) (snd x)) bounds)
    )
  in
  match definedBy c b isFun n clauses (spanOf s) with
  | Just d -> [sig, (False, newAstDeclBind b (spanOf s) d)]
  | None -> [sig]

fun sigBound (c : Lc) b (n : Nm) (ts : [GTree]) = newAstBound b n.at (nm b n) (V.map (tatom c b) ts)

-- What a type written before `=>` says: the bounds it is.
fun boundsOf (t : GTree) : [(Nm, [GTree])] =
  match (childOf NodeArrow t, firstNode (must NodeTHead t)) with
  | (None, Just h) ->
      if R.kindOf h == NodeTCon then [(firstName h, childrenOf NodeTAtom h)]
      else if R.kindOf h == NodeTParen
      then V.concatMap boundsOf (childrenOf NodeType h)
      else []
  | _ -> []

-- The name a `def` signature's pattern is.
fun patName (p : GTree) : Nm =
  match M.andThen (childOf NodeArg) (childOf NodePAtom p) with
  | Just a ->
      (match childOf NodeVid a with | Just v -> vid v | None -> firstName p)
  | None -> firstName p

fun vid (s : GTree) : Nm =
  match childOf NodeOpName s with
  | Just op -> firstName op
  | None -> firstName s

-- A `fun` or `def` with a body, as a binding.
fun bindOf (c : Lc) b (s : GTree) =
  let body = must NodeExpr (must NodeBody s) in
  let ret = M.map (resultTy c b) (childOf NodeAnnot s) in
  if R.kindOf s == NodeFunItem then
    let n = vid (must NodeVid s) in
    let params = childrenOf NodeParam s in
    let clauses = childrenOf NodeClause s in
    if V.isEmpty params and V.isEmpty clauses
    then newAstBindFun b (spanOf s) (nm b n) [] ret (expr c b body)
    else equations c b n params ret body clauses (spanOf s)
  else
    let p = must NodePat s in
    let value = expr c b body in
    match ret with
    | Just t ->
        newAstBindPat b (spanOf s) (newAstPatAnn b (spanOf p) (pat c b p) t) value
    | None -> newAstBindPat b (spanOf s) (pat c b p) value

-- A binding's `: T`, and its effects: `: T ! e` is a function of nothing
-- performing `e`, spanning from the colon.
fun resultTy (c : Lc) b (annot : GTree) =
  let t = must NodeType annot in
  match childOf NodeEffAnnot annot with
  | Just e ->
      newAstTypeFun b (spanOf annot) [] (ty c b t) (Just (row c b (must NodeEffRow e)))
  | None -> ty c b t

-- Several equations as one: a `match` on the arguments, `_arg0` …, each
-- named where the function is, an arm an equation, its patterns spanning its
-- body.
fun equations (c : Lc) b (n : Nm) (params : [GTree]) ret (body : GTree)
    (clauses : [GTree]) (m : Meta) =
  if V.isEmpty clauses or V.isEmpty params
  then bindOfName c b n (V.map (param c b) params) ret (expr c b body) m
  else
    let count = V.len params in
    let vars =
      V.map (\i -> newAstExprVar b n.at (nm b (named "_arg${show i}" n.at))) (V.range 0 count)
    in
    let scrutinee = (if count == 1 then V.getOr 0 vars 0 else newAstExprTuple b n.at vars)
    in
    let arm =
      \ps e ->
        newAstArm
          b
          (exprSpan c e)
          (patTuple b (V.map (param c b) ps) (exprSpan c e))
          None
          (expr c b e)
    in
    let arms =
      V.pushFront
        (V.map (\cl -> arm (childrenOf NodeParam cl) (must NodeExpr cl)) clauses)
        (arm params body)
    in
    let pvars =
      V.map (\i -> newAstPatVar b n.at (nm b (named "_arg${show i}" n.at))) (V.range 0 count)
    in
    newAstBindFun b m (nm b n) pvars ret (newAstExprMatch b m scrutinee arms)

fun patTuple b (pats : [Int]) (m : Meta) =
  if V.len pats == 1 then V.getOr 0 pats 0 else newAstPatTuple b m pats

-- `f x = e` with arguments is a function; with none, the name bound, its
-- type annotated where the name is.
fun bindOfName (c : Lc) b (n : Nm) (params : [Int]) ret body (m : Meta) =
  if not (V.isEmpty params) then newAstBindFun b m (nm b n) params ret body
  else
    let var = newAstPatVar b n.at (nm b n) in
    match ret with
    | Just t -> newAstBindPat b m (newAstPatAnn b n.at var t) body
    | None -> newAstBindPat b m var body

-- The binding a signature's clauses make, if it has any.
fun definedBy (c : Lc) b (isFun : Bool) (n : Nm) (clauses : [GTree])
    (m : Meta) =
  match V.get clauses 0 with
  | None -> None
  | Just head ->
      let params = childrenOf NodeParam head in
      let body = must NodeExpr head in
      let rest = V.drop clauses 1 in
      if isFun and V.isEmpty params and V.isEmpty rest
      then Just (newAstBindFun b m (nm b n) [] None (expr c b body))
      else Just (equations c b n params None body rest m)

-- --- pattern synonyms --------------------------------------------------------

fun patternDecl (c : Lc) b (s : GTree) (n : Nm) (form : Maybe GTree) =
  let whole = spanOf s in
  match form with
  | Just syn ->
      (if R.kindOf syn == NodeSynonym
        then synonym c b n syn (spanMeta (metaStart n.at) (metaEnd whole))
        else
          let names =
            V.pushFront
              (V.map (\x -> nameOf (must TokenUpperIdent x)) (childrenOf NodeCompleteName syn))
              n
          in
          [complete b names (spanMeta (metaStart n.at) (metaEnd (V.getOr n names (V.len names - 1)).at))])
  | None -> [complete b [n] n.at]

-- A synonym's matcher -- `$m2P`, answering what its pattern binds in a list
-- -- and, where it can be built, its builder `$bP`.
fun synonym (c : Lc) b (n : Nm) (s : GTree) (m : Meta) =
  let ps = V.map vid (childrenOf NodeVid s) in
  let both = tokenIs TokenEq s in
  let rhs = must NodePat s in
  let at = \t -> named t n.at in
  let vars = \u -> V.map (\(p : Nm) -> newAstExprVar b p.at (nm b p)) ps in
  let noArgs = \t -> newAstExprCons b m (nm b (at t)) [] in
  let yes =
    (match V.len ps with
     | 0 -> noArgs "True"
     | 1 -> newAstExprList b m (vars ())
     | _ -> newAstExprList b m [newAstExprTuple b m (vars ())]) in
    let no =
      (if V.len ps == 0 then noArgs "False" else newAstExprList b m [])
    in
  let arms = [ newAstArm b m (pat c b rhs) None yes, newAstArm b m (newAstPatWild b m) None no ]
  in
  let scrutinee = at "$scrutinee" in
  let matcher =
    newAstDeclBind b m
    (newAstBindFun
      b
      m
      (nm b (at "$m${show (V.len ps)}${n.text}"))
      [newAstPatVar b n.at (nm b scrutinee)]
      None
      (newAstExprMatch b m (newAstExprVar b m (nm b scrutinee)) arms)) in
    let builder =
      (match childOf NodeSynBuilder s with
       | Just bl ->
           Just ( V.map (param c b) (childrenOf NodeParam bl), expr c b (must NodeExpr bl) )
       | None ->
           if both and builds rhs
           then Just ( V.map (\(p : Nm) -> newAstPatVar b p.at (nm b p)) ps, patExpr c b rhs )
           else None) in
      match builder with
      | Just (params, body) ->
          [
            (False, matcher),
            (
              False,
              newAstDeclBind b m (newAstBindFun b m (nm b (at "$b${n.text}")) params None body)
            )
          ]
      | None -> [(False, matcher)]

-- `pattern A | B`: the matchers that together match every value.
fun complete b (names : [Nm]) (m : Meta) =
  let ms = V.map (\(x : Nm) -> newAstExprVar b x.at (nm b (named "$m?${x.text}" x.at))) names
  in
  let value =
    (if V.len ms == 1 then V.getOr 0 ms 0 else newAstExprTuple b m ms)
  in
  let label = named "$complete:${S.join "|" (V.map (\(x : Nm) -> x.text) names)}" m
  in
  ( False, newAstDeclBind b m (newAstBindPat b m (newAstPatVar b m (nm b label)) value)
  )

-- --- types -------------------------------------------------------------------

fun ty (c : Lc) b (s : GTree) =
  let head = must NodeTHead s in
  match childOf NodeArrow s with
  | None -> thead c b head
  | Just a ->
      newAstTypeFun
        b
        (spanOf s)
        [thead c b head]
        (ty c b (must NodeType a))
        (M.map (\e -> row c b (must NodeEffRow e)) (childOf NodeEffAnnot a))

fun thead (c : Lc) b (s : GTree) =
  match childOf NodeTCon s with
  | Just con ->
      newAstTypeCon
        b
        (spanOf con)
        (nm b (firstName con))
        (V.map (tatom c b) (childrenOf NodeTAtom con))
  | None -> tatom c b s

-- A type atom: a `TAtom`, a `THead` but for a constructor with arguments, or
-- a `HeadTy`.
fun tatom (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeTParen then tparen c b n
      else if k == NodeTArray
      then newAstTypeCon b (spanOf n) (nm b (named "Array" (spanOf n))) [ty c b (must NodeType n)]
      else if k == NodeTBrack
      then
        (if tokenIs TokenSemiColon n
          then newAstTypeList b (spanOf n) (ty c b (must NodeType n))
          else newAstTypeVector b (spanOf n) (ty c b (must NodeType n)))
      else if k == NodeRecTy then recTy c b n
      else newAstTypeVar b m (nm b (firstName s))
  | None ->
      (match V.get (tokenKids s) 0 with
       | Just t ->
           if R.kindOf t == TokenUpperIdent or R.kindOf t == TokenMacUpper
           then newAstTypeCon b m (nm b (nameOf t)) []
           else newAstTypeVar b m (nm b (nameOf t))
       | None -> newAstTypeTuple b m [])

fun tparen (c : Lc) b (s : GTree) =
  let ts = childrenOf NodeType s in
  match V.len ts with
  | 0 -> newAstTypeCon b (spanOf s) (nm b (named "Unit" (spanOf s))) []
  | 1 -> ty c b (V.getOr s ts 0)
  | _ -> newAstTypeTuple b (spanOf s) (V.map (ty c b) ts)

fun recTy (c : Lc) b (s : GTree) =
  newAstTypeRecord b (spanOf s)
    (V.map
      (\f ->
        newAstTypeField
          b
          (spanOf f)
          (nm b (nameOf (must TokenLowerIdent f)))
          (ty c b (must NodeType f)))
      (childrenOf NodeFieldTy s))
    (M.map (\r -> nm b (lastName r)) (childOf NodeRowTail s))

fun row (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match childOf NodeRowBraces s with
  | Just br ->
      newAstRow
        b
        m
        (V.map (rowLabel c b) (childrenOf NodeRowLabel br))
        (M.map (\r -> nm b (lastName r)) (childOf NodeRowTail br))
  | None ->
      (match childOf NodeRowLabel s with
       | Just l -> newAstRow b m [rowLabel c b l] None
       | None -> newAstRow b m [] (Just (nm b (firstName s))))

fun rowLabel (c : Lc) b (s : GTree) =
  newAstLabel b (spanOf s) (nm b (firstName s)) (V.map (tatom c b) (childrenOf NodeTAtom s))

-- --- patterns ----------------------------------------------------------------
--
-- A pattern is written by a function that may be told to span somewhere else:
-- one pattern in parentheses, as an argument, spans the parentheses.

fun pat (c : Lc) b (s : GTree) = patAt c b s None

fun patAt (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let atoms =
    V.pushFront (V.map (\t -> must NodePAtom t) (childrenOf NodeConsTail s)) (must NodePAtom s)
  in
  asesAt
    b
    (V.map (\a -> (\o -> patom c b a o, patomSpan a)) atoms)
    (childrenOf NodeAsTail s)
    (spanOf s)
    over

-- A pattern's parts, each written at a span it may be told to take, and the
-- span it has of its own: joined by `::`, then by `as`.
fun asesAt b parts (names : [GTree]) (whole : Meta) (over : Maybe Meta) =
  if V.isEmpty names then consTagged True b parts over
  else
    let inner =
      V.foldl
        (\f a -> \o -> newAstPatAs b (M.unwrapOr whole o) (nm b (vid (must NodeVid a))) (f None))
        (\o -> consTagged True b parts o)
        names
    in
    inner over

-- `a :: b :: c` as `Cons(a, Cons(b, c))`, a pattern's or an expression's.
fun consTagged (isPat : Bool) b parts (over : Maybe Meta) =
  match V.get parts 0 with
  | None -> 0 - 1
  | Just (f, hm) ->
      let rest = V.drop parts 1 in
      if V.isEmpty rest then f over
      else
        let tailEnd =
          (match V.get rest (V.len rest - 1) with
           | Just (_, tm) -> metaEnd tm
           | None -> metaEnd hm)
        in
        let whole = spanMeta (metaStart hm) tailEnd in
        let m = M.unwrapOr whole over in
        let name = nm b (named "Cons" whole) in
        let args = [f None, consTagged isPat b rest None] in
        if isPat
        then newAstPatCons b m name args
        else newAstExprCons b m name args

fun patomSpan (s : GTree) : Meta =
  match childOf NodeConPat s with
  | Just con -> spanOf con
  | None -> spanOf s

fun patom (c : Lc) b (s : GTree) (over : Maybe Meta) =
  match childOf NodeConPat s with
  | Just con -> conPat c b con (childrenOf NodeParg con) over
  | None -> arg c b (must NodeArg s) over

-- `A x y`, `A.B x y`, or either with nothing after it.
fun conPat (c : Lc) b (s : GTree) (args : [GTree]) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let written = V.map (parg c b) args in
  match childOf NodeQualTail s with
  | Just q ->
      newAstPatQualCons
        b
        m
        (nm b (nameOf (must TokenUpperIdent s)))
        (nm b (nameOf (must TokenUpperIdent q)))
        written
  | None -> newAstPatCons b m (nm b (nameOf (must TokenUpperIdent s))) written

fun parg (c : Lc) b (s : GTree) =
  match childOf NodeNullCon s with
  | Just con -> conPat c b con [] None
  | None -> arg c b (must NodeArg s) None

-- A pattern's argument, spanning all it was written with.
fun arg (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodePatParen then parenPat c b n True over
      else if k == NodeRecPat then recPat c b n m
      else if k == NodeVid then newAstPatVar b m (nm b (vid n))
      else if k == NodeArrPat
      then newAstPatArray b m (V.map (pat c b) (childrenOf NodePat n))
      else if k == NodeBrackPat then brackPat c b n m
      else if k == NodeMacCall then patCall c b m n
      else newAstPatWild b m
  | None -> litOrWild c b s m

fun litOrWild (c : Lc) b (s : GTree) (m : Meta) =
  match V.get (tokenKids s) 0 with
  | Just t ->
      (if R.kindOf t == TokenWildcard then newAstPatWild b m else newAstPatLit b m (lit c b t))
  | None -> newAstPatWild b m

-- A parameter: as a pattern's argument, but for parentheses round one
-- pattern, which are not part of it, and a bracket, which starts a whole
-- pattern.
fun param (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeNullCon then conPat c b n [] None
      else if k == NodePatParen then parenPat c b n False None
      else if k == NodeRecPat then recPat c b n m
      else if k == NodeVid then newAstPatVar b m (nm b (vid n))
      else if k == NodeBrackParam or k == NodeArrParam then
        let first = (if k == NodeBrackParam then must NodeBrackPat n else must NodeArrPat n)
        in
        let head =
          (\o -> if k == NodeBrackParam
            then brackPat c b first (M.unwrapOr (spanOf first) o)
            else
              newAstPatArray
              b
              (M.unwrapOr (spanOf first) o)
              (V.map (pat c b) (childrenOf NodePat first)))
        in
        let atoms =
          V.pushFront
            (V.map
              (\t -> (let a = must NodePAtom t in (\o -> patom c b a o, patomSpan a)))
              (childrenOf NodeConsTail n))
            (head, spanOf first)
        in
        asesAt b atoms (childrenOf NodeAsTail n) (spanOf n) None
      else newAstPatWild b m
  | None -> litOrWild c b s m

fun recPat (c : Lc) b (s : GTree) (m : Meta) =
  let fs =
    V.map
      (\f ->
        let n = nameOf (must TokenLowerIdent f) in
        newAstPatField
          b
          (spanOf f)
          (nm b n)
          (match childOf NodePFieldValue f with | Just v -> pat c b (must NodePat v) | None -> newAstPatVar b n.at (nm b n)))
      (childrenOf NodePField s) in
    newAstPatRecord b m fs (has NodeOpenTail s)

-- `[p; q]`, `[;]`, `[p, q]`, `[]`.
fun brackPat (c : Lc) b (s : GTree) (m : Meta) =
  match childOf NodeBrackPatBody s with
  | None -> newAstPatVector b m []
  | Just body ->
      (match childOf NodePat body with
       | None -> newAstPatList b m []
       | Just first ->
           let p = pat c b first in
           (match childOf NodeListPatTail body with
            | Just t ->
                newAstPatList
                  b
                  m
                  (V.pushFront
                    (V.map (pat c b) (V.concatMap (childrenOf NodePat) (childrenOf NodeSemiPat t)))
                    p)
            | None ->
                (match childOf NodeVecPatTail body with
                 | Just t ->
                     newAstPatVector
                       b
                       m
                       (V.pushFront
                         (V.map
                           (pat c b)
                           (V.concatMap (childrenOf NodePat) (childrenOf NodeCommaPat t)))
                         p)
                 | None -> newAstPatVector b m [p])))

-- Parentheses in a pattern: `()`, `(p : T)`, `(f -> p)`, a tuple -- or one
-- pattern, which as an argument (`spans`) takes the parentheses' span and as
-- a parameter keeps its own.
fun parenPat (c : Lc) b (s : GTree) (spans : Bool) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let elems = childrenOf NodeElem s in
  match childOf NodeParenAnnot s with
  | Just a ->
      newAstPatAnn b m (elemPat c b (V.getOr s elems 0) None) (ty c b (must NodeType a))
  | None ->
      (match V.len elems with
       | 0 -> newAstPatUnit b m
       | 1 -> elemPat c b (V.getOr s elems 0) (if spans then Just m else None)
       | _ -> newAstPatTuple b m (V.map (\e -> elemPat c b e None) elems))

-- An element of a pattern's parentheses: `f -> p`, or a pattern.
fun elemPat (c : Lc) b (s : GTree) (over : Maybe Meta) =
  match childOf NodeViewTail s with
  | Just v ->
      let f = must NodeExpr s in
      let p = must NodePat v in
      newAstPatView
        b
        (M.unwrapOr (spanMeta (metaStart (exprSpan c f)) (metaEnd (spanOf p))) over)
        (expr c b f)
        (pat c b p)
  | None ->
      asesAt b (exprPatParts c b (must NodeExpr s)) (childrenOf NodeAsTail s) (spanOf s) over

-- --- a pattern written as an expression --------------------------------------
--
-- What parentheses in a pattern hold is read as an expression, and, where no
-- `->` follows, as the pattern it is.

fun exprPatParts (c : Lc) b (s : GTree) =
  V.map
    (\o -> (let bs = must NodeBase o in (\over -> basePat c b bs over, spanOf bs)))
    (operandsOf s)

fun basePat (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let head = must NodeHead s in
  let args = childrenOf NodeAtom s in
  let m = M.unwrapOr (spanOf s) over in
  match firstNode head with
  | Just h ->
      let k = R.kindOf h in
      if k == NodeMacCall then patCall c b m h
      else if k == NodeQualHead
      then newAstPatQualCons b m (nm b (firstName h)) (nm b (lastName h)) (V.map (atomPat c b) args)
      else lowPat c b h over
  | None -> newAstPatCons b m (nm b (firstName head)) (V.map (atomPat c b) args)

fun atomPat (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeMacAtom then patCall c b m n
      else if k == NodeQualAtom
      then newAstPatQualCons b m (nm b (firstName n)) (nm b (lastName n)) []
      else lowPat c b n None
  | None -> newAstPatCons b m (nm b (firstName s)) []

fun lowPat (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let prim =
    (match childOf NodeClosedAtom s with
     | Just ca -> M.unwrapOr ca (firstNode ca)
     | None -> M.unwrapOr s (firstNode s))
  in
  let m = M.unwrapOr (spanOf prim) over in
  let k = R.kindOf prim in
  if k == NodeParen then parenPat c b prim True over
  else if k == NodeOpRef
  then newAstPatVar b m (nm b (firstName (must NodeOpName prim)))
  else if k == NodeLitE
  then newAstPatLit b m (lit c b (V.getOr prim (tokenKids prim) 0))
  else if k == NodeVarE then newAstPatVar b m (nm b (firstName prim))
  else if k == NodeHoleE then newAstPatWild b m
  else if k == NodeBraceE then bracePat c b prim m
  else if k == NodeBrackE then brackExprPat c b prim m
  else if k == NodeArrE
  then newAstPatArray b m (V.map (asExprPat c b) (childrenOf NodeAsExpr prim))
  else newAstPatWild b m

fun asExprPat (c : Lc) b (s : GTree) =
  asesAt b (exprPatParts c b (must NodeExpr s)) (childrenOf NodeAsTail s) (spanOf s) None

fun bracePat (c : Lc) b (s : GTree) (m : Meta) =
  let fs =
    V.map
      (\item ->
        let n = firstName (must NodeAsExpr item) in
        newAstPatField
          b
          (spanOf item)
          (nm b n)
          (match childOf NodeFieldValue item with | Just v -> asExprPat c b (must NodeAsExpr v) | None -> newAstPatVar b n.at (nm b n)))
      (childrenOf NodeBraceItem s) in
    newAstPatRecord b m fs (has NodeBraceTail s)

fun brackExprPat (c : Lc) b (s : GTree) (m : Meta) =
  match childOf NodeBrackBody s with
  | None -> newAstPatVector b m []
  | Just body ->
      (match childOf NodeAsExpr body with
       | None -> newAstPatList b m []
       | Just first ->
           let p = asExprPat c b first in
           (match childOf NodeListTail body with
            | Just t ->
                newAstPatList
                  b
                  m
                  (V.pushFront
                    (V.map
                      (asExprPat c b)
                      (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                    p)
            | None ->
                (match childOf NodeVecTail body with
                 | Just t ->
                     newAstPatVector
                       b
                       m
                       (V.pushFront
                         (V.map
                           (asExprPat c b)
                           (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeCommaItem t)))
                         p)
                 | None -> newAstPatVector b m [p])))

-- --- a pattern as the expression that builds what it matches -----------------

-- Whether pattern `s` can be read as an expression -- `meadow-parser`'s
-- `pat_expr`.
fun builds (s : GTree) : Bool =
  not (has NodeAsTail s)
    and V.all patomBuilds (V.pushFront (V.map (\t -> must NodePAtom t) (childrenOf NodeConsTail s)) (must NodePAtom s))

fun patomBuilds (s : GTree) : Bool =
  match childOf NodeConPat s with
  | Just con ->
      not (has NodeQualTail con) and V.all pargBuilds (childrenOf NodeParg con)
  | None -> argBuilds (must NodeArg s)

fun pargBuilds (s : GTree) : Bool =
  match childOf NodeNullCon s with
  | Just con -> not (has NodeQualTail con)
  | None -> argBuilds (must NodeArg s)

fun argBuilds (s : GTree) : Bool =
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeVid then True
      else if k == NodeRecPat
      then
        not (has NodeOpenTail n)
          and V.all (\f -> match childOf NodePFieldValue f with | Just v -> builds (must NodePat v) | None -> True) (childrenOf NodePField n)
      else if k == NodeArrPat then V.all builds (childrenOf NodePat n)
      else if k == NodeBrackPat then
        (match childOf NodeBrackPatBody n with
         | None -> False
         | Just body ->
             (match childOf NodeListPatTail body with
              | Just t ->
                  V.all
                    builds
                    (V.append
                      (childrenOf NodePat body)
                      (V.concatMap (childrenOf NodePat) (childrenOf NodeSemiPat t)))
              | None -> not (has NodePat body)))
      else if k == NodePatParen then V.all elemBuilds (childrenOf NodeElem n)
      else False
  | None -> not (tokenIs TokenWildcard s)

fun elemBuilds (s : GTree) : Bool =
  not (has NodeAsTail s)
    and not (has NodeViewTail s)
    and V.all (\o -> V.isEmpty (childrenOf TokenMinus o) and baseBuilds (must NodeBase o)) (operandsOf (must NodeExpr s))

-- The operands of an expression read as a pattern: what `::` joins, left to
-- right, however the fixity pass grouped them.
fun operandsOf (e : GTree) : [GTree] =
  let andE = must NodeAndE (must NodeOrE (must NodePipeL e)) in
  match firstNode andE with
  | Just ops -> leavesOf ops
  | None -> []

fun leavesOf (s : GTree) : [GTree] =
  match s with
  | GroupedInfix l _ r -> V.append (leavesOf l) (leavesOf r)
  | GroupedLeaf operand -> [operand]
  | _ -> []

fun baseBuilds (s : GTree) : Bool =
  match firstNode (must NodeHead s) with
  | Just h ->
      R.kindOf h == NodeLowAtom and V.isEmpty (childrenOf NodeAtom s) and lowBuilds h
  | None ->
      V.all
        (\a -> match firstNode a with
               | Just n -> R.kindOf n == NodeLowAtom and lowBuilds n
               | None -> True)
        (childrenOf NodeAtom s)

fun lowBuilds (s : GTree) : Bool =
  match childOf NodeClosedAtom s with
  | Just ca ->
      let prim = M.unwrapOr ca (firstNode ca) in
      let k = R.kindOf prim in
      not (has NodeFieldTail ca)
        and (if k == NodeParen then V.all elemBuilds (childrenOf NodeElem prim)
          else if k == NodeOpRef or k == NodeLitE or k == NodeVarE then True
          else if k == NodeBraceE
          then
            not (has NodeBraceTail prim)
              and V.all (\i -> match childOf NodeFieldValue i with | Just v -> elemBuilds (must NodeAsExpr v) | None -> True) (childrenOf NodeBraceItem prim)
          else if k == NodeBrackE then
            (match childOf NodeBrackBody prim with
             | None -> False
             | Just body ->
                 (match childOf NodeListTail body with
                  | Just t ->
                      V.all
                        elemBuilds
                        (V.append
                          (childrenOf NodeAsExpr body)
                          (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                  | None -> not (has NodeAsExpr body)))
          else if k == NodeArrE
          then V.all elemBuilds (childrenOf NodeAsExpr prim)
          else False)
  | None -> False

-- Pattern `s` written as the expression that builds it: each part at the
-- pattern's own span.
fun patExpr (c : Lc) b (s : GTree) =
  let atoms =
    V.pushFront (V.map (\t -> must NodePAtom t) (childrenOf NodeConsTail s)) (must NodePAtom s)
  in
  consExpr c b atoms

fun consExpr (c : Lc) b (atoms : [GTree]) =
  match V.get atoms 0 with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just h ->
      let rest = V.drop atoms 1 in
      if V.isEmpty rest then patomExpr c b h
      else
        let m =
          spanMeta (metaStart (patomSpan h)) (metaEnd (patomSpan (V.getOr h rest (V.len rest - 1))))
        in
        newAstExprCons b m (nm b (named "Cons" m)) [patomExpr c b h, consExpr c b rest]

fun patomExpr (c : Lc) b (s : GTree) =
  match childOf NodeConPat s with
  | Just con ->
      newAstExprCons
        b
        (spanOf con)
        (nm b (nameOf (must TokenUpperIdent con)))
        (V.map (pargExpr c b) (childrenOf NodeParg con))
  | None -> argExpr c b (must NodeArg s)

fun pargExpr (c : Lc) b (s : GTree) =
  match childOf NodeNullCon s with
  | Just con ->
      newAstExprCons b (spanOf con) (nm b (nameOf (must TokenUpperIdent con))) []
  | None -> argExpr c b (must NodeArg s)

fun argExpr (c : Lc) b (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeVid then newAstExprVar b m (nm b (vid n))
      else if k == NodeRecPat then
        newAstExprRecord b m
          (V.map
            (\f ->
              (let fn = nameOf (must TokenLowerIdent f) in
                newAstExprField
                b
                (spanOf f)
                (nm b fn)
                (match childOf NodePFieldValue f with
                 | Just v -> patExpr c b (must NodePat v)
                 | None -> newAstExprVar b fn.at (nm b fn))))
            (childrenOf NodePField n))
          None
      else if k == NodeArrPat
      then newAstExprArray b m (V.map (patExpr c b) (childrenOf NodePat n))
      else if k == NodeBrackPat then
        (match childOf NodeBrackPatBody n with
         | Just body ->
             newAstExprList
               b
               m
               (V.map
                 (patExpr c b)
                 (V.append
                   (childrenOf NodePat body)
                   (V.concatMap
                     (childrenOf NodePat)
                     (V.concatMap (childrenOf NodeSemiPat) (childrenOf NodeListPatTail body)))))
         | None -> newAstExprList b m [])
      else if k == NodePatParen then parenExpr c b n (Just m)
      else newAstExprUnit b m
  | None ->
      (match V.get (tokenKids s) 0 with
       | Just t -> newAstExprLit b m (lit c b t)
       | None -> newAstExprUnit b m)

-- The same, for parentheses in a pattern, whose elements are read as
-- expressions and then as patterns.
fun parenExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let elems = childrenOf NodeElem s in
  match (childOf NodeParenAnnot s, V.get elems 0) with
  | (Just _, Just e) -> elemExpr c b e None
  | (_, None) -> newAstExprUnit b m
  | (None, Just e) ->
      if V.len elems == 1 then elemExpr c b e (Just m)
      else newAstExprTuple b m (V.map (\x -> elemExpr c b x None) elems)

fun elemExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  consTagged
    False
    b
    (V.map
      (\o -> (let bs = must NodeBase o in (\ov -> baseExpr c b bs ov, spanOf bs)))
      (operandsOf (must NodeExpr s)))
    over

fun baseExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let head = must NodeHead s in
  match firstNode head with
  | Just h -> lowExpr c b h over
  | None ->
      newAstExprCons b (M.unwrapOr (spanOf s) over) (nm b (firstName head))
        (V.map
          (\a -> match firstNode a with
                 | Just n -> lowExpr c b n None
                 | None -> newAstExprCons b (spanOf a) (nm b (firstName a)) [])
          (childrenOf NodeAtom s))

fun lowExpr (c : Lc) b (s : GTree) (over : Maybe Meta) =
  let prim =
    (match childOf NodeClosedAtom s with
     | Just ca -> M.unwrapOr ca (firstNode ca)
     | None -> s)
  in
  let m = M.unwrapOr (spanOf prim) over in
  let k = R.kindOf prim in
  if k == NodeParen then parenExpr c b prim over
  else if k == NodeOpRef
  then newAstExprVar b m (nm b (firstName (must NodeOpName prim)))
  else if k == NodeLitE
  then newAstExprLit b m (lit c b (V.getOr prim (tokenKids prim) 0))
  else if k == NodeVarE then newAstExprVar b m (nm b (firstName prim))
  else if k == NodeBraceE then
    newAstExprRecord b m
      (V.map
        (\i ->
          let n = firstName (must NodeAsExpr i) in
          newAstExprField
            b
            (spanOf i)
            (nm b n)
            (match childOf NodeFieldValue i with | Just v -> elemExpr c b (must NodeAsExpr v) None | None -> newAstExprVar b n.at (nm b n)))
        (childrenOf NodeBraceItem prim))
      None
  else if k == NodeBrackE then
    (match childOf NodeBrackBody prim with
     | Just body ->
         newAstExprList
           b
           m
           (V.map
             (\x -> elemExpr c b x None)
             (V.append
               (childrenOf NodeAsExpr body)
               (V.concatMap
                 (childrenOf NodeAsExpr)
                 (V.concatMap (childrenOf NodeSemiItem) (childrenOf NodeListTail body)))))
     | None -> newAstExprList b m [])
  else if k == NodeArrE
  then newAstExprArray b m (V.map (\x -> elemExpr c b x None) (childrenOf NodeAsExpr prim))
  else newAstExprUnit b m

-- --- literals ----------------------------------------------------------------

fun lit (c : Lc) b (t : GTree) =
  let m = spanOf t in
  match tokenOf c t with
  | Just (Int n) -> newAstLitInt b m (show n)
  | Just (Real s) -> newAstLitFloat b m s
  | Just (Str s) -> newAstLitString b m s
  | Just (Char n) -> newAstLitChar b m (show n)
  | _ -> newAstLitString b m (R.text t)

-- --- expressions -------------------------------------------------------------
--
-- An expression is written with the holes of the section it is in, if any:
-- the start of each `_` it owns, in the order `meadow-parser` numbers them.

fun expr (c : Lc) b (s : GTree) = exprIn c b [] s None

-- `f <| g <| x` is `f (g x)`; `x |> f |> g` is `g (f x)`: applications, each
-- spanning what it joins.
fun exprIn (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let parts = V.pushFront (childrenOf NodeBackPipe s) s in
  let pipes = V.map (\p -> must NodePipeL p) parts in
  if V.len pipes == 1 then pipeL c b hs (must NodePipeL s) over
  else backs c b hs pipes over

fun backs (c : Lc) b (hs : [Int]) (pipes : [GTree]) (over : Maybe Meta) =
  match V.get pipes 0 with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just f ->
      let rest = V.drop pipes 1 in
      if V.isEmpty rest then pipeL c b hs f over
      else
        let m = M.unwrapOr (V.foldl (\acc p -> join acc (pipeSpan c p)) (pipeSpan c f) rest) over
        in
        newAstExprApp b m (pipeL c b hs f None) [backs c b hs rest None]

fun pipeL (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let ors = V.pushFront (V.map (\p -> must NodeOrE p) (childrenOf NodePipe s)) (must NodeOrE s)
  in
  pipes c b hs ors over

-- A left fold: the last is applied to the rest.
fun pipes (c : Lc) b (hs : [Int]) (ors : [GTree]) (over : Maybe Meta) =
  let n = V.len ors in
  match V.get ors (n - 1) with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just f ->
      if n == 1 then orE c b hs f over
      else
        let rest = V.take ors (n - 1) in
        let m = M.unwrapOr (V.foldl (\acc o -> join acc (orSpan c o)) (orSpan c f) rest) over
        in
        newAstExprApp b m (orE c b hs f None) [pipes c b hs rest None]

fun orE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  binFold
    b
    False
    (V.pushFront (V.map (\t -> must NodeAndE t) (childrenOf NodeOrTail s)) (must NodeAndE s))
    (\x o -> andE c b hs x o)
    (andSpan c)
    over

fun andE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let parts =
    V.pushFront
      (V.map (\t -> M.unwrapOr t (firstNode t)) (childrenOf NodeAndTail s))
      (M.unwrapOr s (firstNode s))
  in
  binFold b True parts (\x o -> ops c b hs x o) (opsSpan c) over

-- `a or b or c` is `(a or b) or c`: each spanning what it joins, and so is
-- its operator.
fun binFold b (isAnd : Bool) (xs : [GTree]) write spanFn (over : Maybe Meta) =
  let n = V.len xs in
  match V.get xs (n - 1) with
  | None -> newAstExprUnit b (spanMeta 0 0)
  | Just r ->
      if n == 1 then write r over
      else
        let rest = V.take xs (n - 1) in
        let m = V.foldl (\acc x -> join acc (spanFn x)) (spanFn r) rest in
        let op = nm b (named (if isAnd then "and" else "or") m) in
        let lhs = binFold b isAnd rest write spanFn None in
        let rhs = write r None in
        if isAnd
        then newAstExprAnd b (M.unwrapOr m over) op lhs rhs
        else newAstExprOr b (M.unwrapOr m over) op lhs rhs

-- A chain of operators, grouped: `(+) a b` for each operator applied to two,
-- spanning its operands, and `Cons a b` for `::`. A chain's span is its
-- operands'; the parentheses round one are not part of it.
fun ops (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  match s with
  | GroupedInfix l op r ->
      let lhs = ops c b hs l None in
      let rhs = ops c b hs r None in
      let m = join (opsSpan c l) (opsSpan c r) in
      let name = S.trim (R.text op) in
      if name == "::"
      then newAstExprCons b m (nm b (named "Cons" (spanOf op))) [lhs, rhs]
      else
        newAstExprApp b m (newAstExprVar b (spanOf op) (nm b (named name (spanOf op)))) [lhs, rhs]
  | GroupedLeaf operand -> operandE c b hs operand over
  | _ -> newAstExprUnit b (spanOf s)

-- `-e`: a literal's own value negated, and anything else under `neg` -- the
-- minus nearest the operand first, each spanning from itself to the end.
fun operandE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let minuses = childrenOf TokenMinus s in
  let base = must NodeBase s in
  if V.isEmpty minuses then baseE c b hs base over
  else negated c b hs minuses base over

fun negated (c : Lc) b (hs : [Int]) (minuses : [GTree]) (base : GTree)
    (over : Maybe Meta) =
  let n = V.len minuses in
  let inner = V.drop minuses 1 in
  let first = V.getOr base minuses 0 in
  let m = M.unwrapOr (join (spanOf first) (negSpan c inner base)) over in
  match literalOf c base with
  | Just (text, isFloat) ->
      let sign = n % 2 == 1 in
      let value = if sign then flipped text else text in
      newAstExprLit b m (if isFloat then newAstLitFloat b m value else newAstLitInt b m value)
  | None ->
      newAstExprNeg
        b
        m
        (nm b (named "neg" m))
        (if V.isEmpty inner then baseE c b hs base None else negated c b hs inner base None)

fun negSpan (c : Lc) (minuses : [GTree]) (base : GTree) : Meta =
  match V.get minuses 0 with
  | Just m -> join (spanOf m) (baseSpan c base)
  | None -> baseSpan c base

fun flipped (t : String) : String =
  if S.startsWith "-" t then stringSlice t 1 (stringByteLength t) else "-" ++ t

-- The literal a base is alone, as its text and whether it is a float.
fun literalOf (c : Lc) (s : GTree) : Maybe (String, Bool) =
  if not (V.isEmpty (childrenOf NodeAtom s)) then None
  else
    match M.andThen (childOf NodeLowAtom) (childOf NodeHead s) with
    | Just low ->
        (match childOf NodeClosedAtom low with
         | Just ca ->
             if has NodeFieldTail ca then None
             else
               (match childOf NodeLitE ca with
                | Just l ->
                    (match M.andThen (tokenOf c) (V.get (tokenKids l) 0) with
                     | Just (Int n) -> Just (show n, False)
                     | Just (Real t) -> Just (t, True)
                     | _ -> None)
                | None -> None)
         | None -> None)
    | None -> None

-- What is applied, and to what: a macro call, a qualified name -- which spans
-- its arguments too -- a constructor, or an atom.
fun baseE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let head = must NodeHead s in
  let args = childrenOf NodeAtom s in
  let written = \u -> V.map (atomE c b hs) args in
  let applied = \f -> if V.isEmpty args then f over else newAstExprApp b m (f None) (written ())
  in
  match firstNode head with
  | Just h ->
      let k = R.kindOf h in
      if k == NodeMacCall
      then applied (\o -> exprCall c b (M.unwrapOr (macSpan h) o) h)
      else if k == NodeQualHead
      then applied (\o -> newAstExprQual b (spanOf s) (nm b (firstName h)) (nm b (lastName h)))
      else if V.isEmpty args then lowAtom c b hs h over
      else newAstExprApp b m (lowAtom c b hs h None) (written ())
  | None -> newAstExprCons b m (nm b (firstName head)) (written ())

fun atomE (c : Lc) b (hs : [Int]) (s : GTree) =
  let m = spanOf s in
  match firstNode s with
  | Just n ->
      let k = R.kindOf n in
      if k == NodeMacAtom then fields b n (exprCall c b (macSpan n) n)
      else if k == NodeQualAtom then
        let toks = V.filter (\t -> R.kindOf t != TokenPeriod) (tokenKids n) in
        let q = (match V.get toks 0 with | Just t -> nameOf t | None -> named "" m)
        in
        let x = (match V.get toks 1 with | Just t -> nameOf t | None -> named "" m)
        in
        fields b n (newAstExprQual b (from q.at x.at) (nm b q) (nm b x))
      else lowAtom c b hs n None
  | None -> newAstExprCons b m (nm b (firstName s)) []

-- An atom's `.field`s, each spanning the atom and every field: the
-- outermost last.
fun fields b (s : GTree) (inner : Int) =
  let m = spanOf s in
  V.foldl
    (\e f -> newAstExprProj b m e (nm b (nameOf (must TokenLowerIdent f))))
    inner
    (childrenOf NodeFieldTail s)

fun lowAtom (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  match childOf NodeClosedAtom s with
  | Just ca ->
      let prim = M.unwrapOr ca (firstNode ca) in
      if has NodeFieldTail ca then fields b ca (closedPrim c b hs prim None)
      else closedPrim c b hs prim over
  | None -> openPrim c b hs (M.unwrapOr s (firstNode s)) over

fun closedPrim (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let k = R.kindOf s in
  if k == NodeParen then parenE c b hs s over
  else if k == NodeOpRef
  then newAstExprVar b m (nm b (firstName (must NodeOpName s)))
  else if k == NodeLitE
  then newAstExprLit b m (lit c b (V.getOr s (tokenKids s) 0))
  else if k == NodeInterpE then interp c b hs s m
  else if k == NodeVarE then newAstExprVar b m (nm b (firstName s))
  else if k == NodeHoleE then
    (match V.find (\i -> V.getOr (0 - 1) hs i == metaStart (spanOf s)) (V.range 0 (V.len hs)) with
     | Just i -> newAstExprVar b m (nm b (named "_hole${show i}" (spanOf s)))
     | None -> newAstExprHole b m)
  else if k == NodeBraceE then braceE c b hs s m
  else if k == NodeBrackE then brackE c b hs s m
  else
    newAstExprArray
      b
      m
      (V.map (\x -> exprIn c b hs (must NodeExpr x) None) (childrenOf NodeAsExpr s))

fun openPrim (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let m = M.unwrapOr (spanOf s) over in
  let e = \x -> exprIn c b hs x None in
  match s with
  | GroupedIfE cond yes no -> newAstExprIf b m (e cond) (e yes) (e no)
  | GroupedLamE params body ->
      newAstExprLam b m (V.map (pat c b) params) (expr c b body)
  | GroupedMatchE scrutinee arms ->
      newAstExprMatch b m (e scrutinee)
        (V.concatMap
          (\a ->
            match a with
            | GroupedArm p guard body ->
                [newAstArm
                  b
                  (spanOf a)
                  (pat c b p)
                  (M.andThen
                    (\g -> match g with
                           | GroupedGuard cond -> Just (e cond)
                           | _ -> None)
                    guard)
                  (e body)]
            | _ -> [])
          arms)
  | GroupedLetE binds body ->
      newAstExprLet b m (V.concatMap (letBind c b hs) binds) (e body)
  | GroupedHandleE target arms -> handleE c b hs m target arms
  | _ -> newAstExprUnit b m

-- A `let`'s binding: `fun f x = …`, `f x = …` (a name, maybe `rec`), or any
-- other pattern `= …` -- whose value a section's holes are in; a function's
-- are not.
fun letBind (c : Lc) b (hs : [Int]) (s : GTree) =
  let value = must NodeExpr s in
  let ret = M.map (resultTy c b) (childOf NodeAnnot s) in
  let params = V.map (param c b) (childrenOf NodeParam s) in
  match s with
  | GroupedFunBind name _ _ _ ->
      [bindOfName c b (nameOf name) params ret (expr c b value) (spanOf s)]
  | GroupedPatBind _ p _ _ _ ->
      (match plainName p with
       | Just n ->
           [bindOfName
             c
             b
             n
             params
             ret
             (if V.isEmpty params then exprIn c b hs value None else expr c b value)
             (spanOf s)]
       | None ->
           [newAstBindPat b (spanOf s) (pat c b p) (exprIn c b hs value None)])
  | _ -> []

-- A pattern that is one lower-case name as it was written.
fun plainName (p : GTree) : Maybe Nm =
  if has NodeConsTail p or has NodeAsTail p then None
  else
    match M.andThen (childOf NodeArg) (childOf NodePAtom p) with
    | Just a ->
        (match childOf NodeVid a with
         | Just v -> M.map nameOf (childOf TokenLowerIdent v)
         | None -> None)
    | None -> None

fun handleE (c : Lc) b (hs : [Int]) (m : Meta) (target : GTree)
    (arms : [GTree]) =
  let isReturn =
    \a -> V.len (childrenOf TokenLowerIdent a) == 1 and R.text (must TokenLowerIdent a) == "return"
  in
  let opArms = V.filter (\a -> not (isReturn a)) arms in
  let rets = V.filter isReturn arms in
  let ret = V.get rets (V.len rets - 1) in
  let e = \x -> exprIn c b hs x None in
  newAstExprHandle b m (e target)
    (V.map
      (\a ->
        let ls = childrenOf TokenLowerIdent a in
        newAstHArm
          b
          (spanOf a)
          (nm b (nameOf (V.getOr a ls 0)))
          (pat c b (must NodePat a))
          (nm b (nameOf (V.getOr a ls 1)))
          (e (must NodeExpr a)))
      opArms)
    (M.map (\r -> newAstRet b (spanOf r) (pat c b (must NodePat r)) (e (must NodeExpr r))) ret)

-- `(…)`: `()`, `(e)` -- a section if it has a `_` in it -- or a tuple.
fun parenE (c : Lc) b (hs : [Int]) (s : GTree) (over : Maybe Meta) =
  let elems = V.map (\x -> must NodeExpr x) (childrenOf NodeElem s) in
  match V.len elems with
  | 0 -> newAstExprUnit b (M.unwrapOr (spanOf s) over)
  | 1 ->
      let inner = V.getOr s elems 0 in
      let own = holesIn inner in
      if V.isEmpty own then exprIn c b hs inner over
      else
        let m = M.unwrapOr (exprSpan c inner) over in
        let params =
          V.map
            (\i ->
              newAstPatVar b (exprSpan c inner) (nm b (named "_hole${show i}" (exprSpan c inner))))
            (V.range 0 (V.len own))
        in
        newAstExprLam b m params (exprIn c b own inner None)
  | _ ->
      newAstExprTuple b (M.unwrapOr (spanOf s) over) (V.map (\x -> exprIn c b hs x None) elems)

fun interp (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let text =
    \t ->
      (match tokenOf c t with
       | Just (InterpStart x) -> x
       | Just (InterpMid x) -> x
       | Just (InterpEnd x) -> x
       | _ -> "")
  in
  let texts =
    V.concat
      [ V.map text (childrenOf TokenInterpStart s),
        V.map (\mid -> text (must TokenInterpMid mid)) (childrenOf NodeInterpMid s),
        V.map text (childrenOf TokenInterpEnd s) ] in
    let hole =
      \h -> newAstHole b (spanOf h) (exprIn c b hs (must NodeExpr h) None) (tokenIs TokenDebugFmt h)
    in
  let holes =
    V.pushFront
      (V.map (\mid -> hole (must NodeHole mid)) (childrenOf NodeInterpMid s))
      (hole (must NodeHole s))
  in
  newAstExprInterp b m texts holes

-- `{ r | x = e }` updates `r`; anything else is a record, `{ x }` short for
-- `{ x = x }`, and `| r` what it extends.
fun braceE (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let items = childrenOf NodeBraceItem s in
  let e = \x -> exprIn c b hs x None in
  match M.andThen (childOf NodeUpdFields) (childOf NodeBraceTail s) with
  | Just u ->
      let target =
        (match V.get items 0 with
         | Just i -> e (must NodeExpr (must NodeAsExpr i))
         | None -> newAstExprUnit b m)
      in
      newAstExprUpdate
        b
        m
        target
        (V.map
          (\f ->
            newAstExprField
              b
              (spanOf f)
              (nm b (nameOf (must TokenLowerIdent f)))
              (e (must NodeExpr f)))
          (childrenOf NodeUpdField u))
  | None ->
      let fs =
        V.map
          (\i ->
            let n = firstName (must NodeAsExpr i) in
            newAstExprField
              b
              (spanOf i)
              (nm b n)
              (match childOf NodeFieldValue i with | Just fv -> e (must NodeExpr (must NodeAsExpr fv)) | None -> newAstExprVar b n.at (nm b n)))
          items in
        let base =
          M.andThen
            (\t -> M.map (\te -> e (must NodeExpr te)) (childOf NodeTailExpr t))
            (childOf NodeBraceTail s)
        in
      newAstExprRecord b m fs base

-- `[lo .. hi]`, `[a; b]`, `[;]`, `[a, b]`, `[]`.
fun brackE (c : Lc) b (hs : [Int]) (s : GTree) (m : Meta) =
  let item = \x -> exprIn c b hs (must NodeExpr x) None in
  let vector =
    \es ->
      newAstExprApp b m (newAstExprVar b m (nm b (named "vecFromArray" m))) [newAstExprArray b m es]
  in
  match childOf NodeBrackBody s with
  | None -> vector []
  | Just body ->
      (match childOf NodeAsExpr body with
       | None -> newAstExprList b m []
       | Just first ->
           let lo = item first in
           (match childOf NodeRangeTail body with
            | Just r ->
                let hi = must NodeExpr r in
                let hm = exprSpan c hi in
                let hiE = exprIn c b hs hi None in
                -- `[a .. b]` and `[a ..= b]` alike: `range a (b + 1)`.
                let hi1 =
                  newAstExprApp
                    b
                    hm
                    (newAstExprVar b hm (nm b (named "+" hm)))
                    [hiE, newAstExprLit b hm (newAstLitInt b hm "1")]
                in
                newAstExprApp b m (newAstExprVar b m (nm b (named "range" m))) [lo, hi1]
            | None ->
                (match childOf NodeListTail body with
                 | Just t ->
                     newAstExprList
                       b
                       m
                       (V.pushFront
                         (V.map
                           item
                           (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeSemiItem t)))
                         lo)
                 | None ->
                     (match childOf NodeVecTail body with
                      | Just t ->
                          vector
                            (V.pushFront
                              (V.map
                                item
                                (V.concatMap (childrenOf NodeAsExpr) (childrenOf NodeCommaItem t)))
                              lo)
                      | None -> vector [lo]))))

-- --- spans -------------------------------------------------------------------
--
-- The span `meadow-parser` gives what it makes of an expression: where it was
-- written, but that `(e)` spans `e`, and what joins two spans the span of
-- both.

fun exprSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc p -> join acc (pipeSpan c (must NodePipeL p)))
    (pipeSpan c (must NodePipeL s))
    (childrenOf NodeBackPipe s)

fun pipeSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc p -> join acc (orSpan c (must NodeOrE p)))
    (orSpan c (must NodeOrE s))
    (childrenOf NodePipe s)

fun orSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc t -> join acc (andSpan c (must NodeAndE t)))
    (andSpan c (must NodeAndE s))
    (childrenOf NodeOrTail s)

fun andSpan (c : Lc) (s : GTree) : Meta =
  V.foldl
    (\acc t -> join acc (opsSpan c (M.unwrapOr t (firstNode t))))
    (opsSpan c (M.unwrapOr s (firstNode s)))
    (childrenOf NodeAndTail s)

-- A chain's span is its operands'.
fun opsSpan (c : Lc) (s : GTree) : Meta =
  match s with
  | GroupedInfix l _ r -> join (opsSpan c l) (opsSpan c r)
  | GroupedLeaf operand -> operandSpan c operand
  | _ -> spanOf s

fun operandSpan (c : Lc) (s : GTree) : Meta = negSpan c (childrenOf TokenMinus s) (must NodeBase s)

fun baseSpan (c : Lc) (s : GTree) : Meta =
  if has NodeAtom s then spanOf s
  else
    match M.andThen (childOf NodeLowAtom) (childOf NodeHead s) with
    | Just low ->
        (match childOf NodeClosedAtom low with
         | Just ca ->
             (if has NodeFieldTail ca then spanOf ca else primSpan c (M.unwrapOr ca (firstNode ca)))
         | None -> spanOf low)
    | None ->
        (match M.andThen (childOf NodeMacCall) (childOf NodeHead s) with
         | Just mc -> macSpan mc
         | None -> spanOf s)

fun primSpan (c : Lc) (s : GTree) : Meta =
  if R.kindOf s == NodeParen and V.len (childrenOf NodeElem s) == 1
  then exprSpan c (must NodeExpr (must NodeElem s))
  else spanOf s

-- --- sections ----------------------------------------------------------------

-- The `_`s a section `(e)` makes parameters of: the start of each, in the
-- order `meadow-parser`'s `fill_holes` meets them.
fun holesIn (s : GTree) : [Int] =
  let k = R.kindOf s in
  if k == NodeExpr then
    V.concatMap
      holesIn
      (V.pushFront (V.map (\p -> must NodePipeL p) (childrenOf NodeBackPipe s)) (must NodePipeL s))
  else if k == NodePipeL then
    V.concatMap
      holesIn
      (V.reverse
        (V.pushFront (V.map (\p -> must NodeOrE p) (childrenOf NodePipe s)) (must NodeOrE s)))
  else
    if k == NodeLamE
    or k == NodeMacCall
      or k == NodeMacAtom
      or k == NodeQualAtom
      or k == NodeQualHead
      or k == NodeVarE
      or k == NodeLitE
      or k == NodeOpRef
    then []
    else if k == NodeHoleE then [metaStart (spanOf s)]
    else if k == NodeParen then
      (let elems = childrenOf NodeElem s in
        if V.len elems == 1
        then
          (let inner = must NodeExpr (V.getOr s elems 0) in
            if V.isEmpty (holesIn inner) then holesIn inner else [])
        else V.concatMap (\e -> holesIn (must NodeExpr e)) elems)
    else if k == NodeMatchE then
      V.concatMap
      (\x -> if R.kindOf x == NodeArm
        then V.concatMap holesIn (V.filter (\y -> R.kindOf y != NodePat) (nodeKids x))
        else holesIn x)
      (nodeKids s)
    else if k == NodeLetE then
      V.concatMap
      (\x -> if R.kindOf x == NodeFunBind
        then []
        else if R.kindOf x == NodePatBind
        then (if V.isEmpty (childrenOf NodeParam x) then holesIn (must NodeExpr x) else [])
        else holesIn x)
      (nodeKids s)
    else if k == NodeHandleE then
      let arms = childrenOf NodeHArm s in
      let isReturn =
        \a ->
          V.len (childrenOf TokenLowerIdent a) == 1
          and R.text (must TokenLowerIdent a) == "return"
      in
      let rets = V.filter isReturn arms in
      V.concat
      [ holesIn (must NodeExpr s),
        V.concatMap (\a -> holesIn (must NodeExpr a)) (V.filter (\a -> not (isReturn a)) arms),
        (match V.get rets (V.len rets - 1) with | Just r -> holesIn (must NodeExpr r) | None -> []) ]
    else
      V.concatMap
      holesIn
      (V.filter
        (\x -> R.kindOf x != NodePat and R.kindOf x != NodeAnnot and R.kindOf x != NodeParam)
        (nodeKids s))

-- --- expansions --------------------------------------------------------------
--
-- What the Rust compiler's macros expanded to (`meadow_compiler::expand::record`):
-- JSON, a node an array -- its production, where it came from, its fields, named
-- and ordered as `Ast` has them -- read here into `Ast`'s tables. A chain of
-- operators comes as it was parsed, and is grouped here by the unit's
-- fixities, as the fixity pass groups one in a tree.

fun exprCall (c : Lc) b (m : Meta) (call : GTree) =
  match rulesOf c call with
  | Just r ->
      M.unwrapOr (newAstExprMacCall b m (macCall b call)) (expandedExpr c b r call)
  | None ->
      (match expansion c "expr" m with
       | Just made -> jExpr c b made
       | None -> newAstExprMacCall b m (macCall b call))

fun patCall (c : Lc) b (m : Meta) (call : GTree) =
  match rulesOf c call with
  | Just r ->
      M.unwrapOr (newAstPatMacCall b m (macCall b call)) (expandedPat c b r call)
  | None ->
      (match expansion c "pat" m with
       | Just made -> jPat c b made
       | None -> newAstPatMacCall b m (macCall b call))

-- --- `macro`s ----------------------------------------------------------------
--
-- A call of one of the module's own `macro`s is expanded here (`Rules`): its
-- template written out as tokens, each standing where it came from, parsed
-- from them where the call is -- inside `def x = …` for an expression, a
-- match's arm for a pattern -- grouped by the unit's fixities, lowered, and
-- the marks taken off every name but the locals (`Hygiene`).

-- The module's `macro`s, by name, each rule's matcher read.
fun macrosOf (c : Lc) (pkg : String) (top : GTree) : HashMap String Macro =
  V.foldl
    (\h d ->
      match M.andThen firstNode (childOf NodeItem d) with
      | Just (GroupedMacroDecl name rules) ->
          (match macroOf c pkg rules with
           | Just m -> H.insert (nameOf name).text m h
           | None -> h)
      | _ -> h)
    H.empty
    (childrenOf NodeDecl top)

fun macroOf (c : Lc) (pkg : String) (rules : [GTree]) : Maybe Macro =
  let read = V.map (ruleOf c) rules in
  if V.all M.isSome read
  then
    Just
      (Macro
        { rules = V.concatMap (\x -> match x with | Just y -> [y] | None -> []) read, pkg = pkg
        })
  else None

-- A rule: its matcher, read, and its template.
fun ruleOf (c : Lc) (r : GTree) =
  match r with
  | GroupedMacroRule mt tp ->
      (match Ru.readMatcher (Ru.treeOf (tokenOf c) mt) with
       | Ok m -> Just (m, Ru.treeOf (tokenOf c) tp)
       | Err _ -> None)
  | _ -> None

-- The module's `macro` a call is of, if it is of one. A call a template
-- wrote is named without the mark it was written with.
fun rulesOf (c : Lc) (call : GTree) : Maybe Macro =
  let pathNode =
    M.unwrapOr
      call
      (V.find (\x -> R.kindOf x == NodeMacPath or R.kindOf x == NodeArgPath) (nodeKids call))
  in
  let segs =
    V.filter (\x -> R.kindOf x == NodeAnySeg or R.kindOf x == NodeArgSeg) (nodeKids pathNode)
  in
  if V.len segs == 1
  then M.andThen (\x -> H.lookup (Hy.stripOnce (firstName x).text) c.macros) (V.get segs 0)
  else None

-- What a call of `macro` `m` wrote, if a rule matches it.
fun expandCall (c : Lc) (m : Macro) (call : GTree) =
  let n = nextExpansion () in
  match V.find isGroup (nodeKids call) with
  | Just g ->
      (match Ru.expand m (Ru.treeOf (tokenOf c) g) n with
       | Ok toks -> Just toks
       | Err _ -> None)
  | None -> None

-- `toks`, after `before` and before `after` -- tokens that stand nowhere --
-- parsed and grouped by the unit's fixities: the tree, and the context to
-- lower it in, its tokens by where each is in the tree's text.
fun reparsed (c : Lc) (before : [(Token, String)]) (toks : [Tok])
    (after : [(Token, String)]) : (Lc, GTree) =
  let made = \p -> (fst p, 0 - 1, 0 - 1, snd p) in
  let given =
    V.concat
      [
        V.map made before,
        V.map (\(t : Tok) -> (t.token, t.from, t.to, t.text)) toks,
        V.map made after
      ]
  in
  let starts =
    V.foldl
      (\acc x -> match x with
                 | (_, _, _, text) ->
                     V.pushBack
                     acc
                     (M.unwrapOr 0 (M.map (\l -> l + 1) (V.last acc)) + stringByteLength text))
      []
      given
  in
  let at = \i -> if i == 0 then 0 else V.getOr 0 starts (i - 1) + 1 in
  let tokens =
    H.fromVec
      (V.map
        (\i ->
          (
            at i,
            match V.getOr (Token.Wildcard, 0, 0, "") given i with
            | (t, _, _, _) -> t
          ))
        (V.range 0 (V.len given)))
  in
  match parseSurfaceTokens given with
  | (g, _) ->
      (match grouped c.fx (R.root g) with
       | (gg, _) -> ({ c | tokens = tokens }, R.root gg))

fun expandedDecls (c : Lc) b (m : Macro) (call : GTree) =
  M.map
    (\toks ->
      match reparsed c [] toks [] with
      | (inner, root) ->
          let ds = V.concatMap (decl inner b) (childrenOf NodeDecl root) in
          let u = Hy.stripItems b ds in
          ds)
    (expandCall c m call)

fun expandedExpr (c : Lc) b (m : Macro) (call : GTree) =
  M.andThen
    (\toks ->
      match reparsed c [ (Token.Def, "def"), (Token.LowerIdent "x", "x"), (Token.Eq, "=")
      ] toks [] with
      | (inner, root) ->
          M.map
            (\body -> let e = expr inner b (must NodeExpr body) in let u = Hy.stripInExpr b e in e)
            (M.andThen (childOf NodeBody) (M.andThen firstNode (M.andThen (childOf NodeItem) (childOf NodeDecl root)))))
    (expandCall c m call)

fun expandedPat (c : Lc) b (m : Macro) (call : GTree) =
  M.andThen
    (\toks ->
      match reparsed c [
        (Token.Def, "def"),
        (Token.LowerIdent "x", "x"),
        (Token.Eq, "="),
        (Token.Match, "match"),
        (Token.LParen, "("),
        (Token.RParen, ")"),
        (Token.With, "with"),
        (Token.Bar, "|")
      ] toks [
        (Token.RArrow, "->"),
        (Token.LParen, "("),
        (Token.RParen, ")")
      ] with
      | (inner, root) ->
          M.map
            (\arm -> let p = pat inner b (must NodePat arm) in let u = Hy.stripInPat b p in p)
            (firstOfKind NodeArm root))
    (expandCall c m call)

-- The first node of kind `k` in `s`, reading down and left to right.
fun firstOfKind (k : Grouped) (s : GTree) : Maybe GTree =
  if R.kindOf s == k then Just s
  else
    V.foldl
      (\found x -> match found with
                   | Just f -> Just f
                   | None -> firstOfKind k x)
      None
      (nodeKids s)

fun jarr (j : Json) : [Json] = M.unwrapOr [] (J.asArray j)

fun jat (j : Json) (i : Int) : Json = V.getOr (J.jNull ()) (jarr j) i

fun jint (j : Json) (i : Int) : Int = M.unwrapOr 0 (J.asInt (jat j i))

fun jstr (j : Json) (i : Int) : String = M.unwrapOr "" (J.asString (jat j i))

fun jbool (j : Json) (i : Int) : Bool = M.unwrapOr False (J.asBool (jat j i))

fun jtag (j : Json) : String = jstr j 0

fun jmeta (j : Json) : Meta = spanMeta (jint j 1) (jint j 2)

-- Field `i` of node `j`, by its place among the fields.
fun jf (j : Json) (i : Int) : Json = jat j (i + 3)

fun jn b (j : Json) = newAstName b (jmeta j) (jstr j 3)

fun jns b (j : Json) = V.map (jn b) (jarr j)

fun jopt (f : Json -> a ! e) (j : Json) : Maybe a ! e = if J.isNull j then None else Just (f j)

fun jDecl (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  if t == "Bind" then newAstDeclBind b m (jBind c b (f 0))
  else if t == "ModDecl" then newAstDeclMod b m (jn b (f 0))
  else if t == "UseDecl"
  then
    newAstDeclUse
      b
      m
      (jns b (f 0))
      (jns b (f 1))
      (jns b (f 2))
      (M.unwrapOr False (J.asBool (f 3)))
      (jopt (jn b) (f 4))
  else if t == "DataDecl"
  then newAstDeclData b m (jn b (f 0)) (jns b (f 1)) (V.map (jVariant c b) (jarr (f 2)))
  else if t == "RecordDecl"
  then newAstDeclRecord b m (jn b (f 0)) (jns b (f 1)) (V.map (jField c b) (jarr (f 2)))
  else if t == "EffectDecl"
  then newAstDeclEffect b m (jn b (f 0)) (jns b (f 1)) (V.map (jField c b) (jarr (f 2)))
  else if t == "AliasDecl"
  then newAstDeclAlias b m (jn b (f 0)) (jns b (f 1)) (jType c b (f 2))
  else if t == "EffectAliasDecl"
  then newAstDeclEffectAlias b m (jn b (f 0)) (jns b (f 1)) (jRow c b (f 2))
  else if t == "SigDecl"
  then newAstDeclSig b m (jn b (f 0)) (jType c b (f 1)) (V.map (jBound c b) (jarr (f 2)))
  else if t == "TraitDecl" then
    newAstDeclTrait
      b
      m
      (jn b (f 0))
      (jns b (f 1))
      (V.map (jBound c b) (jarr (f 2)))
      (V.map (\x -> newAstAssoc b (jmeta x) (jn b (jf x 0)) (jns b (jf x 1))) (jarr (f 3)))
      (V.map (\x -> newAstMethodSig b (jmeta x) (jn b (jf x 0)) (jType c b (jf x 1))) (jarr (f 4)))
      (V.map (jBind c b) (jarr (f 5)))
  else if t == "ImplDecl" then
    newAstDeclImpl
      b
      m
      (jn b (f 0))
      (V.map (jType c b) (jarr (f 1)))
      (V.map (jBound c b) (jarr (f 2)))
      (V.map
        (\x ->
          newAstAssocDef
            b
            (jmeta x)
            (jn b (jf x 0))
            (V.map (jType c b) (jarr (jf x 1)))
            (jType c b (jf x 2)))
        (jarr (f 3)))
      (V.map (jBind c b) (jarr (f 4)))
  else if t == "FixityDecl" then newAstDeclFixity b m (jns b (f 0))
  else if t == "Attributed"
  then newAstDeclAttributed b m (V.map (jAttr b) (jarr (f 0))) (jDecl c b (f 1))
  else if t == "MacCallDecl" then newAstDeclMacCall b m (jMac b (f 0))
  else newAstDeclMacro b m (jn b (f 0))

fun jAttr b (j : Json) =
  newAstAttr b (jmeta j) (jn b (jf j 0)) (jns b (jf j 1)) (V.map (jMeta b) (jarr (jf j 2)))

fun jMeta b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  if t == "MetaWord" then newAstAttrMetaWord b m (jn b (jf j 0))
  else if t == "MetaText" then newAstAttrMetaText b m (jn b (jf j 0))
  else if t == "MetaValue"
  then newAstAttrMetaValue b m (jn b (jf j 0)) (jn b (jf j 1))
  else newAstAttrMetaList b m (jn b (jf j 0)) (V.map (jMeta b) (jarr (jf j 1)))

fun jMac b (j : Json) = newAstMacCall b (jmeta j) (jns b (jf j 0))

fun jVariant (c : Lc) b (j : Json) =
  newAstVariant
    b
    (jmeta j)
    (V.map (jAttr b) (jarr (jf j 0)))
    (jn b (jf j 1))
    (M.unwrapOr False (J.asBool (jf j 2)))
    (V.map (jType c b) (jarr (jf j 3)))
    (V.map (jField c b) (jarr (jf j 4)))

fun jField (c : Lc) b (j : Json) =
  newAstField b (jmeta j) (V.map (jAttr b) (jarr (jf j 0))) (jn b (jf j 1)) (jType c b (jf j 2))

fun jBound (c : Lc) b (j : Json) =
  newAstBound b (jmeta j) (jn b (jf j 0)) (V.map (jType c b) (jarr (jf j 1)))

fun jType (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let ts = \x -> V.map (jType c b) (jarr x) in
  if t == "TVar" then newAstTypeVar b m (jn b (f 0))
  else if t == "TCon" then newAstTypeCon b m (jn b (f 0)) (ts (f 1))
  else if t == "TFun"
  then newAstTypeFun b m (ts (f 0)) (jType c b (f 1)) (jopt (jRow c b) (f 2))
  else if t == "TTuple" then newAstTypeTuple b m (ts (f 0))
  else if t == "TVector" then newAstTypeVector b m (jType c b (f 0))
  else if t == "TList" then newAstTypeList b m (jType c b (f 0))
  else
    newAstTypeRecord
      b
      m
      (V.map (\x -> newAstTypeField b (jmeta x) (jn b (jf x 0)) (jType c b (jf x 1))) (jarr (f 0)))
      (jopt (jn b) (f 1))

fun jRow (c : Lc) b (j : Json) =
  newAstRow
    b
    (jmeta j)
    (V.map
      (\x -> newAstLabel b (jmeta x) (jn b (jf x 0)) (V.map (jType c b) (jarr (jf x 1))))
      (jarr (jf j 0)))
    (jopt (jn b) (jf j 1))

fun jBind (c : Lc) b (j : Json) =
  let m = jmeta j in
  if jtag j == "PatBind"
  then newAstBindPat b m (jPat c b (jf j 0)) (jExpr c b (jf j 1))
  else
    newAstBindFun
      b
      m
      (jn b (jf j 0))
      (V.map (jPat c b) (jarr (jf j 1)))
      (jopt (jType c b) (jf j 2))
      (jExpr c b (jf j 3))

fun jLit b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let text = jstr j 3 in
  if t == "LitInt" then newAstLitInt b m text
  else if t == "LitFloat" then newAstLitFloat b m text
  else if t == "LitChar" then newAstLitChar b m text
  else newAstLitString b m text

fun jPat (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let ps = \x -> V.map (jPat c b) (jarr x) in
  if t == "PWild" then newAstPatWild b m
  else if t == "PVar" then newAstPatVar b m (jn b (f 0))
  else if t == "PAnn" then newAstPatAnn b m (jPat c b (f 0)) (jType c b (f 1))
  else if t == "PLit" then newAstPatLit b m (jLit b (f 0))
  else if t == "PAs" then newAstPatAs b m (jn b (f 0)) (jPat c b (f 1))
  else if t == "PCons" then newAstPatCons b m (jn b (f 0)) (ps (f 1))
  else if t == "PQualCons"
  then newAstPatQualCons b m (jn b (f 0)) (jn b (f 1)) (ps (f 2))
  else if t == "PTuple" then newAstPatTuple b m (ps (f 0))
  else if t == "PArray" then newAstPatArray b m (ps (f 0))
  else if t == "PVector" then newAstPatVector b m (ps (f 0))
  else if t == "PList" then newAstPatList b m (ps (f 0))
  else if t == "PRecord"
  then
    newAstPatRecord
      b
      m
      (V.map (\x -> newAstPatField b (jmeta x) (jn b (jf x 0)) (jPat c b (jf x 1))) (jarr (f 0)))
      (M.unwrapOr False (J.asBool (f 1)))
  else if t == "PUnit" then newAstPatUnit b m
  else if t == "PView" then newAstPatView b m (jExpr c b (f 0)) (jPat c b (f 1))
  else newAstPatMacCall b m (jMac b (f 0))

fun jExpr (c : Lc) b (j : Json) =
  let m = jmeta j in
  let t = jtag j in
  let f = jf j in
  let es = \x -> V.map (jExpr c b) (jarr x) in
  let fieldsOf =
    \x -> V.map (\y -> newAstExprField b (jmeta y) (jn b (jf y 0)) (jExpr c b (jf y 1))) (jarr x)
  in
  if t == "Var" then newAstExprVar b m (jn b (f 0))
  else if t == "LitE" then newAstExprLit b m (jLit b (f 0))
  else if t == "Interp"
  then
    newAstExprInterp
      b
      m
      (V.map (\x -> M.unwrapOr "" (J.asString x)) (jarr (f 0)))
      (V.map
        (\h -> newAstHole b (jmeta h) (jExpr c b (jf h 0)) (M.unwrapOr False (J.asBool (jf h 1))))
        (jarr (f 1)))
  else if t == "Lam"
  then newAstExprLam b m (V.map (jPat c b) (jarr (f 0))) (jExpr c b (f 1))
  else if t == "App" then newAstExprApp b m (jExpr c b (f 0)) (es (f 1))
  else if t == "Let"
  then newAstExprLet b m (V.map (jBind c b) (jarr (f 0))) (jExpr c b (f 1))
  else if t == "If"
  then newAstExprIf b m (jExpr c b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
  else if t == "Match"
  then
    newAstExprMatch
      b
      m
      (jExpr c b (f 0))
      (V.map
        (\a ->
          newAstArm
            b
            (jmeta a)
            (jPat c b (jf a 0))
            (jopt (jExpr c b) (jf a 1))
            (jExpr c b (jf a 2)))
        (jarr (f 1)))
  else if t == "Neg" then newAstExprNeg b m (jn b (f 0)) (jExpr c b (f 1))
  else if t == "AndE"
  then newAstExprAnd b m (jn b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
  else if t == "OrE"
  then newAstExprOr b m (jn b (f 0)) (jExpr c b (f 1)) (jExpr c b (f 2))
  else if t == "Chain"
  then chainOf c b (jExpr c b (f 0)) (V.zip (jarr (f 1)) (es (f 2)))
  else if t == "Tuple" then newAstExprTuple b m (es (f 0))
  else if t == "ArrayE" then newAstExprArray b m (es (f 0))
  else if t == "ListE" then newAstExprList b m (es (f 0))
  else if t == "Cons" then newAstExprCons b m (jn b (f 0)) (es (f 1))
  else if t == "Qual" then newAstExprQual b m (jn b (f 0)) (jn b (f 1))
  else if t == "RecordE"
  then newAstExprRecord b m (fieldsOf (f 0)) (jopt (jExpr c b) (f 1))
  else if t == "Update"
  then newAstExprUpdate b m (jExpr c b (f 0)) (fieldsOf (f 1))
  else if t == "Proj" then newAstExprProj b m (jExpr c b (f 0)) (jn b (f 1))
  else if t == "Handle" then
    newAstExprHandle b m (jExpr c b (f 0))
      (V.map
        (\a ->
          newAstHArm
            b
            (jmeta a)
            (jn b (jf a 0))
            (jPat c b (jf a 1))
            (jn b (jf a 2))
            (jExpr c b (jf a 3)))
        (jarr (f 1)))
      (jopt (\r -> newAstRet b (jmeta r) (jPat c b (jf r 0)) (jExpr c b (jf r 1))) (f 2))
  else if t == "UnitE" then newAstExprUnit b m
  else if t == "HoleE" then newAstExprHole b m
  else newAstExprMacCall b m (jMac b (f 0))

-- A chain of operators grouped by the unit's fixities, as `meadow-rename`
-- groups one: each operator applied to its two operands, spanning them.
fun chainOf (c : Lc) b (first : Int) (steps : [(Json, Int)]) =
  let done =
    V.foldl
      (\st step ->
        match (st, step) with
        | ((outs, ops), (op, x)) ->
            let name = jstr op 3 in
            let here = fixityOf c.fx name in
            let reduced = reduceOps c b outs ops here in
            (V.pushBack (fst reduced) x, V.pushBack (snd reduced) (op, here)))
      ([first], [])
      steps in
    let outs = V.foldr (\o acc -> applyOp b acc o) (fst done) (snd done) in
    V.getOr first outs (V.len outs - 1)

-- Apply every operator on the stack that goes before one that binds as `here`.
fun reduceOps (c : Lc) b (outs : [Int]) ops (here : Fixity) =
  match V.get ops (V.len ops - 1) with
  | None -> (outs, ops)
  | Just (top, there) ->
      if goesBefore there here
      then reduceOps c b (applyOp b outs (top, there)) (V.take ops (V.len ops - 1)) here
      else (outs, ops)

-- Whether an operator binding as `there`, on the stack, is applied before one
-- binding as `here` is pushed: it binds tighter, or as tightly and they do
-- not both group right. Two that group neither way are an error the fixity
-- pass reports; they are read as if the first went first.
fun goesBefore (there : Fixity) (here : Fixity) : Bool =
  if there.level > here.level then True
  else if there.level < here.level then False
  else not (there.assoc == Right and here.assoc == Right)

-- The top two operands, operator `o` applied to them: `(+) l r`, or `Cons l r`.
fun applyOp b (outs : [Int]) o =
  match (o, V.get outs (V.len outs - 2), V.get outs (V.len outs - 1)) with
  | ((op, _), Just l, Just r) ->
      let lm = metaAstExprIn b l in
      let rm = metaAstExprIn b r in
      let m = spanMeta (min (metaStart lm) (metaStart rm)) (max (metaEnd lm) (metaEnd rm))
      in
      let rest = V.take outs (V.len outs - 2) in
      if jstr op 3 == "::"
      then V.pushBack rest (newAstExprCons b m (newAstName b (jmeta op) "Cons") [l, r])
      else V.pushBack rest (newAstExprApp b m (newAstExprVar b (jmeta op) (jn b op)) [l, r])
  | _ -> outs
