-- Self-updating thunks
@pub data Thunk a = 
  | Thunk (() -> a)
  | Value a

@pub data Stream a where
  (::) : a -> Thunk (Stream a) -> Stream a
end

@pub trait Mappable m where
  fun map : a -> b -> m a -> m b
  fun (<$>) : a -> b -> m a -> m b = map
  fun (<$>) = map
end

@pub data List a = Nil | a :: List a

infixr 5 (::)

impl Mappable (List a) where
  fun map f xs =
    match xs with
    | Nil -> Nil
    | x :: xs -> f x :: map f xs
end

@pub fun gcd a b =
  if b == 0 then a else gcd b (a % b)

@pub fun lcm a b = 
  (a * b) / gcd a b

@pub fun fib(n) =
  let rec loop(a, b, n) =
    if n == 0 then a else loop(b, a + b, n - 1)
  in loop(0, 1, n)

@pub fib(n) = loop(0, 1, n) 
  where
    loop(a, b, n) = if n == 0 then a else loop(b, a + b, n - 1)

-- RRB Vectors
@pub data Vec(a)
  = Empty
  | Root {
      size : Int,
      shift : Int,
      tree : Node(a),
    }

@pub data Node a
  = Leaf (Vector a)
  | Internal {
      sizes : Maybe (Vector Int),
      children : Vector (Node a),
    }

fun mapNode f n =
  match n with
  | Leaf vec -> Leaf (map f vec)
  | Internal { sizes, children } ->
    Internal { sizes, children = map (mapNode f) children }

def branchingFactor = 32

impl Mappable (Vec a) where
  fun map f v =
    match v with
    | Empty -> Empty
    | Root { size, shift, tree } -> Root { size, shift, tree = mapNode f tree }
end

