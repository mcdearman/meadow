-- Hygiene: the marks a template's names carry, taken off every name that is
-- not a local variable -- `meadow_compiler::expand::hygiene`, slot for slot.
--
-- A `macro`'s template writes each lowercase name marked with its expansion,
-- `tmp#3` (`Rules`), before anything is parsed: a name no source can spell, so
-- a local the template binds is never the caller's, and a name it only
-- mentions is looked up again without the mark when nothing marked binds it.
-- What must not keep a mark is every name matched by name against something
-- outside the expansion -- a record's label, a module's member, a type, a
-- declaration's name -- and a label and a variable are the same token, told
-- apart only by where the parser put them. So the marks come off here, on
-- the nodes lowering wrote, as they come off the Rust expander's tree. What
-- keeps one: a name in an expression, a variable a pattern binds -- but a
-- top-level one, which is an item -- a local function's name, and a
-- handler's resumption.

use MeadowBoot.Ast
use Std.Collections.Vector as V
use Std.Maybe.Maybe.*

-- What one expansion made, in declarations' place: each declaration's
-- name and every name in it that is not a local.
@pub fun stripItems b (decls : [Int]) = each (decl b) decls

-- The same, for an expansion in an expression's place, or a pattern's.
@pub fun stripInExpr b (e : Int) = expr b e

@pub fun stripInPat b (p : Int) = pat b p

-- `name` without its last mark: an expansion inside an expansion marks a
-- name twice, and one comes off at a time, the outermost first.
@pub fun stripOnce (name : String) : String =
  let i = lastMark name (stringByteLength name - 1) in
  if i < 0 then name else stringSlice name 0 i

fun lastMark (s : String) (i : Int) : Int =
  if i < 0 then 0 - 1 else if stringSlice s i (i + 1) == "#" then i else lastMark s (i - 1)

fun unmark b (n : Int) =
  let t = astNameText b n in
  let u = stripOnce t in
  if u == t then () else setAstNameText b n u

fun each (f : Int -> () ! e) (xs : [Int]) : () ! e = V.foldl (\u x -> f x) () xs

fun maybe (f : Int -> () ! e) (x : Maybe Int) : () ! e = match x with | Just v -> f v | None -> ()

-- --- declarations ------------------------------------------------------------

fun decl b (d : Int) =
  match viewAstDecl b d with
  -- A top-level binding is an item: its name is not hygienic, though its
  -- parameters and body are.
  | AstDeclView.Bind r -> (let u = itemBinder b r.bind in bind b r.bind)
  | AstDeclView.Sig r ->
      (let u = unmark b r.name in
       let v = ty b r.ty in
       each (bound b) r.bounds)
  | AstDeclView.Trait r ->
      let u = unmark b r.name in
      let v = each (unmark b) r.params in
      let w = each (bound b) r.supers in
      let x =
        each
          (\a -> (let y = unmark b (astAssocName b a) in each (unmark b) (astAssocParams b a)))
          r.assocs
      in
      let x2 =
        each
          (\a -> (let y = unmark b (astAssocName b a) in each (unmark b) (astAssocParams b a)))
          r.effects
      in
      let y =
        each (\s -> (let z = unmark b (astMethodSigName b s) in ty b (astMethodSigTy b s))) r.sigs
      in each (\x -> (let z = funName b x in bind b x)) r.defaults
  | AstDeclView.Impl r ->
      let u = unmark b r.tr in
      let v = each (ty b) r.tys in
      let w = each (bound b) r.context in
      let x =
        each
          (\a ->
            (let y = unmark b (astAssocDefName b a) in
             let z = each (ty b) (astAssocDefArgs b a) in
             ty b (astAssocDefTy b a)))
          r.assocs
      in
      let x2 =
        each
          (\a ->
            (let y = unmark b (astAssocEffDefName b a) in
             let z = each (ty b) (astAssocEffDefArgs b a) in
             row b (astAssocEffDefRow b a)))
          r.effects
      in each (\m -> (let z = itemBinder b m in bind b m)) r.methods
  | AstDeclView.Data r ->
      let u = unmark b r.name in
      let v = each (unmark b) r.params in
      each
        (\x ->
          if astVariantNamed b x then each (field b) (astVariantFields b x)
          else each (ty b) (astVariantPositional b x))
        r.variants
  | AstDeclView.Record r ->
      (let u = unmark b r.name in
       let v = each (unmark b) r.params in
       each (field b) r.fields)
  | AstDeclView.Effect r ->
      (let u = unmark b r.name in
       let v = each (unmark b) r.params in
       each (field b) r.ops)
  | AstDeclView.Alias r ->
      (let u = unmark b r.name in
       let v = each (unmark b) r.params in
       ty b r.ty)
  | AstDeclView.EffectAlias r ->
      let u = unmark b r.name in
      let v = each (unmark b) r.params in
      let x =
        each
          (\l -> (let y = unmark b (astLabelName b l) in each (ty b) (astLabelArgs b l)))
          (astRowLabels b r.row)
      in maybe (unmark b) (astRowTail b r.row)
  | AstDeclView.Use r ->
      let u = each (unmark b) r.path in
      let v = each (unmark b) r.names in
      let w = each (unmark b) r.macros in
      maybe (unmark b) r.alias
  | AstDeclView.Attributed r -> decl b r.decl
  | AstDeclView.Mod r -> unmark b r.name
  | AstDeclView.Fixity r -> each (unmark b) r.ops
  | _ -> ()

-- A binding that is an item: a function's name, or what a pattern binds.
fun itemBinder b (x : Int) =
  match viewAstBind b x with
  | AstBindView.Fun r -> unmark b r.name
  | AstBindView.Pat r -> itemPat b r.pat

-- A trait's default: a function's name is the trait's.
fun funName b (x : Int) =
  match viewAstBind b x with
  | AstBindView.Fun r -> unmark b r.name
  | AstBindView.Pat _ -> ()

-- The names a top-level pattern binds, which are items.
fun itemPat b (p : Int) =
  match viewAstPat b p with
  | AstPatView.Var r -> unmark b r.name
  | AstPatView.Ann r -> (let u = itemPat b r.pat in ty b r.ty)
  | AstPatView.Tuple r -> each (itemPat b) r.items
  | AstPatView.Array r -> each (itemPat b) r.items
  | AstPatView.Vector r -> each (itemPat b) r.items
  | AstPatView.List r -> each (itemPat b) r.items
  | AstPatView.As r -> (let u = unmark b r.name in itemPat b r.pat)
  | AstPatView.View r -> (let u = expr b r.fn in itemPat b r.pat)
  | _ -> pat b p

fun field b (f : Int) = (let u = unmark b (astFieldName b f) in ty b (astFieldTy b f))

fun bound b (x : Int) = (let u = unmark b (astBoundTr b x) in each (ty b) (astBoundTys b x))

-- Every name in a type is a type's -- a variable, a constructor, a label --
-- so none keeps a mark.
fun ty b (t : Int) =
  match viewAstType b t with
  | AstTypeView.Var r -> unmark b r.name
  | AstTypeView.Con r -> (let u = unmark b r.name in each (ty b) r.args)
  | AstTypeView.Fun r ->
      let u = each (ty b) r.params in
      let v = ty b r.result in
      maybe (row b) r.row
  | AstTypeView.Tuple r -> each (ty b) r.items
  | AstTypeView.Vector r -> ty b r.item
  | AstTypeView.List r -> ty b r.item
  | AstTypeView.Row r -> row b r.row
  | AstTypeView.Record r ->
      (let u =
         each
           (\f -> (let v = unmark b (astTypeFieldName b f) in ty b (astTypeFieldTy b f)))
           r.fields
       in maybe (unmark b) r.tail)

-- An effect row: its labels, what each is given, and its tail.
fun row b (w : Int) =
  let x =
    each
      (\l -> (let y = unmark b (astLabelName b l) in each (ty b) (astLabelArgs b l)))
      (astRowLabels b w)
  in maybe (unmark b) (astRowTail b w)

-- --- terms -------------------------------------------------------------------

fun bind b (x : Int) =
  match viewAstBind b x with
  | AstBindView.Pat r -> (let u = pat b r.pat in expr b r.value)
  | AstBindView.Fun r ->
      (let u = each (pat b) r.params in
       let v = maybe (ty b) r.ret in
       expr b r.body)

fun pat b (p : Int) =
  match viewAstPat b p with
  -- A record pattern's labels name the record's fields; only what each binds
  -- is a variable.
  | AstPatView.Record r ->
      each (\f -> (let u = unmark b (astPatFieldName b f) in pat b (astPatFieldPat b f))) r.fields
  | AstPatView.Ann r -> (let u = pat b r.pat in ty b r.ty)
  | AstPatView.As r -> pat b r.pat
  | AstPatView.View r -> (let u = expr b r.fn in pat b r.pat)
  | AstPatView.Cons r -> each (pat b) r.args
  | AstPatView.QualCons r -> each (pat b) r.args
  | AstPatView.Tuple r -> each (pat b) r.items
  | AstPatView.Array r -> each (pat b) r.items
  | AstPatView.Vector r -> each (pat b) r.items
  | AstPatView.List r -> each (pat b) r.items
  | _ -> ()

fun fieldE b (f : Int) = (let u = unmark b (astExprFieldName b f) in expr b (astExprFieldValue b f))

fun expr b (e : Int) =
  match viewAstExpr b e with
  -- `Mod.name`: the name is the module's.
  | AstExprView.Qual r -> unmark b r.name
  -- `e.label`: the label is the record's.
  | AstExprView.Proj r -> (let u = expr b r.target in unmark b r.label)
  | AstExprView.Record r -> (let u = each (fieldE b) r.fields in maybe (expr b) r.base)
  | AstExprView.Update r -> (let u = expr b r.base in each (fieldE b) r.fields)
  | AstExprView.Handle r ->
      let u = expr b r.body in
      -- The operation is the effect's, but what an arm binds is local.
      let v =
        each
          (\a ->
            (let w = unmark b (astHArmOp b a) in
             let x = pat b (astHArmParam b a) in
             expr b (astHArmBody b a)))
          r.arms
      in maybe (\x -> (let y = pat b (astRetPat b x) in expr b (astRetBody b x))) r.ret
  | AstExprView.Lam r -> (let u = each (pat b) r.params in expr b r.body)
  | AstExprView.App r -> (let u = expr b r.func in each (expr b) r.args)
  | AstExprView.Let r -> (let u = each (bind b) r.binds in expr b r.body)
  | AstExprView.If r ->
      (let u = expr b r.cond in
       let v = expr b r.yes in
       expr b r.no)
  | AstExprView.Match r ->
      let u = expr b r.scrutinee in
      each
        (\a ->
          (let v = pat b (astArmPat b a) in
           let w = maybe (expr b) (astArmGuard b a) in
           expr b (astArmBody b a)))
        r.arms
  | AstExprView.Neg r -> expr b r.operand
  | AstExprView.And r -> (let u = expr b r.lhs in expr b r.rhs)
  | AstExprView.Or r -> (let u = expr b r.lhs in expr b r.rhs)
  | AstExprView.Interp r -> each (\h -> expr b (astHoleExpr b h)) r.holes
  | AstExprView.Tuple r -> each (expr b) r.items
  | AstExprView.Array r -> each (expr b) r.items
  | AstExprView.List r -> each (expr b) r.items
  | AstExprView.Cons r -> each (expr b) r.args
  -- A bare name is a variable, and keeps its mark: whether it is a local or
  -- an item is the resolver's to decide, by looking.
  | _ -> ()
